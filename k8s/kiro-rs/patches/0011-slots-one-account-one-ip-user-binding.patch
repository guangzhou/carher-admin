+              >
+                {t.label}
+              </button>
+            ))}
+          </div>
+          <CardContent className='pt-4'>
+            {tab === 'slots' && <SlotConfigEditor />}
+            {tab === 'gray' && <SlotGrayEditor />}
+            {tab === 'limits' && <LimitsForm />}
+          </CardContent>
+        </Card>
