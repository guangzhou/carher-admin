 /// 模型映射：将 Anthropic 模型名映射到 Kiro 模型 ID
 /// 严格对照版本号
+/// Kiro 上游的非 Claude 模型。这些 id 与上游 `ListAvailableModels` 返回的
+/// `modelId` 一字不差，无需翻译，直接透传即可。
+///
+/// 元组为 `(上游 modelId, 上下文窗口)`，窗口取自该账号 `ListAvailableModels`
+/// 的 `tokenLimits.maxInputTokens`，与 `get_context_window_size` 共用，
+/// 避免 usage 百分比按错误的窗口还原成 token 数。
+const PASSTHROUGH_MODELS: &[(&str, i32)] = &[
+    ("auto", 1_000_000),
+    ("gpt-5.6-sol", 272_000),
+    ("gpt-5.6-terra", 272_000),
+    ("gpt-5.6-luna", 272_000),
+    ("deepseek-3.2", 164_000),
+    ("minimax-m2.5", 196_000),
+    ("minimax-m2.1", 196_000),
+    ("glm-5", 200_000),
+    ("qwen3-coder-next", 256_000),
+];
+
+/// 可选的 `kiro-` / `kiro/` 别名前缀。
+///
+/// 为什么需要它：LiteLLM 的 `completion()` 派发在 `main.py:2656` 先判
+/// `model in litellm.open_ai_chat_completion_models`，**再**判 provider。
+/// `gpt-5.6-sol` / `-terra` / `-luna` 恰好是 LiteLLM 内置的 OpenAI 模型名，
+/// 于是即便显式写了 `anthropic/` 前缀 + `custom_llm_provider: anthropic`，
+/// 也会被劈到 OpenAI 分支 POST `/chat/completions`（本服务没有这个路由 ⇒ 404）。
+/// 那张表不能改——真正的 zerokey / chatgpt 池子用的就是这些同名模型走 OpenAI 路。
+/// 所以在**本侧**留一个逃生舱：调用方可以写 `kiro-gpt-5.6-sol`，这个名字不在
+/// LiteLLM 的 OpenAI 表里，于是走 Anthropic 路 POST `/v1/messages`，
+/// 到了这里再把前缀剥掉，上游拿到的仍是一字不差的 `gpt-5.6-sol`。
+///
+/// 前缀对 Claude 分支同样生效，纯属对称，避免将来再撞名时还要改代码。
+fn strip_kiro_alias_prefix(model_lower: &str) -> &str {
+    model_lower
+        .strip_prefix("kiro-")
+        .or_else(|| model_lower.strip_prefix("kiro/"))
+        .unwrap_or(model_lower)
+}
+
+/// 在透传表里查模型，容忍 `-thinking` 后缀（与 Claude 分支的行为一致）
+fn passthrough_model(model_lower: &str) -> Option<&'static (&'static str, i32)> {
+    let base = strip_kiro_alias_prefix(model_lower);
+    let base = base.strip_suffix("-thinking").unwrap_or(base);
+    PASSTHROUGH_MODELS.iter().find(|(id, _)| *id == base)
+}
+
