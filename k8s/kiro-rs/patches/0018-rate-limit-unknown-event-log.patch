+        assert!(!second.contains("上游事件类型未知"), "第二次不该再打: {second}");
+        for _ in 2..UNKNOWN_EVENT_LOG_EVERY - 1 {
+            let _ = Event::from_frame_logged(mk(), "stream", "m");
+        }
+        let (_, nth) = capture(|| Event::from_frame_logged(mk(), "stream", "m"));
+        assert!(nth.contains(&format!("seen_total={}", UNKNOWN_EVENT_LOG_EVERY)), "{nth}");
