+#[derive(serde::Deserialize)]
+pub struct UsageQuery {
+    /// 1 = 今天（北京时间）；7 = 最近 7 天（含今天）。只接受 1..=7
+    #[serde(default = "default_usage_days")]
+    pub days: i64,
+}
+
+fn default_usage_days() -> i64 {
+    1
+}
+
+/// GET /api/admin/credentials/{id}/usage?days=1|7 —— 这个 kiro 账户按模型的请求数 / token
+pub async fn get_credential_usage(
+    State(state): State<AdminState>,
+    axum::extract::Path(id): axum::extract::Path<u64>,
+    axum::extract::Query(q): axum::extract::Query<UsageQuery>,
+) -> impl IntoResponse {
+    let days = q.days.clamp(1, 7);
+    let rows: Vec<_> = state
+        .service
+        .token_manager()
+        .account_usage_for(id, days)
+        .into_iter()
+        .map(|(m, c)| serde_json::json!({"model": m, "requests": c.requests, "success": c.success, "failed": c.failed,
+            "inputTokens": c.input_tokens, "outputTokens": c.output_tokens}))
+        .collect();
+    let (since, baseline) = state.service.token_manager().usage_baseline(id);
+    Json(serde_json::json!({"id": id, "days": days, "models": rows, "since": since, "baselineSuccess": baseline})).into_response()
+}
+
+/// GET /api/admin/credentials/usage-totals?days=1|7 —— 每个账户的合计（列表页用）
+pub async fn get_credentials_usage_totals(
+    State(state): State<AdminState>,
+    axum::extract::Query(q): axum::extract::Query<UsageQuery>,
+) -> impl IntoResponse {
+    let days = q.days.clamp(1, 7);
+    let t: serde_json::Map<String, serde_json::Value> = state
+        .service
+        .token_manager()
+        .account_usage_totals(days)
+        .into_iter()
+        .map(|(id, c)| (id.to_string(), serde_json::json!({"requests": c.requests, "failed": c.failed,
+            "inputTokens": c.input_tokens, "outputTokens": c.output_tokens})))
+        .collect();
+    Json(serde_json::json!({"days": days, "totals": t})).into_response()
+}
