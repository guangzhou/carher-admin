+class _CappedSpendLogUpstream(_LogClient):
+    """Mimics LiteLLM >= 1.93 /spend/logs/v2 (PR #31825).
+
+    Rows are filtered by second-precision ``start_date <= startTime <= end_date``
+    (inclusive on both ends), ordered by startTime, and the count is bounded:
+    above ``cap`` rows it reports ``total=cap`` / ``total_is_capped=true`` while
+    OFFSET pages beyond still return real rows.
+    """
+
+    def __init__(self, rows: list[dict], cap: int) -> None:
+        super().__init__([])
+        self.rows = sorted(rows, key=lambda r: r["startTime"])
+        self.cap = cap
+        self.count_probes = 0
+
+    async def request_backend(self, backend, method, path, **kwargs):  # type: ignore[override]
+        from datetime import datetime as _dt
+        params = kwargs.get("params") or {}
+        if path == "/user/daily/activity/aggregated":
+            return {"results": [], "metadata": {"total_api_requests": self.rollup_requests}}
+        self.requests.append(params)
+        start = _dt.strptime(params["start_date"], "%Y-%m-%d %H:%M:%S")
+        end = _dt.strptime(params["end_date"], "%Y-%m-%d %H:%M:%S")
+
+        def ts(row):
+            return _dt.fromisoformat(row["startTime"].replace("+00:00", "")).replace(microsecond=0)
+
+        matched = [r for r in self.rows if start <= ts(r) <= end]
+        size = int(params.get("page_size") or 100)
+        page = int(params.get("page") or 1)
+        if size == 1:
+            self.count_probes += 1
+        capped = len(matched) > self.cap
+        total = self.cap if capped else len(matched)
+        return {
+            "data": matched[(page - 1) * size: page * size],
+            "total": total,
+            "total_pages": -(-total // size) if total else 0,
+            "total_is_capped": capped,
+            "page": page,
+        }
+
+
+def _full_page(page: int, size: int) -> list[dict]:
+    return [
+        {**_log("claude-code-alice", f"2026-07-28T02:{page % 60:02d}:{i % 60:02d}+00:00", 1, "0.01"), "request_id": f"p{page}-{i}"}
+        for i in range(size)
+    ]
+
+
+def _spread_rows(count: int, start_hour: int = 1, seconds: int = 3600, user: str = "claude-code-alice") -> list[dict]:
+    """``count`` rows spread across ``seconds`` with sub-second times, so many
+    rows share a second exactly like production traffic."""
+    rows = []
+    for i in range(count):
+        offset = (i * seconds) / count
+        whole, frac = int(offset), int((offset - int(offset)) * 1000)
+        hh, rem = divmod(whole, 3600)
+        mm, ss = divmod(rem, 60)
+        rows.append({
+            **_log(user, f"2026-07-28T{start_hour + hh:02d}:{mm:02d}:{ss:02d}.{frac:03d}+00:00", 1, "0.01"),
+            "request_id": f"r{i}",
+        })
+    return rows
+
+
+def _scan(client) -> tuple[dict, bool]:
+    return asyncio.run(client.sync_rows_from_logs("2026-07-28", "2026-07-28", PRIMARY))
+
+
+def _requests(rows: dict) -> int:
+    return sum(int(r["requestCount"]) for bucket in rows.values() for r in bucket)
+
+
+def _spend(rows: dict) -> float:
+    return round(sum(float(r["spend"]) for bucket in rows.values() for r in bucket), 6)
+
+
+def test_capped_count_splits_window_and_reads_every_row(monkeypatch) -> None:
+    """上游计数封顶时按时间二分到每个子窗口计数精确,读全部真实行。"""
+    monkeypatch.setenv("USAGE_TIMEZONE_OFFSET_MINUTES", "-480")
+    monkeypatch.setenv("USAGE_SYNC_LOG_PAGE_SIZE", "10")
+    monkeypatch.setenv("USAGE_SYNC_LOG_COUNT_CAP", "50")
+    client = _CappedSpendLogUpstream(_spread_rows(437), cap=50)
+
+    rows, complete = _scan(client)
+
+    assert complete is True
+    assert _requests(rows) == 437
+    assert _spend(rows) == round(437 * 0.01, 6)
+    assert client.count_probes > 1
+
+
+def test_capped_count_shared_boundary_second_is_not_lost(monkeypatch) -> None:
+    """很多行挤在同一秒、二分中点正好落在这一秒:两侧共享边界秒,去重后一行不丢也不重。"""
+    monkeypatch.setenv("USAGE_TIMEZONE_OFFSET_MINUTES", "-480")
+    monkeypatch.setenv("USAGE_SYNC_LOG_PAGE_SIZE", "10")
+    monkeypatch.setenv("USAGE_SYNC_LOG_COUNT_CAP", "40")
+    # 120 rows in an 8-second burst (15/s): every midpoint lands inside a
+    # populated second, and both leaves include that boundary second.
+    client = _CappedSpendLogUpstream(_spread_rows(120, seconds=8), cap=40)
+    monkeypatch.setenv("USAGE_SYNC_LOG_MIN_WINDOW_SECONDS", "1")
+
+    rows, complete = _scan(client)
+
+    assert complete is True
+    assert _requests(rows) == 120
+    assert _spend(rows) == round(120 * 0.01, 6)
+
+
