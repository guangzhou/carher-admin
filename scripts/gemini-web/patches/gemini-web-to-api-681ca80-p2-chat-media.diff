+// HandleMedia serves an image kept by chatImageURL. Unguessable 128-bit ids, 24h TTL.
+func (h *OpenAIController) HandleMedia(c fiber.Ctx) error {
+	id := c.Params("id")
+	if !validMediaID(id) {
+		return c.Status(fiber.StatusNotFound).JSON(fiber.Map{"error": "not found"})
+	}
+	it, ok := chatMedia.get(id)
+	if !ok {
+		return c.Status(fiber.StatusNotFound).JSON(fiber.Map{"error": "expired or unknown"})
+	}
+	c.Set(fiber.HeaderContentType, it.mime)
+	c.Set(fiber.HeaderCacheControl, "private, max-age=86400")
+	return c.Send(it.data)
