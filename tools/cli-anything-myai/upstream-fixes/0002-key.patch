diff --git a/tests/test_key_rollup_coverage.py b/tests/test_key_rollup_coverage.py
new file mode 100644
index 0000000..807bdd3
--- /dev/null
+++ b/tests/test_key_rollup_coverage.py
@@ -0,0 +1,137 @@
+"""按 key 补齐按人统计看不到的用量(2026-10-14 线上缺 ~$58k/30d)。"""
+
+from __future__ import annotations
+
+import asyncio
+
+from backend.litellm_client import LiteLLMBackend, LiteLLMClient
+from backend.usage_sync import UsageSynchronizer
+
+
+PRIMARY = LiteLLMBackend(id="primary", label="通衢 API", base_url="http://x", admin_key="sk-admin")
+
+KNOWN_SHA = "a" * 64
+HANGZHOU_SHA = "b" * 64
+ORPHAN_SHA = "c" * 64
+DELETED_SHA = "d" * 64
+
+
+def _metrics(requests: int, spend: float) -> dict:
+    return {"metrics": {"api_requests": requests, "failed_requests": 0, "spend": spend,
+                        "prompt_tokens": requests * 10, "completion_tokens": requests, "total_tokens": requests * 11}}
+
+
+def _global_page() -> dict:
+    """Shape of LiteLLM 1.103 /user/daily/activity without user_id."""
+    return {
+        "results": [{
+            "date": "2026-10-12",
+            "breakdown": {
+                "api_keys": {
+                    KNOWN_SHA: {**_metrics(100, 10.0), "metadata": {"key_alias": "alice-key", "user_id": "alice", "key_exists": True}},
+                    HANGZHOU_SHA: {**_metrics(11955, 71.75), "metadata": {"key_alias": "carher-hangzhou", "user_id": None, "team_id": "team-hz", "key_exists": True}},
+                    ORPHAN_SHA: {**_metrics(1952, 4547.73), "metadata": {"key_alias": "claude-code-x-std", "user_id": "claude-code-x-std", "key_exists": True}},
+                    DELETED_SHA: {**_metrics(5, 0.5), "metadata": {"key_alias": None, "user_id": None, "key_exists": False}},
+                },
+                "models": {
+                    "gpt-5.6": {**_metrics(0, 0), "api_key_breakdown": {
+                        KNOWN_SHA: _metrics(100, 10.0),
+                        HANGZHOU_SHA: _metrics(11000, 60.0),
+                        DELETED_SHA: _metrics(5, 0.5),
+                    }},
+                    "claude-opus-5-5": {**_metrics(0, 0), "api_key_breakdown": {
+                        HANGZHOU_SHA: _metrics(955, 11.75),
+                        ORPHAN_SHA: _metrics(1952, 4547.73),
+                    }},
+                },
+            },
+        }],
+        "metadata": {"total_api_requests": 14012, "total_spend": 4629.98, "total_pages": 1, "page": 1},
+    }
+
+
+class _Client(LiteLLMClient):
+    def __init__(self) -> None:
+        self.backends = [PRIMARY]
+        self._deployment_model_maps = {}
+        self.calls: list[dict] = []
+
+    async def _ensure_deployment_model_map(self, _backend):
+        return {}
+
+    async def request_backend(self, backend, method, path, **kwargs):  # type: ignore[override]
+        self.calls.append({"path": path, **(kwargs.get("params") or {})})
+        assert path == "/user/daily/activity" and "user_id" not in (kwargs.get("params") or {})
+        return _global_page()
+
+
+def _gap(known: set[str]) -> list[dict]:
+    sync = UsageSynchronizer(_Client(), store=None)
+    return asyncio.run(sync._key_rollup_gap_rows(PRIMARY, "2026-10-12", "2026-10-12", known, {}))
+
+
+def test_rollup_rows_sum_to_upstream_per_key() -> None:
+    rows, totals = asyncio.run(_Client().key_rollup_rows("2026-10-12", "2026-10-12", PRIMARY))
+    by_key = {}
+    for r in rows:
+        by_key[r["keyId"]] = by_key.get(r["keyId"], 0) + r["requestCount"]
+    assert by_key == {KNOWN_SHA: 100, HANGZHOU_SHA: 11955, ORPHAN_SHA: 1952, DELETED_SHA: 5}
+    assert totals["requestCount"] == 14012 and totals["complete"] is True
+
+
+def test_keys_of_known_users_are_not_counted_twice() -> None:
+    gap = _gap({"alice"})
+    assert all(r["keyId"] != KNOWN_SHA for r in gap)
+
+
+def test_carher_hangzhou_is_shown_as_its_own_row() -> None:
+    gap = [r for r in _gap({"alice"}) if r["keyId"] == HANGZHOU_SHA]
+    assert {r["_userId"] for r in gap} == {"key:carher-hangzhou"}
+    assert {r["employeeName"] for r in gap} == {"carher-hangzhou"}
+    assert sum(r["requestCount"] for r in gap) == 11955
+    assert round(sum(r["spend"] for r in gap), 2) == 71.75
+    assert {r["model"] for r in gap} == {"gpt-5.6", "claude-opus-5-5"}
+    assert all(r["userTeamId"] == "team-hz" for r in gap)
+
+
+def test_orphan_owner_keeps_its_user_id() -> None:
+    gap = [r for r in _gap({"alice"}) if r["keyId"] == ORPHAN_SHA]
+    assert {r["_userId"] for r in gap} == {"claude-code-x-std"}
+    assert round(sum(r["spend"] for r in gap), 2) == 4547.73
+
+
+def test_gap_rows_are_display_only_not_billable() -> None:
+    gap = _gap({"alice"})
+    assert gap and all(r["billingEligible"] is False and r["attributionSource"] == "key_rollup" for r in gap)
+
+
+def test_deleted_key_is_labelled() -> None:
+    gap = [r for r in _gap({"alice"}) if r["keyId"] == DELETED_SHA]
+    assert gap and gap[0]["employeeName"] == "已删除的 key"
+
+
+def test_rollup_failure_does_not_break_sync() -> None:
+    class Broken(_Client):
+        async def request_backend(self, *a, **k):  # type: ignore[override]
+            raise RuntimeError("upstream down")
+
+    sync = UsageSynchronizer(Broken(), store=None)
+    assert asyncio.run(sync._key_rollup_gap_rows(PRIMARY, "2026-10-12", "2026-10-12", set(), {})) == []
+
+
+def test_every_upstream_request_is_covered_exactly_once() -> None:
+    """按人统计看到的(alice)+ 补漏行 == 上游全局总数,不多不少。"""
+    gap = _gap({"alice"})
+    per_user_seen = 100
+    assert per_user_seen + sum(r["requestCount"] for r in gap) == 14012
+
+
+def test_coverage_gap_warns_only_on_real_drift(caplog) -> None:
+    import logging as _logging
+    sync = UsageSynchronizer(_Client(), store=None)
+    sync._last_rollup_totals = {"backend": "primary", "start": "d", "end": "d", "spend": 1000.0}
+    with caplog.at_level(_logging.INFO, logger="ai-token-dashboard.usage-sync"):
+        sync._log_coverage_gap("primary", "d", "d", [{"spend": 995.0}])
+        sync._log_coverage_gap("primary", "d", "d", [{"spend": 700.0}])
+    levels = [r.levelno for r in caplog.records if "usage coverage gap" in r.getMessage()]
+    assert levels == [_logging.INFO, _logging.WARNING]
