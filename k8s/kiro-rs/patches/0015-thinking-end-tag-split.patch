+    /// 辅助函数：取 message_delta 的 stop_reason
+    fn stop_reason_of(events: &[SseEvent]) -> String {
+        events
+            .iter()
+            .find(|e| e.event == "message_delta")
+            .and_then(|e| e.data["delta"]["stop_reason"].as_str())
+            .unwrap_or("")
+            .to_string()
+    }
+
+    /// 辅助函数：断言没有任何 thinking_delta 带出了结束标签
+    fn assert_no_end_tag_in_thinking(events: &[SseEvent]) {
+        let thinking = collect_thinking_content(events);
+        assert!(
+            !thinking.contains("</thinking>"),
+            "`</thinking>` leaked into thinking_delta: {:?}",
+            thinking
+        );
+    }
+
+    #[test]
+    fn test_end_tag_at_chunk_end_then_text_without_newline() {
+        // 线上复现形状：`\n</thinking>` 恰好在一段末尾，下一段直接是正文（没有 `\n\n`）
+        let mut ctx = StreamContext::new_with_thinking("claude-opus-5", 1000, true, HashMap::new());
+        let _initial_events = ctx.generate_initial_events();
+
+        let mut all = Vec::new();
+        all.extend(ctx.process_assistant_response(
+            "<thinking>\nLet me check creds-b25-binus.txt.\n</thinking>",
+        ));
+        all.extend(ctx.process_assistant_response("等一下，这组凭据有个重要发现——先核"));
+        all.extend(ctx.generate_final_events());
+
+        assert_no_end_tag_in_thinking(&all);
+        assert_eq!(collect_thinking_content(&all), "Let me check creds-b25-binus.txt.\n");
+        assert_eq!(collect_text_content(&all), "等一下，这组凭据有个重要发现——先核");
+        assert_eq!(stop_reason_of(&all), "end_turn");
+    }
+
