+        let a = normalize_tool_use_id(cursor_id);
+        assert!(a.len() <= TOOL_USE_ID_MAX_LEN, "len={}", a.len());
+        assert_eq!(a, normalize_tool_use_id(cursor_id), "必须确定性");
+        // 前缀相同、尾部不同的两个长 id 不能撞
+        let other = cursor_id.replace("aws_uw2_4", "aws_uw2_5");
+        assert_ne!(a, normalize_tool_use_id(&other));
+        assert!(!a.contains('\n'));
+        let cjk = "调".repeat(40);
+        let c = normalize_tool_use_id(&cjk);
+        assert!(c.len() <= TOOL_USE_ID_MAX_LEN && c.is_ascii());
+    }
