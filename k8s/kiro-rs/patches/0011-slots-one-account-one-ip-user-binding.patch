+                return;
+            }
+            *last = Some(Instant::now());
+        }
+        let text = format!(
+            "【kiro 槽位实例】号池余额预警：剩 {:.0} / {:.0} 积分，近 {} 分钟消耗约 {:.0}/小时，预计还能撑 {:.1} 小时（< 24 小时）。启用号 {} 个。请补号或减少灰度流量。",
