+    /// Admin：号池余额总计 + 预计可撑时长
+    pub fn pool_runway(&self) -> (crate::kiro::slots::Runway, Vec<(u64, f64, f64)>) {
+        let pb = self.pool_balance.lock();
+        let total: f64 = pb.0.values().map(|(r, _)| r).sum();
+        let limit: f64 = pb.0.values().map(|(_, l)| l).sum();
+        let mut per: Vec<(u64, f64, f64)> = pb.0.iter().map(|(k, (r, l))| (*k, *r, *l)).collect();
+        per.sort_by_key(|x| x.0);
+        (pb.1.runway(total, limit), per)
+    }
