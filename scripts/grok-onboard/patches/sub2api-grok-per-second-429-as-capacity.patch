+
+// isGrokPerSecondRateLimitText matches xAI's per-second team+model ceiling,
+// e.g. "Requests per Second (actual/limit): 2/2". A one-second burst cap is
+// request pressure, not quota exhaustion: the same requests spaced out all
+// succeed and other models on the team are unaffected. Treating it as a plain
+// rate limit cools the whole account and, with a single serving leg, takes
+// every model in the pool down for the fallback window. Per-minute and token
+// limits deliberately stay on the rate-limit path.
+func isGrokPerSecondRateLimitText(low string) bool {
+	return strings.Contains(low, "requests per second")
 }
 
 func isGrokRateLimitText(low string) bool {
