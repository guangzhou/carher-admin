+        use crate::kiro::model::events::Event;
+        use crate::kiro::parser::decoder::EventStreamDecoder;
+        let mut d = EventStreamDecoder::new();
+        d.feed(&kiro_text_frame("中文 ⚠️ \"quoted\"\n")).unwrap();
+        let evs: Vec<_> = d.decode_iter().flatten().map(|f| Event::from_frame(f).unwrap()).collect();
+        assert_eq!(evs.len(), 1);
+        match &evs[0] {
+            Event::AssistantResponse(r) => assert_eq!(r.content, "中文 ⚠️ \"quoted\"\n"),
+            other => panic!("期望文本帧，实际 {:?}", other),
+        }
+    }
