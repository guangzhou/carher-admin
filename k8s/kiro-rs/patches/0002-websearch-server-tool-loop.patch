+/// 搜索结果 → 交回模型的 tool_result 文本
+pub fn format_results_for_model(query: &str, results: &Option<WebSearchResults>) -> String {
+    let Some(results) = results else {
+        return format!("Web search for \"{}\" failed (search backend unavailable).", query);
+    };
+    if results.results.is_empty() {
+        return format!("Web search for \"{}\" returned no results.", query);
+    }
+    let mut out = format!("Web search results for \"{}\":\n\n", query);
+    for (i, r) in results.results.iter().enumerate() {
+        out.push_str(&format!("[{}] {}\nURL: {}\n", i + 1, r.title, r.url));
+        if let Some(date) = r.published_date.and_then(chrono::DateTime::from_timestamp_millis) {
+            out.push_str(&format!("Published: {}\n", date.format("%Y-%m-%d")));
+        }
+        if let Some(ref snippet) = r.snippet {
+            out.push_str(&truncate_chars(snippet, 600));
+            out.push('\n');
+        }
+        out.push('\n');
+    }
+    out
+}
+
+fn truncate_chars(s: &str, max: usize) -> String {
+    match s.char_indices().nth(max) {
+        Some((idx, _)) => format!("{}...", &s[..idx]),
+        None => s.to_string(),
+    }
+}
+
+/// 历史里客户端回显的服务端搜索块 → 一段文本（converter 用）
+///
+/// 真 Anthropic 返回的 encrypted_content 是不透明密文（长串、无空白），没有信息量，跳过；
+/// 本服务返回的 encrypted_content 是明文摘要，截断后保留。
+pub fn flatten_server_block(item: &serde_json::Value) -> Option<String> {
+    match item.get("type")?.as_str()? {
+        "server_tool_use" => {
+            if item.get("name").and_then(|n| n.as_str()) != Some(WEB_SEARCH_TOOL_NAME) {
+                return None;
+            }
+            let query = item
+                .get("input")
+                .and_then(|i| i.get("query"))
+                .and_then(|q| q.as_str())
+                .unwrap_or("");
+            Some(format!("[Searched the web for: {}]", query))
+        }
+        "web_search_tool_result" => {
+            let content = item.get("content")?;
+            let Some(arr) = content.as_array() else {
+                return Some("[Web search failed]".to_string());
+            };
+            let mut out = String::from("[Web search results]\n");
+            for (i, r) in arr.iter().enumerate() {
+                let title = r.get("title").and_then(|v| v.as_str()).unwrap_or("");
+                let url = r.get("url").and_then(|v| v.as_str()).unwrap_or("");
+                out.push_str(&format!("{}. {} — {}\n", i + 1, title, url));
+                if let Some(snip) = r.get("encrypted_content").and_then(|v| v.as_str()) {
+                    let opaque = snip.len() > 200 && !snip.contains(char::is_whitespace);
+                    if !snip.is_empty() && !opaque {
+                        out.push_str(&format!("   {}\n", truncate_chars(snip, 300)));
+                    }
+                }
+            }
+            Some(out)
+        }
+        _ => None,
+    }
+}
