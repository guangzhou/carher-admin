@@ -0,0 +1,198 @@
+"""全员看板（/api/admin/usage）的三处耗时修复。
+
+2026-10-20 生产实测：一次刷新约 3.3 秒，前端每 5 秒自动刷新一次。
+- 逐请求明细金额（spend）在上游一天超过 10000 条时必然不完整、永不进缓存，
+  每次请求都同步扫一遍（约 2 秒），而活动汇总自带完整金额时根本用不到它
+- 缓存 key 带着 Redis 实时计数（几秒一变），命中率只有 27%
+"""
+
+import asyncio
+from datetime import datetime, timezone
+
+from backend import main
+
+
+class _Store:
+    """admin_rows 计数；snapshot_revision 由测试控制。"""
+
+    def __init__(self) -> None:
+        self.admin_rows_calls = 0
+        self.revision = "2026-10-20 06:00:00+00:rt:100:2026-10-20 06:00:00+00"
+
+    async def connect(self):
+        return None
+
+    async def snapshot_revision(self, *_args):
+        return self.revision
+
+    async def admin_rows(self, *_args):
+        self.admin_rows_calls += 1
+        return {
+            "rows": [],
+            "summaryRows": [{"source": "Codex", "model": "m", "totalTokens": 10, "requestCount": 1, "spend": 1.0}],
+            "employees": [],
+            "lastSyncedAt": datetime(2026, 10, 20, 6, 0, tzinfo=timezone.utc),
+        }
+
+
+def _patch_common(monkeypatch, store: _Store, live_calls: list[str], activity_value: dict) -> None:
+    async def fake_live(kind, start_date, end_date, refresh=False):
+        live_calls.append(kind)
+        if kind == "activity":
+            return {"value": activity_value, "cacheStatus": "fresh", "cacheAgeSeconds": 1, "refreshInProgress": False, "refreshError": ""}
+        return {"value": {"complete": False, "missingBackends": ["primary"], "perBackend": {}}, "cacheStatus": "miss", "cacheAgeSeconds": 0, "refreshInProgress": False, "refreshError": ""}
+
+    monkeypatch.setattr(main, "usage_store", lambda: store)
+    monkeypatch.setattr(main, "usage_backend_ids", lambda: ["primary", "her"])
+    monkeypatch.setattr(main, "get_live_totals_cached", fake_live)
+    monkeypatch.setattr(main, "realtime_enabled", lambda: False)
+    main.admin_usage_cache.clear()
+
+
+COMPLETE_ACTIVITY = {"complete": True, "spendAvailable": True, "totals": {"totalTokens": 10, "requestCount": 1, "spend": 1.0}, "perBackend": {}}
+
+
+def _payload(start="2026-10-01", end="2026-10-05"):
+    return asyncio.run(main.admin_usage_payload({"email": "admin@example.com"}, start, end, "all", None))
+
+
+def test_complete_activity_skips_the_capped_spend_scan(monkeypatch) -> None:
+    store, calls = _Store(), []
+    _patch_common(monkeypatch, store, calls, COMPLETE_ACTIVITY)
+
+    payload = _payload()
+
+    assert calls == ["activity"], "活动汇总已带完整金额时不该再扫逐请求明细"
+    live = payload["liveTotals"]
+    assert live["spendAvailable"] is True
+    assert live["totals"]["spend"] == 1.0
+    # 没去扫明细，就不能把它报成"金额不可用"
+    assert payload["dataQuality"].get("liveSpendStatus") != "unavailable"
+
+
+def test_activity_without_spend_still_falls_back_to_the_spend_scan(monkeypatch) -> None:
+    """阴性对照：活动汇总没有金额时，照旧去取明细金额。"""
+    store, calls = _Store(), []
+    _patch_common(monkeypatch, store, calls, {**COMPLETE_ACTIVITY, "spendAvailable": False})
+
+    payload = _payload()
+
+    assert calls == ["activity", "spend"]
+    assert payload["liveTotals"]["spendAvailable"] is False
+
+
+def test_incomplete_activity_still_falls_back_to_the_spend_scan(monkeypatch) -> None:
+    store, calls = _Store(), []
+    _patch_common(monkeypatch, store, calls, {**COMPLETE_ACTIVITY, "complete": False})
+
+    _payload()
+
+    assert calls == ["activity", "spend"]
+
+
+def test_redis_live_counter_change_does_not_bust_the_cache(monkeypatch) -> None:
+    """snapshot_revision 末尾的 :live:<Redis 计数> 几秒一变，不能让缓存失效。"""
+    store, calls = _Store(), []
+    _patch_common(monkeypatch, store, calls, COMPLETE_ACTIVITY)
+    revisions = iter(["base:live:1", "base:live:2", "base:live:3"])
+
+    async def fake_revision(*_args):
+        return next(revisions)
+
+    monkeypatch.setattr(main, "snapshot_revision", fake_revision)
+    monkeypatch.setattr(main, "attach_snapshot_freshness", lambda payload, *_a, **_k: payload)
+
+    first = _payload("2026-10-20", "2026-10-20")
+    second = _payload("2026-10-20", "2026-10-20")
+    third = _payload("2026-10-20", "2026-10-20")
+
+    assert store.admin_rows_calls == 1
+    assert first["cache"]["hit"] is False
+    assert second["cache"]["hit"] is True and third["cache"]["hit"] is True
+    assert "_lastSyncedAt" not in second, "内部字段不能出现在响应里"
+
+
+def test_archived_realtime_publish_still_busts_the_cache(monkeypatch) -> None:
+    """阳性对照：Postgres 里的实时归档发布了（:rt:<revision> 变了）就必须重查。"""
+    store, calls = _Store(), []
+    _patch_common(monkeypatch, store, calls, COMPLETE_ACTIVITY)
+    revisions = iter(["cov:rt:100:t1:live:1", "cov:rt:101:t2:live:1"])
+
+    async def fake_revision(*_args):
+        return next(revisions)
+
+    monkeypatch.setattr(main, "snapshot_revision", fake_revision)
+    monkeypatch.setattr(main, "attach_snapshot_freshness", lambda payload, *_a, **_k: payload)
+
+    _payload("2026-10-20", "2026-10-20")
+    _payload("2026-10-20", "2026-10-20")
+
+    assert store.admin_rows_calls == 2
+
+
+def test_cache_hit_recomputes_freshness_with_the_current_revision(monkeypatch) -> None:
+    """命中缓存时，新鲜度要按当前实时状态重算，而不是沿用缓存里那份。"""
+    store, calls = _Store(), []
+    _patch_common(monkeypatch, store, calls, COMPLETE_ACTIVITY)
+    revisions = iter(["base:live:1", "base:live:2"])
+    seen: list[tuple] = []
+
+    async def fake_revision(*_args):
+        return next(revisions)
+
+    def fake_freshness(payload, last_synced, start, end, revision):
+        seen.append((last_synced, revision))
+        payload["dataFreshness"] = {"realtimeRevision": revision}
+        return payload
+
+    monkeypatch.setattr(main, "snapshot_revision", fake_revision)
+    monkeypatch.setattr(main, "attach_snapshot_freshness", fake_freshness)
+
+    _payload("2026-10-20", "2026-10-20")
+    second = _payload("2026-10-20", "2026-10-20")
+
+    assert second["cache"]["hit"] is True
+    assert second["dataFreshness"]["realtimeRevision"] == "base:live:2"
+    assert seen[-1] == (datetime(2026, 10, 20, 6, 0, tzinfo=timezone.utc), "base:live:2")
+
+
+def test_today_cache_key_rolls_over_with_the_live_totals_ttl(monkeypatch) -> None:
+    """含今天的范围：顶部实时总数跟着缓存走，时间桶保证它不比 ADMIN_LIVE_TOTALS_CACHE_TTL_SECONDS 更旧。"""
+    store, calls = _Store(), []
+    _patch_common(monkeypatch, store, calls, COMPLETE_ACTIVITY)
+    now = [60 * 1000.0]  # 正好在一个 60 秒桶的起点
+
+    async def fake_revision(*_args):
+        return "base:live:1"
+
+    monkeypatch.setattr(main, "snapshot_revision", fake_revision)
+    monkeypatch.setattr(main, "attach_snapshot_freshness", lambda payload, *_a, **_k: payload)
+    monkeypatch.setattr(main.time, "time", lambda: now[0])
+    monkeypatch.setenv("ADMIN_LIVE_TOTALS_CACHE_TTL_SECONDS", "60")
+
+    _payload("2026-10-20", "2026-10-20")
+    now[0] += 59  # 同一个桶
+    _payload("2026-10-20", "2026-10-20")
+    assert store.admin_rows_calls == 1, "同一个桶内应命中缓存"
+    now[0] += 2  # 跨到下一个桶
+    _payload("2026-10-20", "2026-10-20")
+    assert store.admin_rows_calls == 2, "跨过 TTL 桶必须重算"
+
+
+def test_history_range_cache_key_has_no_time_bucket(monkeypatch) -> None:
+    """不含今天的历史范围：数据只随快照发布变，不需要时间桶。"""
+    store, calls = _Store(), []
+    _patch_common(monkeypatch, store, calls, COMPLETE_ACTIVITY)
+    now = [1_000_000.0]
+
+    async def fake_revision(*_args):
+        return "2026-10-05 00:00:00+00"
+
+    monkeypatch.setattr(main, "snapshot_revision", fake_revision)
+    monkeypatch.setattr(main.time, "time", lambda: now[0])
+
+    _payload()
+    now[0] += 200  # 跨过好几个 60 秒桶，但仍在 ADMIN_USAGE_CACHE_TTL_SECONDS（300）内
+    _payload()
+
+    assert store.admin_rows_calls == 1
