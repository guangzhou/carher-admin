+package openai
+
+// carher: chat-path images. Gemini returns gg-dl links that only open with the
+// Google account's cookie, so a chat client (Cursor, Cherry, OWUI) renders a
+// broken image. The provider already downloads with that cookie when asked; we
+// keep the bytes here and hand the client a link to this gateway instead.
+
+import (
+	"crypto/rand"
+	"encoding/base64"
+	"encoding/hex"
+	"os"
+	"strings"
+	"sync"
+	"time"
+
+	"gemini-web-to-api/internal/modules/providers"
+)
+
+const (
+	mediaTTL      = 24 * time.Hour
+	mediaMaxBytes = 512 << 20
+)
+
+type mediaItem struct {
+	data    []byte
+	mime    string
+	created time.Time
+}
+
+type mediaStore struct {
+	mu    sync.Mutex
+	items map[string]*mediaItem
+	order []string
+	size  int
+}
+
+var chatMedia = &mediaStore{items: map[string]*mediaItem{}}
+
+// mediaPublicBase is where clients reach GET /openai/v1/media/:id. Empty disables rewriting.
+func mediaPublicBase() string {
+	return strings.TrimRight(strings.TrimSpace(os.Getenv("GEMINI_MEDIA_PUBLIC_BASE")), "/")
+}
+
+func (s *mediaStore) put(b64, mime string) (string, bool) {
+	data, err := base64.StdEncoding.DecodeString(b64)
+	if err != nil || len(data) == 0 {
+		return "", false
+	}
+	buf := make([]byte, 16)
+	if _, err := rand.Read(buf); err != nil {
+		return "", false
+	}
+	id := hex.EncodeToString(buf)
+	if mime == "" || !strings.HasPrefix(mime, "image/") {
+		mime = sniffImageMime(data)
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.evictLocked(len(data))
+	s.items[id] = &mediaItem{data: data, mime: mime, created: time.Now()}
+	s.order = append(s.order, id)
+	s.size += len(data)
+	return id, true
+}
+
+func (s *mediaStore) get(id string) (*mediaItem, bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	it, ok := s.items[id]
+	if !ok || time.Since(it.created) > mediaTTL {
+		return nil, false
+	}
+	return it, true
+}
+
+func (s *mediaStore) evictLocked(incoming int) {
+	for len(s.order) > 0 {
+		head := s.items[s.order[0]]
+		expired := head == nil || time.Since(head.created) > mediaTTL
+		if !expired && s.size+incoming <= mediaMaxBytes {
+			return
+		}
+		if head != nil {
+			s.size -= len(head.data)
+		}
+		delete(s.items, s.order[0])
+		s.order = s.order[1:]
+	}
+}
+
+func sniffImageMime(b []byte) string {
+	switch {
+	case len(b) >= 3 && b[0] == 0xff && b[1] == 0xd8 && b[2] == 0xff:
+		return "image/jpeg"
+	case len(b) >= 12 && string(b[0:4]) == "RIFF" && string(b[8:12]) == "WEBP":
+		return "image/webp"
+	case len(b) >= 4 && string(b[0:4]) == "GIF8":
+		return "image/gif"
+	default:
+		return "image/png"
+	}
+}
+
+// chatImageURL returns a link the chat client can open: our own copy when the
+// provider handed us the bytes, otherwise the original (cookie-bound) URL.
+func chatImageURL(img providers.Image) string {
+	base := mediaPublicBase()
+	if base == "" || img.B64JSON == "" {
+		return img.URL
+	}
+	id, ok := chatMedia.put(img.B64JSON, img.MimeType)
+	if !ok {
+		return img.URL
+	}
+	return base + "/openai/v1/media/" + id
+}
+
+func validMediaID(id string) bool {
+	if len(id) != 32 {
+		return false
+	}
+	_, err := hex.DecodeString(id)
+	return err == nil
+}
