+            }
+            if status.as_u16() == 400 {
+                anyhow::bail!("{} API 请求失败: {} {}", api_type, status, body);
+            }
+            if matches!(status.as_u16(), 401 | 403) && !forced_refresh {
+                forced_refresh = true;
+                if self.token_manager.force_refresh_token_for(ctx.id).await.is_ok() {
+                    continue;
+                }
+            }
+            if status.as_u16() == 429 {
+                let ra = Self::retry_after(&body);
+                self.token_manager.slot_report_429(slot, tries_429 == 0, ra);
+                tries_429 += 1;
+                last_error = Some(anyhow::anyhow!("{} API 请求失败: {} {}", api_type, status, body));
+                sleep(Self::slot_backoff(tries_429, ra)).await;
+                continue;
+            }
+            last_error = Some(anyhow::anyhow!("{} API 请求失败: {} {}", api_type, status, body));
