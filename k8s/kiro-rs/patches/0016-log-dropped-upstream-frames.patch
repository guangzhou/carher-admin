+/// 日志用：payload 字节 sha256 的前 12 位十六进制。
+///
+/// 🔴 日志里绝不放 payload 原文：上游 payload 是模型输出，可能含密钥 / 手机号，
+/// 198 的脱敏插件管不到 kiro-rs 的日志。要对照同一帧时用这个指纹。
+fn payload_sha12(payload: &[u8]) -> String {
+    use sha2::{Digest, Sha256};
+    let mut h = hex::encode(Sha256::digest(payload));
+    h.truncate(12);
+    h
+}
+
+/// 日志用的错误描述，不含 payload 原文。
+///
+/// serde_json 的错误信息会引用出错的值（例如 `invalid type: string "sk-…", expected f64`），
+/// 所以 `PayloadDeserialize` 只留错误类别和行列号；其他变体不含 payload，照原样输出。
+fn redacted_error(e: &ParseError) -> String {
+    match e {
+        ParseError::PayloadDeserialize(je) => format!(
+            "Payload 反序列化失败: {:?} at line {} column {}",
+            je.classify(),
+            je.line(),
+            je.column()
+        ),
+        other => other.to_string(),
+    }
+}
