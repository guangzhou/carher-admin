+    /// 槽位模式：用户固定在一个槽，429 不换号（官方退避），满了排队；
+    /// 号额度用完 / opus 被限 ⇒ 槽位换新号后重发。
+    async fn call_api_slots(
+        &self,
+        request_body: &str,
+        is_stream: bool,
+        user_key: &str,
+    ) -> anyhow::Result<reqwest::Response> {
+        let api_type = if is_stream { "流式" } else { "非流式" };
+        let is_opus = Self::extract_model_from_request(request_body)
+            .map(|m| m.to_lowercase().contains("opus"))
+            .unwrap_or(false);
+        let mut last_error: Option<anyhow::Error> = None;
+        let mut forced_refresh = false;
+        let mut swaps = 0u32;
+        let mut tries_429 = 0u32;
+        let mut regone = 0u32;
+        for attempt in 0..SLOT_MAX_ATTEMPTS {
+            let (slot, ctx) = self.token_manager.acquire_slot_context(user_key).await?;
+            let permit = match self.token_manager.acquire_slot_permit(slot).await {
+                Ok(p) => p,
+                // 排队时这个槽被删 / 停用：用户绑定已随槽清掉，重新选槽即落到别的槽，用户无感
+                Err(e) if e.to_string().contains(crate::kiro::slots::SLOT_GONE_MARK) && regone < 2 => {
+                    regone += 1;
+                    tracing::info!("槽位已移除，用户 {} 重新选槽", user_key);
+                    continue;
+                }
+                Err(e) => return Err(e),
+            };
+            let config = self.token_manager.config();
+            let machine_id = machine_id::generate_from_credentials(&ctx.credentials, config);
+            let endpoint = self.endpoint_for(&ctx.credentials)?;
+            let rctx = RequestContext {
+                credentials: &ctx.credentials,
+                token: &ctx.token,
+                machine_id: &machine_id,
+                config,
+            };
+            let url = endpoint.api_url(&rctx);
+            let body = endpoint.transform_api_body(request_body, &rctx);
+            let base = self
+                .client_for(&ctx.credentials)?
+                .post(&url)
+                .body(body)
+                .header("content-type", "application/json")
+                .header("Connection", "close");
+            let client = self.client_for(&ctx.credentials)?;
+            let mut built = endpoint.decorate_api(base, &rctx).build()?;
+            if let Ok(v) = reqwest::header::HeaderValue::from_str(&format!(
+                "attempt={}; max={}",
+                attempt + 1,
+                SLOT_MAX_ATTEMPTS
+            )) {
+                built.headers_mut().insert("amz-sdk-request", v);
+            }
