+    fn account_usage_path(&self) -> Option<PathBuf> {
+        self.cache_dir().map(|d| d.join("kiro_account_usage.json"))
+    }
+
+    fn load_account_usage(&self) {
+        let u: crate::kiro::account_usage::AccountUsage = self
+            .account_usage_path()
+            .and_then(|p| std::fs::read_to_string(p).ok())
+            .and_then(|c| serde_json::from_str(&c).ok())
+            .unwrap_or_default();
+        *self.account_usage.lock() = u;
+        // 可选：人工提供的精确基线（统计上线那一刻的历史累计），只补没有的号
+        if let Some(p) = self.cache_dir().map(|d| d.join("kiro_usage_baseline.json")) {
+            #[derive(serde::Deserialize)]
+            struct B { since: Option<i64>, #[serde(default)] baseline: std::collections::BTreeMap<u64, u64> }
+            if let Some(b) = std::fs::read_to_string(&p).ok().and_then(|c| serde_json::from_str::<B>(&c).ok()) {
+                let mut u = self.account_usage.lock();
+                if let Some(t) = b.since {
+                    u.since = Some(u.since.map_or(t, |x| x.min(t)));
+                }
+                for (k, v) in b.baseline {
+                    u.baseline.entry(k).or_insert(v);
+                }
+                self.account_usage_dirty.store(true, Ordering::Relaxed);
+            }
+        }
+        self.seed_usage_baselines();
+    }
+
+    /// 给还没有基线的号补基线 = 它此刻的历史累计成功（新加的号基线 = 0 或当前值）
+    fn seed_usage_baselines(&self) {
+        let now = chrono::Utc::now().timestamp();
+        let counts: Vec<(u64, u64)> = self.entries.lock().iter().map(|e| (e.id, e.success_count)).collect();
+        let mut u = self.account_usage.lock();
+        let before = u.baseline.len();
+        for (id, n) in counts {
+            u.ensure_baseline(now, id, n);
+        }
+        if u.baseline.len() != before {
+            self.account_usage_dirty.store(true, Ordering::Relaxed);
+        }
+    }
+
+    /// Admin：统计开始时刻 + 该号统计前的历史累计
+    pub fn usage_baseline(&self, account: u64) -> (Option<i64>, Option<u64>) {
+        let u = self.account_usage.lock();
+        (u.since, u.baseline.get(&account).copied())
+    }
+
+    /// 记一次请求（响应流结束时调用）
+    pub fn record_account_usage(&self, account: u64, model: &str, ok: bool, input: u64, output: u64) {
+        // 统计后才加进来的号：基线 = 0（它的历史累计全部发生在统计期内）
+        if !self.account_usage.lock().baseline.contains_key(&account) {
+            let lifetime = self.entries.lock().iter().find(|e| e.id == account).map(|e| e.success_count).unwrap_or(0);
+            let ok_now = if ok { 1 } else { 0 };
+            self.account_usage.lock().ensure_baseline(chrono::Utc::now().timestamp(), account, lifetime.saturating_sub(ok_now));
+        }
+        self.account_usage.lock().record(chrono::Utc::now().timestamp(), account, model, ok, input, output);
+        self.account_usage_dirty.store(true, Ordering::Relaxed);
+    }
+
+    /// 周期落盘（有变化才写）
+    pub fn save_account_usage(&self) {
+        if !self.account_usage_dirty.swap(false, Ordering::Relaxed) {
+            return;
+        }
+        let Some(path) = self.account_usage_path() else { return };
+        let json = serde_json::to_string(&*self.account_usage.lock());
+        let Ok(json) = json else { return };
+        let _w = self.write_lock.lock();
+        let tmp = path.with_extension("json.tmp");
+        let write = || std::fs::write(&tmp, &json).and_then(|_| std::fs::rename(&tmp, &path));
+        let r = if tokio::runtime::Handle::try_current().is_ok() { tokio::task::block_in_place(write) } else { write() };
+        if r.is_err() {
+            tracing::warn!("保存账户用量失败: {:?}", path);
+        }
+    }
