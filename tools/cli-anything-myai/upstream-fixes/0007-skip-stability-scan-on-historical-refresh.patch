+++ b/tests/test_historical_refresh_skips_stability.py
@@ -0,0 +1,78 @@
+"""历史日期的刷新不再陪跑「今天」的稳定性扫描。
+
+稳定性扫描终点固定是 usage_today()，跟同步窗口无关。2026-10-20 生产：刷新 10-15 这类历史日期时
+它每次约 23 分钟（今天 2000+ 页），整个刷新撞 USAGE_REFRESH_TASK_TIMEOUT_SECONDS=1800 被杀，
+同一批日期反复重来。
+"""
+
+import asyncio
+from datetime import date
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+
+from backend import usage_sync
+from backend.usage_sync import UsageSynchronizer
+
+
+def _snapshot(backend_id):
+    return SimpleNamespace(
+        backend_id=backend_id, rows=[], memberships=[], events=None,
+        departments=[], identities=[], quality={"complete": True},
+    )
+
+
+def _sync(monkeypatch):
+    monkeypatch.setenv("ADMIN_OBSERVABILITY_DASHBOARDS_ENABLED", "true")
+    monkeypatch.setattr(usage_sync, "usage_today", lambda: date(2026, 10, 20))
+    store = SimpleNamespace(
+        begin_sync_run=AsyncMock(return_value=1),
+        try_acquire_sync_lock=AsyncMock(return_value=object()),
+        release_sync_lock=AsyncMock(), finish_sync_run=AsyncMock(),
+        publish_snapshots=AsyncMock(return_value={"rowCount": 0, "snapshotRevision": "r"}),
+        stability_sync_states=AsyncMock(return_value=[]),
+        publish_stability_events=AsyncMock(),
+    )
+    sync = UsageSynchronizer(SimpleNamespace(backends=[SimpleNamespace(id="primary")]), store)
+    sync._identity_directory = AsyncMock(return_value={})
+    sync._refresh_historical_identity = AsyncMock()
+    sync._sync_stability_backend = AsyncMock()
+    seen = {}
+
+    async def collect(backend, *_args):
+        # collect_backend 里有一条后备路径：标记没置时会自己再扫一遍稳定性
+        seen["collected_separately"] = getattr(sync, "_stability_collected_separately", False)
+        return _snapshot(backend.id)
+
+    sync.collect_backend = collect
+    return sync, seen
+
+
+def test_historical_refresh_skips_the_today_stability_scan(monkeypatch) -> None:
+    sync, seen = _sync(monkeypatch)
+
+    result = asyncio.run(sync.sync("2026-10-15", "2026-10-15"))
+
+    assert result["status"] == "ok"
+    sync._sync_stability_backend.assert_not_awaited()
+    assert seen["collected_separately"] is True, "标记不置，collect_backend 会退回去再扫一遍，跳了等于没跳"
+
+
+@pytest.mark.parametrize("window", [("2026-10-20", "2026-10-20"), ("2026-10-18", "2026-10-20")])
+def test_ranges_ending_today_still_scan_stability(monkeypatch, window) -> None:
+    """阳性对照：周期同步和今天的刷新照旧带稳定性。"""
+    sync, _ = _sync(monkeypatch)
+
+    asyncio.run(sync.sync(*window))
+
+    sync._sync_stability_backend.assert_awaited_once()
+
+
+def test_observability_disabled_never_scans(monkeypatch) -> None:
+    sync, _ = _sync(monkeypatch)
+    monkeypatch.setenv("ADMIN_OBSERVABILITY_DASHBOARDS_ENABLED", "false")
+
+    asyncio.run(sync.sync("2026-10-20", "2026-10-20"))
+
+    sync._sync_stability_backend.assert_not_awaited()
