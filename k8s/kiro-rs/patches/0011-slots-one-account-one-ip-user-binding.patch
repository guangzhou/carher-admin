+        <Button size='sm' variant='ghost' className='ml-auto' onClick={() => setMore((x) => !x)} aria-expanded={more}>{more ? '收起' : '明细'}</Button>
+      </div>
+      {result && <TestBadge r={result} onOpen={onOpen} />}
+    </div>
+  )
+}
+
+
+const SCENARIOS: { k: SlotTestScenario; label: string }[] = [
+  { k: 'hello', label: '打招呼（回 OK）' },
+  { k: 'reason', label: '简单推理' },
+  { k: 'tool', label: '调工具跑命令' },
+]
+
+const TEST_MODELS = [
+  'claude-opus-5-5', 'claude-sonnet-5-5', 'claude-opus-5', 'claude-sonnet-5',
+  'claude-opus-4-8', 'claude-opus-4-6', 'claude-sonnet-4-6', 'claude-haiku-4-5',
+]
+
+function SlotTable({ slots, today }: { slots: SlotView[]; today: Record<string, { requests: number; inputTokens: number; outputTokens: number }> }) {
+  const [model, setModel] = useState(TEST_MODELS[0])
+  const [scenario, setScenario] = useState<SlotTestScenario>('hello')
+  const [open, setOpen] = useState<number | null>(null)
+  const [results, setResults] = useState<Record<number, SlotTestResult>>({})
+  const [busy, setBusy] = useState<Record<number, boolean>>({})
+  const [all, setAll] = useState(false)
+  const one = async (i: number) => {
+    setBusy((b) => ({ ...b, [i]: true }))
+    try {
+      const r = await testSlot(i, model, scenario)
+      setResults((x) => ({ ...x, [i]: r }))
+    } catch (e) {
+      toast.error(`测试失败: ${extractErrorMessage(e)}`)
+    } finally {
+      setBusy((b) => ({ ...b, [i]: false }))
+    }
+  }
+  const everyone = async () => {
+    setAll(true)
+    try {
+      const rs = await testAllSlots(model, scenario)
+      setResults(Object.fromEntries(rs.map((r) => [r.slot, r])))
+      const ok = rs.filter((r) => r.verdict === 'ok').length
+      ;(ok === rs.length ? toast.success : toast.error)(`${model}：${ok}/${rs.length} 个槽可用`)
+    } catch (e) {
+      toast.error(`测试失败: ${extractErrorMessage(e)}`)
+    } finally {
+      setAll(false)
+    }
+  }
+  return (
+    <div className='space-y-2'>
+    <div className='flex flex-wrap items-center gap-2'>
+      <span className='text-sm text-muted-foreground'>测试模型</span>
+      <select
+        aria-label='测试模型'
+        className='h-8 rounded-md border bg-background px-2 text-sm'
+        value={model}
+        onChange={(e) => setModel(e.target.value)}
+      >
+        {TEST_MODELS.map((m) => <option key={m} value={m}>{m}</option>)}
+      </select>
+      <select
+        aria-label='测试场景'
+        className='h-8 rounded-md border bg-background px-2 text-sm'
+        value={scenario}
+        onChange={(e) => setScenario(e.target.value as SlotTestScenario)}
+      >
+        {SCENARIOS.map((x) => <option key={x.k} value={x.k}>{x.label}</option>)}
+      </select>
+      <Button size='sm' variant='outline' disabled={all} onClick={everyone}>{all ? '测试中…' : '全部槽位测一遍'}</Button>
+      <span className='text-xs text-muted-foreground'>用该槽的号、走该槽出口真打一发；不占并发、不计统计、不换号。点结果看输入/输出</span>
+    </div>
+    <SlotTestDialog
+      r={open == null ? null : results[open] || null}
+      slotName={open == null ? '' : slots.find((x) => x.index === open)?.name || ''}
+      onClose={() => setOpen(null)}
+    />
+    <div className='grid gap-4 sm:grid-cols-2 xl:grid-cols-4'>
+      {slots.map((s) => (
+        <SlotCard key={s.index} s={s} today={s.accountId != null ? today[String(s.accountId)] : undefined} result={results[s.index]}
+          testing={!!busy[s.index] || all} onTest={() => one(s.index)} onOpen={() => setOpen(s.index)} />
+      ))}
+    </div>
+    </div>
+  )
+}
+
+// 顶部 4 张概览卡：模式 / 余额 / 预计可撑 / 冷备
+function Summary({ d }: { d: SlotsOverview }) {
+  const r = d.runway
+  const h = r?.hoursLeft
+  const left = h == null ? '数据不足' : h >= 48 ? `${(h / 24).toFixed(1)} 天` : `${h.toFixed(1)} 小时`
+  const users = d.slots.reduce((a, s) => a + s.users, 0)
+  const inflight = d.slots.reduce((a, s) => a + s.inFlight, 0)
+  return (
+    <div className='grid gap-4 sm:grid-cols-2 lg:grid-cols-4'>
+      <Stat title='槽位模式'>
+        <div className='flex items-center gap-2 text-2xl font-bold'>
+          {d.slots.length} 个槽
+          <Badge variant={d.enabled ? 'success' : 'secondary'}>{d.enabled ? '生效中' : '未启用'}</Badge>
+        </div>
+        <p className='mt-1 text-xs text-muted-foreground'>绑定 {users} 人 · 在途 {inflight}</p>
+      </Stat>
+      <Stat title='号池余额（积分）'>
+        <div className='text-2xl font-bold'>{r ? fmt(r.totalRemaining) : '—'}</div>
+        <p className='mt-1 text-xs text-muted-foreground'>
+          共 {r ? fmt(r.totalLimit) : '—'} · 启用 {d.balances?.length || 0} 个号
+        </p>
+      </Stat>
+      <Stat title='预计还能撑' tone={r?.alert ? 'red' : undefined}>
+        <div className={`text-2xl font-bold ${r?.alert ? 'text-red-600' : ''}`}>{left}</div>
+        <p className='mt-1 text-xs text-muted-foreground'>
+          {r?.burnPerHour == null ? '需观测 ≥30 分钟' : `近 ${r.windowMinutes} 分钟 ${fmt(r.burnPerHour)}/小时`}
+        </p>
+      </Stat>
+      <Stat title='冷备可用' tone={d.spare < d.slots.length ? 'red' : undefined}>
+        <div className={`text-2xl font-bold ${d.spare < d.slots.length ? 'text-red-600' : ''}`}>{d.spare} 个</div>
+        <p className='mt-1 text-xs text-muted-foreground'>
+          {d.spare < d.slots.length ? '少于槽位数，换号可能无号可用' : '号被限或用尽时自动顶上'}
+        </p>
+      </Stat>
+    </div>
+  )
+}
+
+function LimitsForm() {
+  const { data } = useSlots()
+  const { mutate, isPending } = useSetSlotLimits()
+  const [start, setStart] = useState('8')
+  const [min, setMin] = useState('2')
+  const [max, setMax] = useState('16')
+  const [auto, setAuto] = useState(true)
+  useEffect(() => {
+    if (!data) return
+    setStart(String(data.limits.start))
+    setMin(String(data.limits.min))
+    setMax(String(data.limits.max))
+    setAuto(data.limits.autoTune)
+  }, [data?.limits.start, data?.limits.min, data?.limits.max, data?.limits.autoTune])
+  const s = Number(start), lo = Number(min), hi = Number(max)
+  const error =
+    ![s, lo, hi].every(Number.isInteger) ? '请填整数'
+      : lo < 1 || lo > hi || hi > 64 ? '需满足 1 ≤ 下限 ≤ 上限 ≤ 64'
+        : s < lo || s > hi ? '起始值需在下限和上限之间'
+          : null
+  const save = () => {
+    if (error) return
+    mutate({ start: s, min: lo, max: hi, autoTune: auto }, {
+      onSuccess: () => toast.success('已保存，立即生效'),
+      onError: (e) => toast.error(`保存失败: ${extractErrorMessage(e)}`),
+    })
+  }
+  const num = (label: string, v: string, set: (x: string) => void) => (
+    <label className='space-y-1'>
+      <span className='block text-xs text-muted-foreground'>{label}</span>
+      <Input className='w-20' type='number' value={v} onChange={(e) => set(e.target.value)} />
+    </label>
+  )
+  return (
+    <div className='space-y-2'>
+      <div className='text-sm font-medium'>每槽在途上限</div>
+      <div className='flex flex-wrap items-end gap-3'>
+        {num('起始', start, setStart)}
+        {num('下限', min, setMin)}
+        {num('上限', max, setMax)}
+        <label className='flex h-10 items-center gap-2 text-sm'>
+          <input type='checkbox' checked={auto} onChange={(e) => setAuto(e.target.checked)} />
+          按 429 自动调节
+        </label>
+        <Button size='sm' onClick={save} disabled={!!error || isPending}>保存</Button>
+        {error && <span className='text-sm text-red-500'>{error}</span>}
+      </div>
+    </div>
+  )
+}
+
+const TABS = [
+  { k: 'slots', label: '槽位配置' },
+  { k: 'gray', label: '灰度名单' },
+  { k: 'limits', label: '并发上限' },
+] as const
+
+export function SlotsPanel() {
+  const { data, isLoading } = useSlots()
+  const { data: todayData } = useQuery({ queryKey: ['usageTotals', 7], queryFn: () => getUsageTotals(7), refetchInterval: 15000 })
+  const today = todayData?.totals || {}
+  const [open, setOpen] = useState(false)
+  const [tab, setTab] = useState<'slots' | 'gray' | 'limits'>('slots')
+  if (isLoading || !data) return null
+  const r = data.runway
+  return (
+    <section className='space-y-4'>
+      <div className='flex flex-wrap items-center justify-between gap-2'>
+        <h2 className='text-lg font-semibold'>槽位（一号一 IP）</h2>
+        <Button size='sm' variant='outline' onClick={() => setOpen((x) => !x)} aria-expanded={open}>
+          {open ? '收起设置' : '设置'}
+        </Button>
+      </div>
+      {r?.alert && (
+        <div role='alert' className='rounded-lg border border-red-500 bg-red-50 px-4 py-3 text-sm font-medium text-red-700 dark:bg-red-950 dark:text-red-300'>
+          ⚠ 号池预计撑不到 24 小时（剩 {fmt(r.totalRemaining)} 积分，约 {r.hoursLeft?.toFixed(1)} 小时），请尽快补号或减少灰度流量
+        </div>
+      )}
+      <Summary d={data} />
+      {data.slots.length > 0 ? (
+        <SlotTable slots={data.slots} today={today} />
+      ) : (
+        <div className='rounded-lg border p-6 text-center text-sm text-muted-foreground'>还没有槽位，点右上角「设置」添加</div>
+      )}
+      {open && (
+        <Card>
+          <div role='tablist' className='flex gap-1 border-b px-4 pt-3'>
+            {TABS.map((t) => (
+              <button
+                key={t.k}
