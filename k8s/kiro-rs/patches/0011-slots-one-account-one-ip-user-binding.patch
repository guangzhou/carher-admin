+//! 槽位模式：固定 N 个槽位，每槽 = 1 个号 + 1 个固定出口。
+//!
+//! - 用户（LiteLLM key hash）第一次来分到「没封口、在途最少」的槽，之后一直固定；绑定落盘。
+//! - 每槽在途上限 AIMD：撞 429 ×0.7（不低于下限），连续 5 分钟无 429 且跑满 +1（不超上限）。
+//! - 号额度用完 / opus 被限 ⇒ 从冷备挑一个从没上过槽的号接替，出口与绑定不动。
+//!
+//! 本模块只放纯逻辑 + 状态，不做网络；接线在 token_manager / provider。
+
+use std::collections::{HashMap, VecDeque};
+use std::time::{Duration, Instant};
+
+use serde::{Deserialize, Serialize};
+
+/// 会话键前缀：本请求不在槽位灰度名单里（provider 据此走原调度）
+pub const NOT_IN_GRAY: &str = "ng:";
+
+/// 错误串标记：带它的错误由 handler 映射为 529 overloaded（排队超时 / 无可用槽位）
+pub const OVERLOADED_MARK: &str = "SLOT_OVERLOADED";
+/// 错误串标记：用户绑定的槽在排队期间被删除 / 停用 ⇒ 调用方应重新选槽（不是过载）
+pub const SLOT_GONE_MARK: &str = "SLOT_GONE";
+
+/// 无 429 多久才 +1
+pub const AIMD_GROW_AFTER: Duration = Duration::from_secs(300);
+/// 撞 429 后的乘性下降因子
+pub const AIMD_DECREASE: f64 = 0.7;
+/// 用量统计窗口（封口判定）
+pub const HEAVY_WINDOW: Duration = Duration::from_secs(1800);
+/// 封口最低用量：量太小时不封（一个人连发几条就把槽封掉不合理）
+pub const HEAVY_MIN_USAGE: u64 = 20;
+
+/// 在途上限参数
+#[derive(Debug, Clone, Copy, PartialEq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct LimitParams {
+    pub start: u32,
+    pub min: u32,
+    pub max: u32,
+    pub auto_tune: bool,
+}
+
+impl LimitParams {
+    pub fn validate(&self) -> anyhow::Result<()> {
+        if self.min < 1 || self.min > self.max || self.max > 64 {
+            anyhow::bail!("在途上限需满足 1 ≤ 下限 ≤ 上限 ≤ 64");
+        }
+        if self.start < self.min || self.start > self.max {
+            anyhow::bail!("起始值需在下限和上限之间");
+        }
+        Ok(())
+    }
+}
+
+/// 一个槽位的运行时状态（不落盘，除 account_id 外）
+#[derive(Debug, Clone)]
+pub struct SlotState {
+    pub index: usize,
+    /// 槽位名（稳定键：绑定、号、统计都按名字跟着走，增删槽不串号）
+    pub name: String,
+    /// 当前占用这个槽的号
+    pub account_id: Option<u64>,
+    /// 当前在途上限（AIMD 调出来的）
+    pub limit: u32,
+    /// 手动锁定的上限（Some 时不参与自动调节）
+    pub locked_limit: Option<u32>,
+    /// 当前在途数
+    pub in_flight: u32,
+    /// 正在排队的数
+    pub queued: u32,
+    /// 最近一次 429 的时刻
+    pub last_429: Option<Instant>,
+    /// 最近一次上调的时刻
+    pub last_grow: Option<Instant>,
+    /// 上次检查后是否跑满过（in_flight 顶到 limit）
+    pub saturated_since_grow: bool,
+    /// 上游 retry-after 要求暂停到这个时刻
+    pub paused_until: Option<Instant>,
+    /// 创建 / 换号时刻（AIMD 静默期起点）
+    pub created_at: Instant,
+}
+
+impl SlotState {
+    pub fn new(index: usize, start: u32) -> Self {
+        Self {
+            index,
+            name: String::new(),
+            account_id: None,
+            limit: start,
+            locked_limit: None,
+            in_flight: 0,
+            queued: 0,
+            last_429: None,
+            last_grow: None,
+            saturated_since_grow: false,
+            paused_until: None,
+            created_at: Instant::now(),
+        }
+    }
+
+    pub fn effective_limit(&self) -> u32 {
+        self.locked_limit.unwrap_or(self.limit)
+    }
+
+    /// 是否还能放行一个请求
+    pub fn has_room(&self, now: Instant) -> bool {
+        if self.paused_until.is_some_and(|t| t > now) {
+            return false;
+        }
+        self.in_flight < self.effective_limit()
+    }
+
+    /// 撞 429：乘性下降；retry_after 有值则暂停
+    pub fn on_429(&mut self, p: &LimitParams, now: Instant, retry_after: Option<Duration>) {
+        self.last_429 = Some(now);
+        self.saturated_since_grow = false;
+        if p.auto_tune && self.locked_limit.is_none() {
+            let dec = ((self.limit as f64) * AIMD_DECREASE).floor() as u32;
+            self.limit = dec.max(p.min);
+        }
+        if let Some(ra) = retry_after {
+            let ra = ra.min(Duration::from_secs(300));
+            self.paused_until = Some(now + ra);
+        }
+    }
+
+    /// 周期调用：连续 AIMD_GROW_AFTER 无 429 且期间跑满过 ⇒ +1
+    pub fn maybe_grow(&mut self, p: &LimitParams, now: Instant) -> bool {
+        if !p.auto_tune || self.locked_limit.is_some() || self.limit >= p.max {
+            return false;
+        }
+        let quiet_since = match (self.last_429, self.last_grow) {
+            (Some(a), Some(b)) => a.max(b),
+            (Some(a), None) => a,
+            (None, Some(b)) => b,
+            (None, None) => self.created_at,
+        };
+        if now.duration_since(quiet_since) < AIMD_GROW_AFTER {
+            return false;
+        }
+        self.grow_if_saturated(now)
+    }
+
+    fn grow_if_saturated(&mut self, now: Instant) -> bool {
+        if !self.saturated_since_grow {
+            return false;
+        }
+        self.limit += 1;
+        self.last_grow = Some(now);
+        self.saturated_since_grow = false;
+        true
+    }
+}
+
+/// 落盘的绑定表：用户键 → 槽位下标；外加每槽当前号、已上过槽的号
+#[derive(Debug, Clone, Default, Serialize, Deserialize, PartialEq)]
+#[serde(rename_all = "camelCase")]
+pub struct SlotsFile {
+    /// 用户键 → 槽位名
+    #[serde(default)]
+    pub bindings: HashMap<String, String>,
+    /// 槽位名 → 当前号
+    #[serde(default)]
+    pub slot_accounts: HashMap<String, u64>,
+    /// 曾经上过槽的号（换号只挑不在这里的）
+    #[serde(default)]
+    pub ever_slotted: Vec<u64>,
+    /// 退役原因：号 id → 原因（quota / restricted）
+    #[serde(default)]
+    pub retired: HashMap<u64, String>,
+    /// 上槽前号自己的代理（url, user, pass）；离槽时还原
+    #[serde(default)]
+    pub original_proxy: HashMap<u64, (Option<String>, Option<String>, Option<String>)>,
+}
+
+/// 每槽最近 30 分钟用量（按请求数计；token 另记）
+#[derive(Debug, Default, Clone)]
+pub struct UsageWindow {
+    events: VecDeque<(Instant, u64)>,
+}
+
+impl UsageWindow {
+    pub fn add(&mut self, now: Instant, weight: u64) {
+        self.events.push_back((now, weight));
+        self.trim(now);
+    }
+
+    pub fn trim(&mut self, now: Instant) {
+        while let Some(&(t, _)) = self.events.front() {
+            if now.duration_since(t) > HEAVY_WINDOW {
+                self.events.pop_front();
+            } else {
+                break;
+            }
+        }
+    }
+
+    pub fn sum(&self) -> u64 {
+        self.events.iter().map(|(_, w)| *w).sum()
+    }
+}
+
+/// 哪些槽「封口」（不接新用户）：近 30 分钟用量 > 各槽平均 × ratio。
+/// 平均为 0（刚起步）时谁都不封。
+pub fn closed_slots(usage: &[u64], ratio: f64) -> Vec<bool> {
+    let n = usage.len().max(1) as f64;
+    let avg = usage.iter().sum::<u64>() as f64 / n;
+    usage
+        .iter()
+        .map(|&u| u >= HEAVY_MIN_USAGE && avg > 0.0 && (u as f64) > avg * ratio)
+        .collect()
+}
+
+
+/// 给新用户挑槽：在有号且没封口的槽里挑在途最少的（平局按用量，再按下标）。
+/// 全部封口则退回所有有号的槽。没有任何槽有号返回 None。
+pub fn choose_slot_for_new_user(states: &[SlotState], usage: &[u64], users: &[usize], ratio: f64) -> Option<usize> {
+    let closed = closed_slots(usage, ratio);
+    let pick = |allow_closed: bool| {
+        states
+            .iter()
+            .filter(|s| s.account_id.is_some())
+            .filter(|s| allow_closed || !closed.get(s.index).copied().unwrap_or(false))
+            .min_by_key(|s| {
+                (
+                    s.in_flight,
+                    users.get(s.index).copied().unwrap_or(0),
+                    usage.get(s.index).copied().unwrap_or(0),
+                    s.index,
+                )
+            })
+            .map(|s| s.index)
+    };
+    pick(false).or_else(|| pick(true))
+}
+
+/// 换号：从候选里挑第一个「没禁用、支持该模型、没被退役（额度用尽 / 被限制）、不在其他槽」的号（按 priority, id）。
+/// 第二个参数是要排除的号（调用方传「退役名单」）。
+/// candidates: (id, priority, disabled, supports_opus)
+pub fn pick_replacement(
+    candidates: &[(u64, u32, bool, bool)],
+    excluded: &[u64],
+    occupied: &[u64],
+    need_opus: bool,
+) -> Option<u64> {
+    let mut c: Vec<_> = candidates
+        .iter()
+        .filter(|(id, _, disabled, opus)| {
+            !disabled
+                && (!need_opus || *opus)
+                && !excluded.contains(id)
+                && !occupied.contains(id)
+        })
+        .collect();
+    c.sort_by_key(|(id, pri, _, _)| (*pri, *id));
+    c.first().map(|(id, _, _, _)| *id)
+}
+
+/// 槽位运行时（内存 + 落盘内容）
+#[derive(Debug)]
+pub struct SlotsRuntime {
+    pub states: Vec<SlotState>,
+    pub usage: Vec<UsageWindow>,
+    pub file: SlotsFile,
+    pub stats: Vec<SlotStats>,
+    /// 启动时发现：配置里已没有、但文件里还挂着号的槽 ⇒ 这些号要放回冷备
+    pub offline_released: Vec<u64>,
+}
+
+/// 每槽计数（累计，落盘到 SlotsFile 之外的 stats，重启清零可接受；24h 由 UsageWindow 另算）
+#[derive(Debug, Default, Clone, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct SlotStats {
+    pub sent: u64,
+    pub first_429: u64,
+    pub retry_429: u64,
+    pub exhausted: u64,
+    pub restricted: u64,
+    pub queue_timeouts: u64,
+    pub tokens: u64,
+    /// 上游 200 但零文本零工具（静默空回复）的次数
+    #[serde(default)]
+    pub empty: u64,
+    /// 其中最终原样返回给用户的次数（没救回来）
+    #[serde(default)]
+    pub empty_returned: u64,
+}
+
+impl SlotsRuntime {
+    /// names = 当前配置的槽位名（顺序即展示顺序）。号/绑定从 file 按名字恢复。
+    pub fn new(names: &[String], start: u32, file: SlotsFile) -> Self {
+        let mut rt = Self { states: Vec::new(), usage: Vec::new(), file, stats: Vec::new(), offline_released: Vec::new() };
+        for (i, name) in names.iter().enumerate() {
+            let mut st = SlotState::new(i, start);
+            st.name = name.clone();
+            st.account_id = rt.file.slot_accounts.get(name).copied();
+            rt.states.push(st);
+            rt.usage.push(UsageWindow::default());
+            rt.stats.push(SlotStats::default());
+        }
+        // 停机期间被删掉的槽：它们的号记下来，调用方清代理、放回冷备
+        rt.offline_released = rt
+            .file
+            .slot_accounts
+            .iter()
+            .filter(|(n, _)| !names.contains(n))
+            .map(|(_, id)| *id)
+            .collect();
+        rt.file.ever_slotted.retain(|id| !rt.offline_released.contains(id));
+        rt.file.bindings.retain(|_, n| names.contains(n));
+        rt.sync_file_accounts();
+        rt
+    }
+
+    /// 动态增删槽：按名字对齐。保留的槽状态/统计不动；新槽为空；
+    /// 返回被删掉的槽上的号（调用方负责清代理、放回冷备）
+    pub fn reconcile(&mut self, names: &[String], start: u32) -> Vec<u64> {
+        let mut old: HashMap<String, (SlotState, UsageWindow, SlotStats)> = HashMap::new();
+        for ((st, u), s) in self.states.drain(..).zip(self.usage.drain(..)).zip(self.stats.drain(..)) {
+            old.insert(st.name.clone(), (st, u, s));
+        }
+        for (i, name) in names.iter().enumerate() {
+            let (mut st, u, s) = old.remove(name).unwrap_or_else(|| {
+                let mut st = SlotState::new(i, start);
+                st.name = name.clone();
+                st.account_id = self.file.slot_accounts.get(name).copied();
+                (st, UsageWindow::default(), SlotStats::default())
+            });
+            st.index = i;
+            self.states.push(st);
+            self.usage.push(u);
+            self.stats.push(s);
+        }
+        let removed: Vec<u64> = old.into_values().filter_map(|(st, _, _)| st.account_id).collect();
+        self.file.bindings.retain(|_, n| names.contains(n));
+        self.file.ever_slotted.retain(|id| !removed.contains(id));
+        self.sync_file_accounts();
+        removed
+    }
+
+    pub fn usage_sums(&mut self, now: Instant) -> Vec<u64> {
+        self.usage.iter_mut().map(|w| { w.trim(now); w.sum() }).collect()
+    }
+
+    /// 每槽绑定人数（按当前槽顺序）
+    pub fn user_counts(&self) -> Vec<usize> {
+        let mut c = vec![0usize; self.states.len()];
+        for n in self.file.bindings.values() {
+            if let Some(i) = self.states.iter().position(|s| &s.name == n) {
+                c[i] += 1;
+            }
+        }
+        c
+    }
+
+    /// 用户键 → 槽位下标；新用户按规则分配并按名字记下。返回 (下标, 是否新绑定)
+    pub fn slot_for_user(&mut self, user: &str, ratio: f64, now: Instant) -> Option<(usize, bool)> {
+        if let Some(name) = self.file.bindings.get(user) {
+            if let Some(i) = self.states.iter().position(|s| &s.name == name && s.account_id.is_some()) {
+                return Some((i, false));
+            }
+        }
+        let usage = self.usage_sums(now);
+        let users = self.user_counts();
+        let i = choose_slot_for_new_user(&self.states, &usage, &users, ratio)?;
+        self.file.bindings.insert(user.to_string(), self.states[i].name.clone());
+        Some((i, true))
+    }
+
+    /// 没有用户身份的请求（会话键 / MCP）选槽：不写绑定表，按「会话键 × 槽名」做 rendezvous 哈希，
+    /// 同一会话稳定落同一个槽（保住 prompt cache）；某个槽没了只有落在它上面的会话会挪走
+    pub fn pick_ephemeral(&self, key: &str) -> Option<usize> {
+        use std::hash::{Hash, Hasher};
+        self.states
+            .iter()
+            .filter(|s| s.account_id.is_some())
+            .max_by_key(|s| {
+                let mut h = std::collections::hash_map::DefaultHasher::new();
+                key.hash(&mut h);
+                s.name.hash(&mut h);
+                h.finish()
+            })
+            .map(|s| s.index)
+    }
+
+    /// 把槽 i 的号换成 new_id；旧号记退役原因；绑定（按名字）不动
+    pub fn swap_account(&mut self, i: usize, new_id: u64, retired_reason: &str, start: u32) {
+        // 只有「额度用尽 / 被限制」才算退役（以后不再上槽）；补号 / 删号 / 停号换下来的不算
+        if let Some(old) = self.states[i].account_id {
+            if matches!(retired_reason, "quota" | "restricted") {
+                self.file.retired.insert(old, retired_reason.to_string());
+            }
+        }
+        let (idx, name) = (self.states[i].index, self.states[i].name.clone());
+        self.states[i] = SlotState::new(idx, start);
+        self.states[i].name = name;
+        self.states[i].account_id = Some(new_id);
+        if !self.file.ever_slotted.contains(&new_id) {
+            self.file.ever_slotted.push(new_id);
+        }
+        self.sync_file_accounts();
+    }
+
+    pub fn sync_file_accounts(&mut self) {
+        self.file.slot_accounts = self
+            .states
+            .iter()
+            .filter_map(|s| s.account_id.map(|id| (s.name.clone(), id)))
+            .collect();
+    }
+
+    pub fn slot_of_account(&self, id: u64) -> Option<usize> {
+        self.states.iter().position(|s| s.account_id == Some(id))
+    }
+
+    pub fn occupied(&self) -> Vec<u64> {
+        self.states.iter().filter_map(|s| s.account_id).collect()
+    }
+}
+
+/// 余额历史：每次轮询记一笔「池子总剩余」，估算每小时消耗与还能撑多久
+#[derive(Debug, Default, Clone, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct BalanceHistory {
+    /// (unix 秒, 总剩余积分)
+    #[serde(default)]
+    pub points: Vec<(i64, f64)>,
+    /// (unix 秒, 与上一次轮询相比的实际消耗)：只算两次都在池里的同一个号的下降，
+    /// 号进出池（退役 / 禁用 / 删除 / 新增）和月初重置都不算消耗
+    #[serde(default)]
+    pub burns: Vec<(i64, f64)>,
+    /// 上一次轮询每个号的剩余（算 burns 用）
+    #[serde(default)]
+    pub last: HashMap<u64, f64>,
+}
+
+#[derive(Debug, Clone, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct Runway {
+    pub total_remaining: f64,
+    pub total_limit: f64,
+    /// 每小时消耗（积分）；None = 数据不够
+    pub burn_per_hour: Option<f64>,
+    /// 还能撑多少小时；None = 数据不够或几乎没消耗
+    pub hours_left: Option<f64>,
+    /// 撑不到 24 小时
+    pub alert: bool,
+    /// 用于估算的时间跨度（分钟）
+    pub window_minutes: i64,
+}
+
+pub const RUNWAY_ALERT_HOURS: f64 = 24.0;
+pub const BALANCE_HISTORY_SECS: i64 = 24 * 3600;
+
+impl BalanceHistory {
+    pub fn record(&mut self, now: i64, total_remaining: f64) {
+        self.points.push((now, total_remaining));
+        self.points.retain(|(t, _)| now - *t <= BALANCE_HISTORY_SECS);
+    }
+
+    /// 记一次轮询：per = 本次每个号的剩余
+    pub fn record_accounts(&mut self, now: i64, per: &HashMap<u64, f64>) {
+        let total: f64 = per.values().sum();
+        if !self.last.is_empty() {
+            let burn: f64 = per
+                .iter()
+                .filter_map(|(id, r)| self.last.get(id).map(|prev| (prev - r).max(0.0)))
+                .sum();
+            self.burns.push((now, burn));
+            self.burns.retain(|(t, _)| now - *t <= BALANCE_HISTORY_SECS);
+        }
+        self.last = per.clone();
+        self.record(now, total);
+    }
+
+    /// 只累加相邻两点之间的下降（加号 / 换号 / 月初重置会让总额上跳，上跳不算消耗）
+    pub fn runway(&self, total_remaining: f64, total_limit: f64) -> Runway {
+        // 有逐号消耗记录就用它（不受号进出池影响）；老数据没有时退回按总额下降估
+        let burned: f64 = if !self.burns.is_empty() {
+            self.burns.iter().map(|(_, b)| b).sum()
+        } else {
+            self.points.windows(2).map(|w| (w[0].1 - w[1].1).max(0.0)).sum()
+        };
+        let span = match (self.points.first(), self.points.last()) {
+            (Some(a), Some(b)) => b.0 - a.0,
+            _ => 0,
+        };
+        let enough = span >= 1800 && self.points.len() >= 3;
+        let burn = if enough { Some(burned / (span as f64 / 3600.0)) } else { None };
+        let hours = burn.and_then(|b| if b > 0.01 { Some(total_remaining / b) } else { None });
+        Runway {
+            total_remaining,
+            total_limit,
+            burn_per_hour: burn,
+            hours_left: hours,
+            alert: hours.is_some_and(|h| h < RUNWAY_ALERT_HOURS),
+            window_minutes: span / 60,
+        }
+    }
+}
