+/// Claude Code 的 WebSearch 子请求前缀（只带一个 web_search 工具，要的就是原始结果列表）
+pub const CLAUDE_CODE_SEARCH_PREFIX: &str = "Perform a web search for the query: ";
+
+/// 交给模型的搜索工具名（服务端搜索工具被改写成这个名字的普通函数工具）
+pub const WEB_SEARCH_TOOL_NAME: &str = "web_search";
+
+pub const WEB_SEARCH_TOOL_DESCRIPTION: &str = "Search the web for up-to-date information. \
+Use it for recent events, news, prices, releases, or anything that may have changed after your training data. \
+Returns a list of results with title, URL, publish date and snippet. \
+You may call it several times with different queries; cite the URLs you rely on.";
+
+/// web_search 函数工具的入参 schema
+pub fn web_search_input_schema() -> serde_json::Value {
+    json!({
+        "type": "object",
+        "properties": {
+            "query": {"type": "string", "description": "The search query"}
+        },
+        "required": ["query"],
+        "additionalProperties": false
+    })
+}
+
+/// 是否是 Anthropic 服务端搜索工具（`web_search_20250305` 等，没有 input_schema，由服务端执行）
+pub fn is_server_web_search_tool(t: &super::types::Tool) -> bool {
+    t.tool_type
+        .as_deref()
+        .is_some_and(|ty| ty.starts_with("web_search"))
+        || (t.name == WEB_SEARCH_TOOL_NAME && t.input_schema.is_empty())
+}
+
+/// 请求里是否带服务端搜索工具（不论还有没有别的工具）
+pub fn has_server_web_search(req: &MessagesRequest) -> bool {
+    req.tools
+        .as_ref()
+        .is_some_and(|tools| tools.iter().any(is_server_web_search_tool))
+}
+
+/// Claude Code 的 WebSearch 子请求：只有一个搜索工具，且首条消息带固定前缀。
+/// 这类请求保持老路径（直接返回原始结果列表），其余带搜索工具的请求走 search_loop。
+pub fn is_claude_code_search_subrequest(req: &MessagesRequest) -> bool {
+    if !has_web_search_tool(req) {
+        return false;
+    }
+    let Some(first) = req.messages.first() else {
+        return false;
+    };
+    let text = match &first.content {
+        serde_json::Value::String(s) => s.as_str(),
+        serde_json::Value::Array(arr) => arr
+            .first()
+            .and_then(|b| b.get("text"))
+            .and_then(|t| t.as_str())
+            .unwrap_or(""),
+        _ => "",
+    };
+    text.starts_with(CLAUDE_CODE_SEARCH_PREFIX)
+}
+
+/// 服务端搜索工具上声明的 max_uses（没有就返回 None）
+pub fn server_web_search_max_uses(req: &MessagesRequest) -> Option<i32> {
+    req.tools
+        .as_ref()?
+        .iter()
+        .find(|t| is_server_web_search_tool(t))
+        .and_then(|t| t.max_uses)
+}
+
+/// 生成一对 Anthropic 原生块：server_tool_use + web_search_tool_result
+pub fn build_server_blocks(
+    tool_use_id: &str,
+    query: &str,
+    results: &Option<WebSearchResults>,
+) -> (serde_json::Value, serde_json::Value) {
+    let server_tool_use = json!({
+        "type": "server_tool_use",
+        "id": tool_use_id,
+        "name": WEB_SEARCH_TOOL_NAME,
+        "input": {"query": query}
+    });
+    let content = match results {
+        Some(r) => serde_json::Value::Array(
+            r.results
+                .iter()
+                .map(|r| {
+                    let page_age = r.published_date.and_then(|ms| {
+                        chrono::DateTime::from_timestamp_millis(ms)
+                            .map(|dt| dt.format("%B %-d, %Y").to_string())
+                    });
+                    json!({
+                        "type": "web_search_result",
+                        "title": r.title,
+                        "url": r.url,
+                        "encrypted_content": r.snippet.clone().unwrap_or_default(),
+                        "page_age": page_age
+                    })
+                })
+                .collect(),
+        ),
+        None => json!({"type": "web_search_tool_result_error", "error_code": "unavailable"}),
+    };
+    let result = json!({
+        "type": "web_search_tool_result",
+        "tool_use_id": tool_use_id,
+        "content": content
+    });
+    (server_tool_use, result)
+}
