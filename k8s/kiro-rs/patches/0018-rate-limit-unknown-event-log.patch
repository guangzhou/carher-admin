+/// 未知事件类型的进程级计数（只用于限流日志）
+static UNKNOWN_EVENT_COUNTS: std::sync::LazyLock<parking_lot::Mutex<std::collections::HashMap<String, u64>>> =
+    std::sync::LazyLock::new(|| parking_lot::Mutex::new(std::collections::HashMap::new()));
+
+/// 同一种未知事件类型每这么多次才再记一行
+pub(crate) const UNKNOWN_EVENT_LOG_EVERY: u64 = 10_000;
+
+/// 计一次，返回该类型累计次数（从 1 开始）。类型名截到 64 字符、最多记 64 种，防止上游乱发撑爆内存。
+fn note_unknown_event(event_type: &str) -> u64 {
+    let key: String = event_type.chars().take(64).collect();
+    let mut m = UNKNOWN_EVENT_COUNTS.lock();
+    if !m.contains_key(&key) && m.len() >= 64 {
+        return 0; // 种类超上限：不再新增，也不打日志
+    }
+    let c = m.entry(key).or_insert(0);
+    *c += 1;
+    *c
+}
