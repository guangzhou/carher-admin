diff --git a/tests/test_publish_merge_timeout.py b/tests/test_publish_merge_timeout.py
new file mode 100644
index 0000000..998fc44
--- /dev/null
+++ b/tests/test_publish_merge_timeout.py
@@ -0,0 +1,70 @@
+import asyncio
+
+from backend.usage_store import UsageStore
+
+
+def _run_publish(monkeypatch, env_value=None):
+    if env_value is not None:
+        monkeypatch.setenv("USAGE_PUBLISH_MERGE_TIMEOUT_SECONDS", env_value)
+    else:
+        monkeypatch.delenv("USAGE_PUBLISH_MERGE_TIMEOUT_SECONDS", raising=False)
+    merges: list[object] = []
+
+    class Transaction:
+        async def __aenter__(self):
+            return None
+
+        async def __aexit__(self, *_args):
+            return None
+
+    class Connection:
+        def transaction(self):
+            return Transaction()
+
+        async def execute(self, query, *_args, timeout=None):
+            if "SELECT * FROM usage_" in query and "_stage_" in query:
+                merges.append(timeout)
+
+        async def copy_records_to_table(self, *_args, **_kwargs):
+            return None
+
+        async def fetchval(self, *_args):
+            return "2026-10-28 08:00:00+00"
+
+    class Acquire:
+        async def __aenter__(self):
+            return Connection()
+
+        async def __aexit__(self, *_args):
+            return None
+
+    class Pool:
+        def acquire(self):
+            return Acquire()
+
+    snapshot = type(
+        "Snapshot",
+        (),
+        {
+            "backend_id": "primary",
+            "rows": [{"date": "2026-10-28", "userId": "user-1", "source": "Codex", "model": "m", "totalTokens": 1}],
+            "memberships": [],
+            "events": None,
+            "departments": [],
+        },
+    )()
+    store = UsageStore("postgresql://unused")
+    store.pool = Pool()
+    asyncio.run(store.publish_snapshots("2026-10-28", "2026-10-28", [snapshot]))
+    return merges
+
+
+def test_stage_merges_use_long_timeout_not_pool_default(monkeypatch) -> None:
+    merges = _run_publish(monkeypatch)
+    assert merges
+    assert all(timeout == 600 for timeout in merges)
+
+
+def test_stage_merge_timeout_env_override_has_floor(monkeypatch) -> None:
+    assert set(_run_publish(monkeypatch, "900")) == {900}
+    assert set(_run_publish(monkeypatch, "5")) == {30}
