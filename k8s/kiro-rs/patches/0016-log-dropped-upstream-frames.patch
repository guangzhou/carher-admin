+    use crate::kiro::parser::header::{HeaderValue, Headers};
+    use std::sync::{Arc, Mutex};
+
+    fn frame(message_type: Option<&str>, event_type: Option<&str>, payload: &[u8]) -> Frame {
+        let mut headers = Headers::new();
+        if let Some(m) = message_type {
+            headers.insert(":message-type".into(), HeaderValue::String(m.into()));
+        }
+        if let Some(e) = event_type {
+            headers.insert(":event-type".into(), HeaderValue::String(e.into()));
+        }
+        Frame { headers, payload: payload.to_vec() }
+    }
+
+    /// 把 tracing 输出收进内存，断言真的打了日志（不是只看返回值）
+    #[derive(Clone, Default)]
+    struct Cap(Arc<Mutex<Vec<u8>>>);
+    impl std::io::Write for Cap {
+        fn write(&mut self, b: &[u8]) -> std::io::Result<usize> {
+            self.0.lock().unwrap().extend_from_slice(b);
+            Ok(b.len())
+        }
+        fn flush(&mut self) -> std::io::Result<()> {
+            Ok(())
+        }
+    }
+    fn capture<R>(f: impl FnOnce() -> R) -> (R, String) {
+        let cap = Cap::default();
+        let w = cap.clone();
+        let sub = tracing_subscriber::fmt()
+            .with_writer(move || w.clone())
+            .with_ansi(false)
+            .with_max_level(tracing::Level::TRACE)
+            .finish();
+        let r = tracing::subscriber::with_default(sub, f);
+        let out = String::from_utf8(cap.0.lock().unwrap().clone()).unwrap();
+        (r, out)
+    }
