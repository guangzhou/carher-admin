+import { useEffect, useState } from 'react'
+import { toast } from 'sonner'
+import { Button } from '@/components/ui/button'
+import { Input } from '@/components/ui/input'
+import { Switch } from '@/components/ui/switch'
+import { Badge } from '@/components/ui/badge'
+import { useSetSlotConfigs, useSlotConfigs } from '@/hooks/use-credentials'
+import type { SlotConfig } from '@/api/credentials'
+import { extractErrorMessage } from '@/lib/utils'
+
+// 槽位配置：表格逐行编辑。停用 = 配置全保留（出口/账号/密码），号回冷备、不接流量；再打开即恢复。
+// 删除只对「已停用」的行开放并二次确认，避免误删后要重配出口。
+const same = (a?: SlotConfig, b?: SlotConfig) => JSON.stringify(a) === JSON.stringify(b)
+
+export function SlotConfigEditor() {
+  const { data } = useSlotConfigs()
+  const { mutate, isPending } = useSetSlotConfigs()
+  const [rows, setRows] = useState<SlotConfig[]>([])
+  useEffect(() => { if (data) setRows(data) }, [data])
+
+  const set = (i: number, patch: Partial<SlotConfig>) =>
+    setRows((r) => r.map((x, j) => (j === i ? { ...x, ...patch } : x)))
+  const add = () => setRows((r) => [...r, { name: '', proxyUrl: null, proxyUsername: null, proxyPassword: null, enabled: true }])
+  const remove = (i: number) => {
+    const n = rows[i].name || '（未命名）'
+    if (!window.confirm(`彻底删除槽位「${n}」的配置（出口、账号、密码）？删除后要重新填写。`)) return
+    setRows((r) => r.filter((_, j) => j !== i))
+  }
+
+  const names = rows.map((r) => r.name.trim())
+  const active = rows.filter((r) => r.enabled).length
+  const error = names.some((n) => !n) ? '槽位名不能为空'
+    : new Set(names).size !== names.length ? '槽位名不能重复'
+      : active > 20 ? '同时生效最多 20 个' : null
+  const dirty = !data || data.length !== rows.length || rows.some((r, i) => !same(r, data[i]))
+
+  const save = () => {
+    if (error) return
+    const was = new Map((data || []).map((o) => [o.name, o.enabled]))
+    const off = rows.filter((r) => !r.enabled && was.get(r.name) !== false).map((r) => r.name)
+    if (off.length && !window.confirm(`将停用：${off.join('、')}。这些槽上的号回冷备，绑定的用户下次请求换到其他槽。配置保留，可随时再打开。确认？`)) return
+    mutate(rows.map((r) => ({ ...r, name: r.name.trim() })), {
+      onSuccess: () => toast.success('已保存，立即生效'),
+      onError: (e) => toast.error(`保存失败: ${extractErrorMessage(e)}`),
+    })
+  }
+
+  const cell = (i: number, k: 'name' | 'proxyUrl' | 'proxyUsername' | 'proxyPassword', ph: string, type = 'text') => (
+    <Input
+      className='h-8'
+      type={type}
+      placeholder={ph}
+      aria-label={ph}
+      value={(rows[i][k] as string) || ''}
+      onChange={(e) => set(i, { [k]: e.target.value || null } as Partial<SlotConfig>)}
+    />
+  )
+
+  return (
+    <div className='space-y-2'>
+      <div className='flex flex-wrap items-baseline justify-between gap-2'>
+        <div className='text-sm font-medium'>
+          槽位配置 <span className='ml-1 font-normal text-muted-foreground'>生效 {active} / 共 {rows.length}</span>
+        </div>
+        <span className='text-xs text-muted-foreground'>出口留空 = 走本机出口 · 关掉开关 = 停用（配置保留）</span>
+      </div>
+      <div className='overflow-x-auto rounded-md border'>
+        <table className='w-full text-sm'>
+          <thead className='bg-muted/50 text-xs text-muted-foreground'>
+            <tr>
+              <th className='w-20 px-3 py-2 text-left font-medium'>生效</th>
+              <th className='px-3 py-2 text-left font-medium'>槽位名</th>
+              <th className='px-3 py-2 text-left font-medium'>出口代理</th>
+              <th className='px-3 py-2 text-left font-medium'>用户名</th>
+              <th className='px-3 py-2 text-left font-medium'>密码</th>
+              <th className='w-16 px-3 py-2'></th>
+            </tr>
+          </thead>
+          <tbody>
+            {rows.map((r, i) => (
+              <tr key={i} className={`border-t ${r.enabled ? '' : 'bg-muted/40 text-muted-foreground'}`}>
+                <td className='px-3 py-2'>
+                  <div className='flex items-center gap-2'>
+                    <Switch checked={r.enabled} onCheckedChange={(v) => set(i, { enabled: v })} aria-label={`${r.name} 生效`} />
+                    {!r.enabled && <Badge variant='secondary'>停用</Badge>}
+                  </div>
+                </td>
+                <td className='min-w-36 px-3 py-2'>{cell(i, 'name', '槽位名')}</td>
+                <td className='min-w-56 px-3 py-2'>{cell(i, 'proxyUrl', 'http://IP:端口')}</td>
+                <td className='min-w-28 px-3 py-2'>{cell(i, 'proxyUsername', '用户名')}</td>
+                <td className='min-w-28 px-3 py-2'>{cell(i, 'proxyPassword', '密码', 'password')}</td>
+                <td className='px-3 py-2 text-right'>
+                  {!r.enabled && (
+                    <Button size='sm' variant='ghost' className='text-red-600' onClick={() => remove(i)}>删除</Button>
+                  )}
+                </td>
+              </tr>
+            ))}
+            {rows.length === 0 && (
+              <tr><td colSpan={6} className='px-3 py-6 text-center text-muted-foreground'>还没有槽位</td></tr>
+            )}
+          </tbody>
+        </table>
+      </div>
+      <div className='flex flex-wrap items-center gap-2'>
+        <Button size='sm' variant='outline' onClick={add}>+ 加一个槽位</Button>
+        <Button size='sm' onClick={save} disabled={!!error || isPending || !dirty}>{isPending ? '保存中…' : '保存并生效'}</Button>
+        {dirty && !error && <span className='text-xs text-amber-600'>有未保存的修改</span>}
+        {error && <span className='text-sm text-red-500'>{error}</span>}
+      </div>
+    </div>
+  )
+}
