+/// 别名在 slotUnboundKeyAliases 里的共享 key、或没带头 ⇒ 用原会话键
+fn user_session_key(headers: &HeaderMap, state: &AppState, fallback: Option<String>) -> Option<String> {
+    // 非槽位模式：会话键完全保持原样（window 照旧按会话粘号，不因带了 key 头而改变）
+    if !state.kiro_provider.as_ref().is_some_and(|p| p.is_slots_mode()) {
+        return fallback;
+    }
+    let hash = headers
+        .get("x-litellm-user_api_key_hash")
+        .and_then(|v| v.to_str().ok())
+        .map(str::trim)
+        .filter(|v| !v.is_empty());
+    let ng = |fb: Option<String>| {
+        fb.map(|k| format!("{}{}", crate::kiro::slots::NOT_IN_GRAY, k))
+            .or(Some(crate::kiro::slots::NOT_IN_GRAY.to_string()))
+    };
+    let gray_active = state.kiro_provider.as_ref().is_some_and(|p| p.slot_gray_active());
+    // 没身份头：有 kiro.rs 自带灰度名单时不进槽位（名单是按 key 圈人的）；没名单时按会话哈希进槽
+    let Some(hash) = hash else { return if gray_active { ng(fallback) } else { fallback } };
+    let alias = headers
+        .get("x-litellm-user_api_key_alias")
+        .and_then(|v| v.to_str().ok())
+        .unwrap_or("");
+    let Some(p) = state.kiro_provider.as_ref() else { return fallback };
+    // 灰度名单非空且没命中 ⇒ 不进槽位，照旧
+    if !p.slot_gray_allows(alias) {
+        return ng(fallback);
+    }
+    if p.unbound_alias(alias) {
+        return fallback;
+    }
+    Some(format!("u:{}", hash))
 }
