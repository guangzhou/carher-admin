+package openai
+
+import (
+	"encoding/base64"
+	"strings"
+	"testing"
+
+	"gemini-web-to-api/internal/modules/providers"
+)
+
+func TestChatImageURLKeepsOriginalWithoutPublicBase(t *testing.T) {
+	t.Setenv("GEMINI_MEDIA_PUBLIC_BASE", "")
+	img := providers.Image{URL: "https://lh3.googleusercontent.com/gg-dl/x", B64JSON: "QUJD"}
+	if got := chatImageURL(img); got != img.URL {
+		t.Fatalf("got %q", got)
+	}
+}
+
+func TestChatImageURLFallsBackWhenDownloadFailed(t *testing.T) {
+	t.Setenv("GEMINI_MEDIA_PUBLIC_BASE", "http://gw:1")
+	img := providers.Image{URL: "https://lh3.googleusercontent.com/gg-dl/x"}
+	if got := chatImageURL(img); got != img.URL {
+		t.Fatalf("got %q", got)
+	}
+}
+
+func TestChatImageURLServesOwnCopy(t *testing.T) {
+	t.Setenv("GEMINI_MEDIA_PUBLIC_BASE", "http://gw:1/")
+	jpeg := []byte{0xff, 0xd8, 0xff, 0xe0, 1, 2, 3}
+	img := providers.Image{URL: "https://lh3.googleusercontent.com/gg-dl/x",
+		B64JSON: base64.StdEncoding.EncodeToString(jpeg)}
+	got := chatImageURL(img)
+	prefix := "http://gw:1/openai/v1/media/"
+	if !strings.HasPrefix(got, prefix) {
+		t.Fatalf("got %q", got)
+	}
+	id := strings.TrimPrefix(got, prefix)
+	if !validMediaID(id) {
+		t.Fatalf("bad id %q", id)
+	}
+	it, ok := chatMedia.get(id)
+	if !ok || it.mime != "image/jpeg" || string(it.data) != string(jpeg) {
+		t.Fatalf("stored %+v ok=%v", it, ok)
+	}
+}
+
+func TestValidMediaIDRejectsTraversal(t *testing.T) {
+	for _, id := range []string{"", "../etc/passwd", strings.Repeat("z", 32), strings.Repeat("a", 31)} {
+		if validMediaID(id) {
+			t.Fatalf("accepted %q", id)
+		}
+	}
+}
+
+func TestMediaStoreEvictsOverBudget(t *testing.T) {
+	s := &mediaStore{items: map[string]*mediaItem{}}
+	big := base64.StdEncoding.EncodeToString(make([]byte, mediaMaxBytes/2+1))
+	a, _ := s.put(big, "image/png")
+	b, _ := s.put(big, "image/png")
+	if _, ok := s.get(a); ok {
+		t.Fatal("oldest item should be evicted")
+	}
+	if _, ok := s.get(b); !ok {
+		t.Fatal("newest item should stay")
+	}
+}
