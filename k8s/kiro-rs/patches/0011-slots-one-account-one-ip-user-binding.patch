+import { useState } from 'react'
+import { useQuery } from '@tanstack/react-query'
+import { Dialog, DialogContent, DialogDescription, DialogHeader, DialogTitle } from '@/components/ui/dialog'
+import { getCredentialUsage } from '@/api/credentials'
+import { extractErrorMessage } from '@/lib/utils'
+
+// 某个 kiro 账户的用量：按模型列 请求数 / 成功 / 失败 / 输入 token / 输出 token，可切「今天 / 最近 7 天」
+const fmt = (n: number) => n.toLocaleString('zh-CN')
+const short = (n: number) => (n >= 1e6 ? `${(n / 1e6).toFixed(2)}M` : n >= 1e3 ? `${(n / 1e3).toFixed(1)}K` : String(n))
+
+export function UsageDialog({ credentialId, email, open, onOpenChange }: {
+  credentialId: number | null
+  email?: string | null
+  open: boolean
+  onOpenChange: (o: boolean) => void
+}) {
+  const [days, setDays] = useState<1 | 7>(1)
+  const { data, isLoading, error } = useQuery({
+    queryKey: ['credentialUsage', credentialId, days],
+    queryFn: () => getCredentialUsage(credentialId as number, days),
+    enabled: open && credentialId != null,
+    refetchInterval: open ? 10000 : false,
+  })
+  const rows = data?.models || []
+  const sum = rows.reduce(
+    (a, r) => ({
+      requests: a.requests + r.requests, success: a.success + r.success, failed: a.failed + r.failed,
+      inputTokens: a.inputTokens + r.inputTokens, outputTokens: a.outputTokens + r.outputTokens,
+    }),
+    { requests: 0, success: 0, failed: 0, inputTokens: 0, outputTokens: 0 },
+  )
+  const TH = 'px-3 py-2 text-right font-medium whitespace-nowrap'
+  const TD = 'px-3 py-2 text-right tabular-nums whitespace-nowrap'
+  return (
+    <Dialog open={open} onOpenChange={onOpenChange}>
+      <DialogContent className='sm:max-w-3xl'>
+        <DialogHeader>
+          <DialogTitle>用量统计 · #{credentialId}</DialogTitle>
+          <DialogDescription>{email || ''}　按北京时间统计，10 秒自动刷新</DialogDescription>
+        </DialogHeader>
+        <div role='tablist' className='flex gap-1 border-b'>
+          {([1, 7] as const).map((d) => (
+            <button key={d} role='tab' aria-selected={days === d} onClick={() => setDays(d)}
+              className={`-mb-px border-b-2 px-3 py-2 text-sm ${days === d ? 'border-primary font-medium' : 'border-transparent text-muted-foreground hover:text-foreground'}`}>
+              {d === 1 ? '今天' : '最近 7 天'}
+            </button>
+          ))}
+        </div>
+        {isLoading && <p className='py-6 text-center text-sm text-muted-foreground'>加载中…</p>}
+        {error && <p className='py-6 text-center text-sm text-red-600'>加载失败：{extractErrorMessage(error)}</p>}
+        {!isLoading && !error && (
+          rows.length === 0 ? (
+            <p className='py-6 text-center text-sm text-muted-foreground'>这段时间这个账户没有请求</p>
+          ) : (
+            <div className='overflow-x-auto rounded-md border'>
+              <table className='w-full text-sm'>
+                <thead className='bg-muted/50 text-xs text-muted-foreground'>
+                  <tr>
+                    <th className='px-3 py-2 text-left font-medium'>模型</th>
+                    <th className={TH}>请求</th><th className={TH}>成功</th><th className={TH}>失败</th>
+                    <th className={TH}>输入 token</th><th className={TH}>输出 token</th>
+                  </tr>
+                </thead>
+                <tbody>
+                  {rows.map((r) => (
+                    <tr key={r.model} className='border-t'>
+                      <td className='px-3 py-2 font-mono text-xs'>{r.model}</td>
+                      <td className={TD}>{fmt(r.requests)}</td>
+                      <td className={TD}>{fmt(r.success)}</td>
+                      <td className={`${TD} ${r.failed ? 'font-semibold text-red-600' : 'text-muted-foreground'}`}>{fmt(r.failed)}</td>
+                      <td className={TD} title={fmt(r.inputTokens)}>{short(r.inputTokens)}</td>
+                      <td className={TD} title={fmt(r.outputTokens)}>{short(r.outputTokens)}</td>
+                    </tr>
+                  ))}
+                  <tr className='border-t bg-muted/30 font-medium'>
+                    <td className='px-3 py-2'>合计</td>
+                    <td className={TD}>{fmt(sum.requests)}</td>
+                    <td className={TD}>{fmt(sum.success)}</td>
+                    <td className={TD}>{fmt(sum.failed)}</td>
+                    <td className={TD} title={fmt(sum.inputTokens)}>{short(sum.inputTokens)}</td>
+                    <td className={TD} title={fmt(sum.outputTokens)}>{short(sum.outputTokens)}</td>
+                  </tr>
+                </tbody>
+              </table>
+            </div>
+          )
+        )}
+        <p className='text-xs text-muted-foreground'>
+          输入 token 来自上游返回的上下文用量；输出 token 按回复文本和工具参数估算，和 LiteLLM 账单可能有约 1% 出入。
+        </p>
+      </DialogContent>
+    </Dialog>
+  )
+}
