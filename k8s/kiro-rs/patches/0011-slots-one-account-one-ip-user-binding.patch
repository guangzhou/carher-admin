+}
+
+/// PUT /api/admin/slots/limits —— 改在途上限（起始/下限/上限/自动调节），立即生效并写回 config.json
+pub async fn set_slot_limits(
+    State(state): State<AdminState>,
+    Json(payload): Json<crate::kiro::slots::LimitParams>,
+) -> impl IntoResponse {
+    match state.service.set_slot_limits(payload) {
+        Ok(r) => Json(r).into_response(),
