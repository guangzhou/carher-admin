+        let jitter = (capped as f64 * 0.2) as u64;
+        let lo = capped.saturating_sub(jitter);
+        let hi = capped.saturating_add(jitter).min(20_000);
+        Duration::from_millis(fastrand::u64(lo..=hi.max(lo)))
+    }
