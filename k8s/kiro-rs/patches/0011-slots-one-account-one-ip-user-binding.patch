+        </DropdownMenuItem>
+        <DropdownMenuItem disabled={c.failureCount === 0 && c.refreshFailureCount === 0} onSelect={() => done(reset.mutateAsync(c.id))}>
+          <RotateCcw className="h-4 w-4" />清零失败次数
+        </DropdownMenuItem>
+        <DropdownMenuSeparator />
+        <DropdownMenuItem danger disabled={!c.disabled} onSelect={onDelete} title={!c.disabled ? '先禁用才能删除' : undefined}>
+          <Trash2 className="h-4 w-4" />删除{!c.disabled && '（先禁用）'}
+        </DropdownMenuItem>
+      </DropdownMenuContent>
+    </DropdownMenu>
+  )
+}
+
+export function CredentialTable({
+  rows, today, balances, loadingBalance, selected, onToggle, onToggleAll, onOpen, onBalance, onUsage, onDelete,
+}: {
+  rows: CredentialStatusItem[]
+  today: Record<string, TodayUsage>
