diff --git a/tests/test_usage_realtime.py b/tests/test_usage_realtime.py
index e59e5c8..8d54951 100644
--- a/tests/test_usage_realtime.py
+++ b/tests/test_usage_realtime.py
@@ -1268,3 +1268,97 @@ def test_realtime_archive_stream_is_length_capped() -> None:
     assert "redis.call('XADD', stream_key" in script
     assert "MAXLEN" in script
     assert "~" in script
+
+
+def test_slow_directory_refresh_does_not_block_live_polling(monkeypatch) -> None:
+    """10-29: 目录刷新同步跑约 100s，期间实时轮询停摆、健康检查掉 REALTIME_STALE。"""
+    live_calls = 0
+    refresh_started = asyncio.Event()
+    refresh_release = asyncio.Event()
+
+    class Store:
+        async def connect(self):
+            return None
+
+    class Realtime:
+        async def connect(self):
+            return None
+
+        async def acquire_worker_lock(self, _worker_id):
+            return True
+
+        async def release_worker_lock(self, _worker_id):
+            return None
+
+    worker = UsageRealtimeWorker.__new__(UsageRealtimeWorker)
+    worker.store = Store()
+    worker.realtime = Realtime()
+    worker.synchronizer = type("Sync", (), {"organization_repository": None})()
+    worker.client = type("Client", (), {"backends": []})()
+    worker.worker_id = "worker-a"
+    worker.poll_seconds = 0
+    worker.directory_refresh_seconds = 0
+    worker.reconcile_seconds = 10**9
+    worker.live_cycle_timeout_seconds = 5
+    worker.current_day = __import__("backend.usage_realtime_worker", fromlist=["usage_today"]).usage_today()
+    worker.stop_event = asyncio.Event()
+    worker._lock_lost = asyncio.Event()
+    worker._lock_renew_task = None
+    worker._startup_member_sync_task = None
+    worker._startup_reconcile_task = None
+
+    async def noop(*_args, **_kwargs):
+        return None
+
+    async def slow_refresh(**_kwargs):
+        refresh_started.set()
+        await refresh_release.wait()
+
+    async def live_once(_now):
+        nonlocal live_calls
+        live_calls += 1
+        if live_calls >= 5:
+            worker.stop_event.set()
+        await asyncio.sleep(0)
+
+    monkeypatch.setattr(worker, "_connect_repository", noop)
+    monkeypatch.setattr(worker, "_renew_worker_lock_loop", lambda: worker.stop_event.wait())
+    monkeypatch.setattr(worker, "recover", noop)
+    monkeypatch.setattr(worker, "startup_member_snapshot_sync", noop)
+    monkeypatch.setattr(worker, "startup_reconcile", noop)
+    monkeypatch.setattr(worker, "_refresh_directories", slow_refresh)
+    monkeypatch.setattr(worker, "run_live_once", live_once)
+    monkeypatch.setattr(worker, "schedule_background_once", noop)
+
+    async def scenario():
+        await asyncio.wait_for(worker.run(), timeout=5)
+
+    asyncio.run(scenario())
+
+    assert refresh_started.is_set()
+    assert not refresh_release.is_set()
+    assert live_calls >= 5
+    assert worker._periodic_tasks == {}
+
+
+def test_periodic_task_is_not_stacked_while_previous_run_is_active() -> None:
+    worker = UsageRealtimeWorker.__new__(UsageRealtimeWorker)
+    runs = 0
+    release = asyncio.Event()
+
+    async def job():
+        nonlocal runs
+        runs += 1
+        await release.wait()
+
+    async def scenario():
+        assert worker._spawn_periodic("directory", job) is True
+        await asyncio.sleep(0)
+        assert worker._spawn_periodic("directory", job) is False
+        release.set()
+        await worker._periodic_tasks["directory"]
+        assert worker._spawn_periodic("directory", job) is True
+        await worker._periodic_tasks["directory"]
+
+    asyncio.run(scenario())
+    assert runs == 2
