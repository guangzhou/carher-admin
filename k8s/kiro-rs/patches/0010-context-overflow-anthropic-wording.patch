+#[cfg(test)]
+mod map_provider_error_tests {
+    use super::*;
+
+    /// 上游真实错误串（kiro.rs 日志 10-23 原样）
+    const UPSTREAM_TOO_LONG: &str = r#"流式 API 请求失败: 400 Bad Request {"message":"Input is too long.","reason":"CONTENT_LENGTH_EXCEEDS_THRESHOLD"}"#;
+    const UPSTREAM_429: &str = r#"流式 API 请求失败: 429 Too Many Requests {"message":"Too many requests, please wait before trying again.","reason":null}"#;
+
+    async fn body_of(resp: Response) -> (StatusCode, serde_json::Value) {
+        let status = resp.status();
+        let bytes = axum::body::to_bytes(resp.into_body(), usize::MAX).await.unwrap();
+        (status, serde_json::from_slice(&bytes).unwrap())
+    }
+
+    /// 按 Claude Code 2.1.309 的正则（二进制里原样：
+    /// `/prompt is too long[^0-9]*(\d+)\s*tokens?\s*>\s*(\d+)/i`）手写的等价解析，不引 regex 依赖
+    fn claude_code_parses(msg: &str) -> Option<(u64, u64)> {
+        let lower = msg.to_lowercase();
+        let rest = &lower[lower.find("prompt is too long")? + "prompt is too long".len()..];
+        let rest = rest.trim_start_matches(|c: char| !c.is_ascii_digit());
+        let n_end = rest.find(|c: char| !c.is_ascii_digit())?;
+        let n: u64 = rest[..n_end].parse().ok()?;
+        let rest = rest[n_end..].trim_start();
+        let rest = rest.strip_prefix("tokens").or_else(|| rest.strip_prefix("token"))?;
+        let rest = rest.trim_start().strip_prefix('>')?.trim_start();
+        let m_end = rest.find(|c: char| !c.is_ascii_digit()).unwrap_or(rest.len());
+        let m: u64 = rest[..m_end].parse().ok()?;
+        Some((n, m))
+    }
+
+    #[tokio::test]
+    async fn too_long_uses_anthropic_wording_with_numbers() {
+        let resp = map_provider_error(anyhow::Error::msg(UPSTREAM_TOO_LONG), "claude-opus-5-5", 1_012_345);
+        let (status, body) = body_of(resp).await;
+        assert_eq!(status, StatusCode::BAD_REQUEST);
+        assert_eq!(body["error"]["type"], "invalid_request_error");
+        let msg = body["error"]["message"].as_str().unwrap();
+        assert_eq!(msg, "prompt is too long: 1012345 tokens > 1000000 maximum");
+        assert_eq!(claude_code_parses(msg), Some((1_012_345, 1_000_000)));
+    }
+
+    #[tokio::test]
+    async fn too_long_with_low_local_estimate_still_reports_over_window() {
+        // 本地估算 79 万（linsen 10-19 那种：上游按别的尺子拒），文案仍须 N > M
+        let resp = map_provider_error(anyhow::Error::msg(UPSTREAM_TOO_LONG), "claude-opus-5-5", 796_092);
+        let (_, body) = body_of(resp).await;
+        let (n, m) = claude_code_parses(body["error"]["message"].as_str().unwrap()).unwrap();
+        assert_eq!(m, 1_000_000);
+        assert!(n > m, "n={n} m={m}");
+    }
+
+    #[tokio::test]
+    async fn too_long_200k_model_reports_its_own_window() {
+        let resp = map_provider_error(anyhow::Error::msg(UPSTREAM_TOO_LONG), "claude-haiku-4-5", 210_000);
+        let (_, body) = body_of(resp).await;
+        assert_eq!(body["error"]["message"], "prompt is too long: 210000 tokens > 200000 maximum");
+    }
+
+    #[tokio::test]
+    async fn message_only_input_is_too_long_also_maps() {
+        let resp = map_provider_error(anyhow::Error::msg(r#"400 Bad Request {"message":"Input is too long."}"#), "claude-opus-5-5", 5);
+        let (status, body) = body_of(resp).await;
+        assert_eq!(status, StatusCode::BAD_REQUEST);
+        assert!(body["error"]["message"].as_str().unwrap().starts_with("prompt is too long: "));
+    }
+
+    #[tokio::test]
+    async fn old_wording_is_gone() {
+        // 阴性对照：旧文案不再出现（它不被 Claude Code / LiteLLM 识别）
+        let resp = map_provider_error(anyhow::Error::msg(UPSTREAM_TOO_LONG), "claude-opus-5-5", 1);
+        let (_, body) = body_of(resp).await;
+        let msg = body["error"]["message"].as_str().unwrap();
+        assert!(!msg.contains("Context window is full"));
+        assert!(!msg.contains("Reduce the size"));
+    }
+
+    #[tokio::test]
+    async fn rate_limit_is_untouched() {
+        // 429 等其他错误维持 502 原样（LiteLLM 照常换号/兜底）
+        let resp = map_provider_error(anyhow::Error::msg(UPSTREAM_429), "claude-opus-5-5", 1_012_345);
+        let (status, body) = body_of(resp).await;
+        assert_eq!(status, StatusCode::BAD_GATEWAY);
+        assert_eq!(body["error"]["type"], "api_error");
+        assert!(!body["error"]["message"].as_str().unwrap().contains("prompt is too long"));
+    }
+}
