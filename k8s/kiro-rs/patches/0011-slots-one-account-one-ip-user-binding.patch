+    })
+  const TH = 'px-3 py-2.5 text-left text-xs font-medium text-muted-foreground whitespace-nowrap'
+  return (
+    <div className="overflow-x-auto rounded-lg border bg-card">
+      <table className="w-full text-sm">
+        <thead className="border-b bg-muted/40">
+          <tr>
+            <th className="w-10 px-3 py-2.5"><Checkbox checked={allOn} onCheckedChange={(v) => onToggleAll(!!v)} aria-label="全选本页" /></th>
+            <th className={TH}>账户</th>
+            <th className={TH}>状态</th>
+            <th className={TH}>等级</th>
+            <th className={TH}>已用额度</th>
+            <th className={`${TH} text-right`}>7 日请求</th>
+            <th className={`${TH} text-right`}>7 日 token</th>
+            <th className={TH}>最后使用</th>
+            <th className={`${TH} text-center`}>优先级</th>
+            <th className="w-12 px-2" />
+          </tr>
+        </thead>
+        <tbody className="divide-y">
+          {rows.map((c) => {
+            const t = today[String(c.id)]
+            const bad = c.failureCount + c.refreshFailureCount
+            return (
+              <tr key={c.id} onClick={() => onOpen(c.id)}
+                className={`cursor-pointer transition-colors hover:bg-muted/40 ${c.disabled ? 'text-muted-foreground' : ''} ${selected.has(c.id) ? 'bg-primary/5' : ''}`}>
+                <td className="px-3 py-3" onClick={(e) => e.stopPropagation()}>
+                  <Checkbox checked={selected.has(c.id)} onCheckedChange={() => onToggle(c.id)} aria-label={`选择 #${c.id}`} />
+                </td>
+                <td className="max-w-[22rem] px-3 py-3">
+                  <div className="flex items-center gap-2">
+                    <span className="font-mono text-xs text-muted-foreground">#{c.id}</span>
+                    <span className="truncate font-medium" title={c.email || ''}>{c.email || '—'}</span>
+                    {c.slotNo != null && (
+                      <span className="inline-flex shrink-0 items-center gap-1 text-xs text-muted-foreground" title={`正在槽 ${c.slotNo}（${c.slotName}）上服务`}>
+                        <SlotNo n={c.slotNo} size="sm" />在槽
+                      </span>
+                    )}
+                  </div>
