diff --git a/tests/test_sparse_fallback_upstream_confirmation.py b/tests/test_sparse_fallback_upstream_confirmation.py
new file mode 100644
index 0000000..8d03e80
--- /dev/null
+++ b/tests/test_sparse_fallback_upstream_confirmation.py
@@ -0,0 +1,136 @@
+"""「非空用户过少」门禁：上游全局汇总证明本来就没流量时，空结果算完整。
+
+2026-10-20 生产：her 09-28 迁走后每天全局请求个位数（10-01 为 0，10-19 为 3），
+305 个账号里 0~1 人有用量 ⇒ 门禁每次判不完整 ⇒ 刷新队列无限重试（最多 1002 次），
+排在后面的新日期一直轮不到，看板 10-14 少 69%、10-18 少 81%。
+"""
+
+import asyncio
+
+from backend.usage_sync import UsageSynchronizer
+
+
+class Backend:
+    id = "her"
+    source = "Her"
+
+
+def _client(upstream_requests, *, users=30, used_by=0, upstream_error=False):
+    calls: list[str] = []
+
+    class FakeClient:
+        backends = [Backend()]
+
+        def _admin_user_map(self, raw):
+            return {u["user_id"].lower(): {"name": u["user_id"], "email": f"{u['user_id']}@example.com"} for u in raw}
+
+        def _is_backend_usage_account(self, _backend, _user_id):
+            return True
+
+        async def users(self, _backend):
+            return [{"user_id": f"u{i}", "user_email": f"u{i}@example.com"} for i in range(users)]
+
+        async def her_account_index(self, _backend):
+            return {}
+
+        def _encode_account_id(self, backend, user_id):
+            return f"{backend.id}:{user_id}"
+
+        async def usage_rows(self, user_id, _start, _end, _source):
+            index = int(user_id.split(":u", 1)[1])
+            if index < used_by:
+                return [{"date": "2026-10-19", "source": "Her", "model": "m", "totalTokens": 5, "requestCount": 1}]
+            return []
+
+        async def teams(self, _backend):
+            return []
+
+        async def request_backend(self, _backend, _method, path, *, params):
+            calls.append(path)
+            if upstream_error:
+                raise TimeoutError()
+            return {"daily_data": [], "metadata": {"total_api_requests": upstream_requests, "total_spend": 0.0}}
+
+    return FakeClient(), calls
+
+
+def _collect(client, start="2026-10-19", end="2026-10-19"):
+    return asyncio.run(UsageSynchronizer(client, object()).collect_backend(Backend(), start, end))
+
+
+def test_near_zero_upstream_traffic_makes_a_sparse_result_complete() -> None:
+    client, calls = _client(upstream_requests=3)
+
+    snapshot = _collect(client)
+
+    assert calls == ["/user/daily/activity/aggregated"]
+    assert snapshot.quality["complete"] is True
+    assert snapshot.quality["degradedReason"] == ""
+    assert snapshot.quality["fallback"]["sparseConfirmedByUpstream"] is True
+
+
+def test_real_upstream_traffic_keeps_the_sparse_gate_closed() -> None:
+    """阴性对照：上游一天有几千条，按人回退却几乎是空的 ⇒ 这才是门禁要挡的漏数据。"""
+    client, _ = _client(upstream_requests=5000)
+
+    snapshot = _collect(client)
+
+    assert snapshot.quality["complete"] is False
+    assert snapshot.quality["degradedReason"] == "用户 daily activity 返回非空用户过少"
+
+
+def test_threshold_scales_with_the_number_of_days() -> None:
+    client, _ = _client(upstream_requests=250)
+    assert _collect(client, "2026-10-17", "2026-10-19").quality["complete"] is True  # 3 天 × 100
+
+    client, _ = _client(upstream_requests=350)
+    assert _collect(client, "2026-10-17", "2026-10-19").quality["complete"] is False
+
+
+def test_upstream_check_failure_keeps_the_gate_closed() -> None:
+    client, _ = _client(upstream_requests=0, upstream_error=True)
+
+    assert _collect(client).quality["complete"] is False
+
+
+def test_missing_metadata_keeps_the_gate_closed() -> None:
+    client, _ = _client(upstream_requests=None)
+
+    assert _collect(client).quality["complete"] is False
+
+
+def test_setting_threshold_to_zero_restores_the_old_behaviour(monkeypatch) -> None:
+    monkeypatch.setenv("USAGE_SYNC_SPARSE_MAX_DAILY_REQUESTS", "0")
+    client, calls = _client(upstream_requests=0)
+
+    assert _collect(client).quality["complete"] is False
+    assert calls == []
+
+
+def test_non_sparse_result_does_not_call_upstream() -> None:
+    """门禁没触发时不额外打上游。"""
+    client, calls = _client(upstream_requests=0, users=30, used_by=10)
+
+    snapshot = _collect(client)
+
+    assert snapshot.quality["complete"] is True
+    assert calls == []
+
+
+def test_refresh_claim_prefers_fewer_attempts_before_age() -> None:
+    """刷新队列：反复失败的老请求不能永远排在新日期前面。"""
+    from backend.usage_store import UsageStore
+
+    class Pool:
+        query = ""
+
+        async def fetch(self, query, *_args):
+            self.query = query
+            return []
+
+    store = UsageStore("postgresql://unused")
+    store.pool = Pool()
+    asyncio.run(store.claim_refresh_requests())
+
+    order = " ".join(store.pool.query.split()).split("ORDER BY", 1)[1].split("FOR UPDATE", 1)[0].strip()
+    assert order == "attempts, requested_at"
