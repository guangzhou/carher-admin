+/// window 模式参数
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct WindowSettings {
+    /// 平时同时在线的号数
+    pub min_k: usize,
+    /// 冷却补位时最多扩到几个号
+    pub max_k: usize,
+    /// 号被 429 后冷却秒数
+    pub cooldown_secs: u64,
+}
+
+/// 窗口参数上限（防误填把全池拉上线）
+pub const WINDOW_K_HARD_CAP: usize = 20;
+
+impl WindowSettings {
+    pub fn validate(&self) -> anyhow::Result<()> {
+        if self.min_k < 1 {
+            anyhow::bail!("平时在线数（minK）至少为 1");
+        }
+        if self.max_k < self.min_k {
+            anyhow::bail!("上限（maxK）不能小于平时在线数（minK）");
+        }
+        if self.max_k > WINDOW_K_HARD_CAP {
+            anyhow::bail!("上限（maxK）不能超过 {}", WINDOW_K_HARD_CAP);
+        }
+        if !(1..=3600).contains(&self.cooldown_secs) {
+            anyhow::bail!("冷却秒数需在 1~3600 之间");
+        }
+        Ok(())
+    }
+}
+
+/// window 模式选号（纯函数，便于单测）。
+///
+/// 1. 可用号按 (priority, id) 排序 —— 窗口永远是排在最前面的那几个，其余号不碰（冷备）。
+/// 2. 窗口大小 K = min_k + 窗口里正在冷却的号数，封顶 max_k：
+///    平时 K=min_k；有号被 429 冷却就往后多拉一个顶上，冷却结束自动缩回。
+/// 3. 窗口内跳过冷却中的号，选在途最少的（平局按排序先后）。
+/// 4. 窗口里全在冷却 ⇒ 选最早结束冷却的那个（不等待，直接发；用户不多等一毫秒）。
+fn pick_window<'a>(
+    available: &[&'a CredentialEntry],
+    now: Instant,
+    min_k: usize,
+    max_k: usize,
+) -> Option<&'a CredentialEntry> {
+    if available.is_empty() {
+        return None;
+    }
+    let min_k = min_k.max(1);
+    let max_k = max_k.max(min_k);
+    let mut sorted: Vec<&CredentialEntry> = available.to_vec();
+    sorted.sort_by_key(|e| (e.credentials.priority, e.id));
+    let cooling = |e: &CredentialEntry| e.cooldown_until.is_some_and(|t| t > now);
+
+    let mut k = min_k.min(sorted.len());
+    while k < max_k.min(sorted.len()) {
+        let cooled_in_window = sorted[..k].iter().filter(|e| cooling(e)).count();
+        if k >= min_k + cooled_in_window {
+            break;
+        }
+        k += 1;
+    }
+    let window = &sorted[..k];
+    window
+        .iter()
+        .filter(|e| !cooling(e))
+        // 在途少的优先；平局取累计成功少的 ⇒ 窗口内各号轮流分担，而不是只用第一个
+        .min_by_key(|e| (e.in_flight, e.success_count))
+        .or_else(|| window.iter().min_by_key(|e| e.cooldown_until))
+        .copied()
+}
