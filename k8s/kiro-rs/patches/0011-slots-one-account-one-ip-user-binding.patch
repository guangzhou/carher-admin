+    #[test]
+    fn aimd_decreases_on_429_not_below_min() {
+        let mut s = SlotState::new(0, 8);
+        let now = Instant::now();
+        s.on_429(&p(), now, None);
+        assert_eq!(s.limit, 5);
+        for _ in 0..10 {
+            s.on_429(&p(), now, None);
+        }
+        assert_eq!(s.limit, 2);
+    }
+
+    #[test]
+    fn aimd_grows_only_after_quiet_and_saturated() {
+        let mut s = SlotState::new(0, 8);
+        let t0 = s.created_at;
+        s.saturated_since_grow = true;
+        assert!(!s.maybe_grow(&p(), t0 + Duration::from_secs(60)), "静默期不足不涨");
+        assert!(s.maybe_grow(&p(), t0 + Duration::from_secs(301)));
+        assert_eq!(s.limit, 9);
+        assert!(!s.maybe_grow(&p(), t0 + Duration::from_secs(700)), "没再跑满不涨");
+    }
