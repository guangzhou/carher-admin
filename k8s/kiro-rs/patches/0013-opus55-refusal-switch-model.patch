+    /// 这个会话是否在备用模型粘性期内
+    fn refusal_sticky_hit(&self, conv: &str) -> bool {
+        let now = chrono::Utc::now().timestamp();
+        self.refusal_sticky.lock().get(conv).is_some_and(|&exp| exp > now)
+    }
+
+    fn refusal_sticky_mark(&self, conv: &str) {
+        let now = chrono::Utc::now().timestamp();
+        let mut m = self.refusal_sticky.lock();
+        if m.len() >= REFUSAL_STICKY_MAX {
+            m.retain(|_, exp| *exp > now);
+            if m.len() >= REFUSAL_STICKY_MAX {
+                m.clear();
+            }
+        }
+        m.insert(conv.to_string(), now + REFUSAL_STICKY_SECS);
+    }
