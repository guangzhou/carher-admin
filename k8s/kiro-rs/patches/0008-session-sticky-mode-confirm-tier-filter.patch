+    /// 会话键（window 模式选号用，同一会话尽量落同一个号；见 [`session_key`]）
+    pub session_key: Option<String>,
 }
 
+/// 会话键：同一段对话的每一轮请求应算出同一个值。
+///
+/// 1. Claude Code 在 `metadata.user_id` 里带 session UUID ⇒ 直接用（`sid:` 前缀）
+/// 2. 否则用「系统提示 + 第一条 user 消息」的 sha256（`anc:` 前缀）：
+///    多轮对话里这两段不变，后面的消息只是往后追加
+/// 3. 两者都没有 ⇒ None（按在途数挑号）
+pub fn session_key(req: &MessagesRequest) -> Option<String> {
+    if let Some(sid) = req
+        .metadata
+        .as_ref()
+        .and_then(|m| m.user_id.as_ref())
+        .and_then(|u| extract_session_id(u))
+    {
+        return Some(format!("sid:{}", sid));
+    }
+    let first_user = req.messages.iter().find(|m| m.role == "user")?;
+    let mut h = Sha256::new();
+    if let Some(sys) = &req.system {
+        for s in sys {
+            h.update(s.text.as_bytes());
+            h.update([0u8]);
+        }
+    }
+    h.update([1u8]);
+    h.update(first_user.content.to_string().as_bytes());
+    Some(format!("anc:{}", hex::encode(&h.finalize()[..12])))
+}
+
 /// 转换错误
 #[derive(Debug)]
 pub enum ConversionError {
