@@ -0,0 +1,60 @@
+"""健康检查：上游没有 LiteLLM Enterprise 许可时 /organization/list 永远 403，
+这是部署限制不是故障，不能让整体一直 degraded（2026-10-29 198 实测）。
+其它组织探针失败（teams/keys 不通、401、5xx、非许可原因的 403）仍然要报 degraded。"""
+
+from backend.main import organization_license_only_unavailable
+
+LICENSE_403 = (
+    "上游接口失败：Organizations are only available for LiteLLM Enterprise users. "
+    "You must be a LiteLLM Enterprise user to use this feature."
+)
+
+
+def _status(**overrides):
+    status = {
+        "available": False,
+        "organizations": False,
+        "teams": True,
+        "keys": True,
+        "errors": {"organizations": {"statusCode": 403, "detail": LICENSE_403}},
+    }
+    status.update(overrides)
+    return status
+
+
+def test_license_only_403_is_a_known_limitation() -> None:
+    assert organization_license_only_unavailable(_status()) is True
+
+
+def test_admin_key_rejected_is_still_a_fault() -> None:
+    """10-28 那种旧 key：organizations/teams/keys 全 403「管理员密钥无权限」⇒ 必须报 degraded。"""
+    detail = {"statusCode": 403, "detail": "管理员密钥无权限或已失效"}
+    status = _status(teams=False, keys=False, errors={"organizations": detail, "teams": detail, "keys": detail})
+    assert organization_license_only_unavailable(status) is False
+
+
+def test_org_403_for_other_reason_is_a_fault() -> None:
+    status = _status(errors={"organizations": {"statusCode": 403, "detail": "管理员密钥无权限或已失效"}})
+    assert organization_license_only_unavailable(status) is False
+
+
+def test_org_5xx_is_a_fault() -> None:
+    status = _status(errors={"organizations": {"statusCode": 502, "detail": "bad gateway"}})
+    assert organization_license_only_unavailable(status) is False
+
+
+def test_teams_down_alongside_license_is_a_fault() -> None:
+    status = _status(
+        teams=False,
+        errors={
+            "organizations": {"statusCode": 403, "detail": LICENSE_403},
+            "teams": {"statusCode": 500, "detail": "db"},
+        },
+    )
+    assert organization_license_only_unavailable(status) is False
+
+
+def test_probe_exception_is_a_fault() -> None:
+    """探针本身抛异常时 refresh 写的是 error 状态，没有 errors 字典。"""
+    status = {"status": "error", "available": False, "organizations": False, "teams": False, "keys": False, "error": "RuntimeError"}
+    assert organization_license_only_unavailable(status) is False
