+/// 给响应体挂一个「旁路计量」：字节原样往下游传，同时旁路解码 Kiro 事件流，
+/// 流结束（读完 / 出错 / 客户端断开 drop）时把 号 × 模型 × token 记到账户用量里。
+/// 输入 token = contextUsageEvent 百分比 × 模型窗口；输出 token = 回复文本 + 工具参数的估算。
+fn meter_response(
+    resp: reqwest::Response,
+    tm: Arc<MultiTokenManager>,
+    account: u64,
+    model: String,
+) -> reqwest::Response {
+    use futures::StreamExt;
+    struct Meter {
+        tm: Arc<MultiTokenManager>,
+        account: u64,
+        model: String,
+        decoder: crate::kiro::parser::decoder::EventStreamDecoder,
+        ctx_pct: Option<f64>,
+        out_text: String,
+        errored: bool,
+        done: bool,
+    }
+    impl Meter {
+        fn feed(&mut self, chunk: &[u8]) {
+            use crate::kiro::model::events::Event;
+            let _ = self.decoder.feed(chunk);
+            for frame in self.decoder.decode_iter().flatten() {
+                match Event::from_frame(frame) {
+                    Ok(Event::AssistantResponse(r)) => self.out_text.push_str(&r.content),
+                    Ok(Event::ToolUse(t)) => self.out_text.push_str(&t.input),
+                    Ok(Event::ContextUsage(c)) => self.ctx_pct = Some(c.context_usage_percentage),
+                    Ok(Event::Error { .. }) | Ok(Event::Exception { .. }) => self.errored = true,
+                    _ => {}
+                }
+            }
+        }
+        fn finish(&mut self) {
+            if self.done { return }
+            self.done = true;
+            let window = crate::anthropic::converter::get_context_window_size(&self.model) as f64;
+            let input = self.ctx_pct.map(|p| (p * window / 100.0) as u64).unwrap_or(0);
+            let output = if self.out_text.is_empty() { 0 } else { crate::token::count_tokens(&self.out_text) };
+            let ok = !self.errored && (output > 0 || self.ctx_pct.is_some());
+            self.tm.record_account_usage(self.account, &self.model, ok, input, output);
+        }
+    }
+    impl Drop for Meter {
+        fn drop(&mut self) { self.finish() }
+    }
+    let status = resp.status();
+    let headers = resp.headers().clone();
+    let mut meter = Meter {
+        tm, account, model,
+        decoder: crate::kiro::parser::decoder::EventStreamDecoder::new(),
+        ctx_pct: None, out_text: String::new(), errored: false, done: false,
+    };
+    let s = resp.bytes_stream().map(move |c| {
+        match &c {
+            Ok(b) => meter.feed(b),
+            Err(_) => meter.errored = true,
+        }
+        c.map_err(std::io::Error::other)
+    });
+    let mut b = http::Response::builder().status(status);
+    if let Some(h) = b.headers_mut() {
+        *h = headers;
+    }
+    reqwest::Response::from(b.body(reqwest::Body::wrap_stream(s)).expect("rebuild response"))
+}
+
+/// 把槽位名额挂到响应体上：流读完 / 客户端断开 / 出错时 drop 归还
+fn hold_permit(resp: reqwest::Response, permit: crate::kiro::token_manager::SlotPermit) -> reqwest::Response {
+    use futures::StreamExt;
+    let status = resp.status();
+    let headers = resp.headers().clone();
+    let s = resp.bytes_stream().map(move |c| {
+        let _keep = &permit;
+        c.map_err(std::io::Error::other)
+    });
+    let mut b = http::Response::builder().status(status);
+    if let Some(h) = b.headers_mut() {
+        *h = headers;
+    }
+    reqwest::Response::from(b.body(reqwest::Body::wrap_stream(s)).expect("rebuild response"))
+}
