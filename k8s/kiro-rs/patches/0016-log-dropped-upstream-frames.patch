+        assert!(log.contains("payload_len=14"), "{log}");
+        assert!(log.contains(&format!("payload_sha12={}", payload_sha12(br#"{"content": 12"#))), "{log}");
+        assert!(!log.contains(r#""content": 12"#), "日志不该带 payload 原文: {log}");
