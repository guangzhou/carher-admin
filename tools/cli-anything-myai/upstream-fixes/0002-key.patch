+    async def key_rollup_rows(
+        self,
+        start_date: str,
+        end_date: str,
+        backend: LiteLLMBackend | None = None,
+    ) -> tuple[list[dict[str, Any]], dict[str, Any]]:
+        """Per-key x model daily rows from the global rollup, plus totals.
+
+        ``/user/daily/activity`` without ``user_id`` pages over every key in
+        LiteLLM_DailyUserSpend. Its ``models[m].api_key_breakdown[sha]`` covers
+        keys whose owner is absent from LiteLLM_UserTable or empty, which the
+        per-user fallback can never query. Dates are UTC buckets, the same
+        basis as the per-user daily-activity path.
+        """
+        backend = backend or self.backends[0]
+        await self._ensure_deployment_model_map(backend)
+        model_map = getattr(self, "_deployment_model_maps", {}).get(backend.id, {})
+        grouped: dict[tuple[str, str, str], dict[str, Any]] = {}
+        totals = {"requestCount": 0, "spend": 0.0}
+        page, total_pages = 1, 1
+        max_pages = max(1, _env_int("USAGE_SYNC_KEY_ROLLUP_MAX_PAGES", 50))
+        while page <= total_pages and page <= max_pages:
+            payload = await self.request_backend(
+                backend,
+                "GET",
+                "/user/daily/activity",
+                params={"start_date": start_date, "end_date": end_date, "page": page, "page_size": 1000},
+            )
+            if not isinstance(payload, dict):
+                raise HTTPException(status_code=502, detail="上游全局用量响应格式错误")
+            metadata = payload.get("metadata") if isinstance(payload.get("metadata"), dict) else {}
+            total_pages = max(1, _as_int(_first(metadata, "total_pages", default=1)))
+            for item in _records(payload):
+                if not isinstance(item, dict) or not _first(item, "date", "day"):
+                    continue
+                day = _date_text(_first(item, "date", "day"))
+                breakdown = item.get("breakdown") if isinstance(item.get("breakdown"), dict) else {}
+                key_meta = {
+                    sha: (value.get("metadata") if isinstance(value, dict) and isinstance(value.get("metadata"), dict) else {})
+                    for sha, value in (breakdown.get("api_keys") or {}).items()
+                }
+                for model_name, model_value in (breakdown.get("models") or {}).items():
+                    if not isinstance(model_value, dict):
+                        continue
+                    model = resolve_canonical_model_name(model_name, deployment_map=model_map, diagnose_unknown=False)
+                    if not model:
+                        continue
+                    for sha, key_value in (model_value.get("api_key_breakdown") or {}).items():
+                        metrics = _metrics_dict(key_value)
+                        requests = _as_int(_first(metrics, "api_requests", "total_api_requests"))
+                        spend = _as_number(_first(metrics, "spend", "total_spend"))
+                        if not requests and not spend:
+                            continue
+                        row = grouped.get((day, model, sha))
+                        if row is None:
+                            meta = key_meta.get(sha) or (
+                                key_value.get("metadata") if isinstance(key_value.get("metadata"), dict) else {}
+                            )
+                            row = self._empty_usage_row(day, backend.source or "其他", model)
+                            row.update({
+                                "keyId": _clean_text(sha),
+                                "keyAlias": _clean_text(meta.get("key_alias")),
+                                "keyOwnerUserId": _clean_text(meta.get("user_id")),
+                                "keyTeamId": _clean_text(meta.get("team_id")),
+                                "keyExists": bool(meta.get("key_exists", True)),
+                            })
+                            grouped[(day, model, sha)] = row
+                        prompt = _as_int(_first(metrics, "prompt_tokens", "total_prompt_tokens"))
+                        completion = _as_int(_first(metrics, "completion_tokens", "total_completion_tokens"))
+                        failures = _as_int(_first(metrics, "failed_requests", "total_failed_requests"))
+                        row["promptTokens"] += prompt
+                        row["completionTokens"] += completion
+                        row["totalTokens"] += _as_int(_first(metrics, "total_tokens", default=prompt + completion))
+                        row["requestCount"] += requests
+                        row["failureCount"] += failures
+                        row["successCount"] += max(0, requests - failures)
+                        row["spend"] += spend
+            totals["requestCount"] += _as_int(_first(metadata, "total_api_requests", default=0))
+            totals["spend"] += _as_number(_first(metadata, "total_spend", default=0))
+            page += 1
+        totals["complete"] = page > total_pages
+        return list(grouped.values()), totals
+
     async def global_activity_totals(self, start_date: str, end_date: str) -> dict[str, Any]:
         """Read the upstream global request/token totals independently per backend."""
         totals = self._usage_totals([])
