+import { toast } from 'sonner'
+import { MoreHorizontal, Wallet, BarChart3, RefreshCw, RotateCcw, Trash2, ChevronUp, ChevronDown } from 'lucide-react'
+import { Badge } from '@/components/ui/badge'
+import { Button } from '@/components/ui/button'
+import { Checkbox } from '@/components/ui/checkbox'
+import { Switch } from '@/components/ui/switch'
+import {
+  DropdownMenu, DropdownMenuContent, DropdownMenuItem, DropdownMenuSeparator, DropdownMenuTrigger,
+} from '@/components/ui/dropdown-menu'
+import type { CredentialStatusItem, BalanceResponse } from '@/types/api'
+import { useSetDisabled, useSetPriority, useResetFailure, useForceRefreshToken } from '@/hooks/use-credentials'
+
+// 账户列表：一行一个号。只放「看一眼要知道的」，其它都在行尾 ⋯ 菜单 / 点行进详情。
+// 槽位编号徽章：卡片和账户表用同一个号 + 同一个颜色，一眼对上
+const SLOT_COLORS = ['bg-sky-600', 'bg-violet-600', 'bg-amber-600', 'bg-emerald-600', 'bg-rose-600', 'bg-cyan-700', 'bg-fuchsia-600', 'bg-lime-700']
+export function SlotNo({ n, size = 'md' }: { n: number; size?: 'sm' | 'md' }) {
+  const c = SLOT_COLORS[(n - 1) % SLOT_COLORS.length]
+  const sz = size === 'sm' ? 'h-5 min-w-5 text-[11px]' : 'h-7 min-w-7 text-sm'
+  return <span className={`inline-flex shrink-0 items-center justify-center rounded-md px-1 font-bold text-white ${c} ${sz}`} aria-label={`槽 ${n}`}>{n}</span>
+}
+
+export interface TodayUsage { requests: number; failed: number; inputTokens: number; outputTokens: number }
+
+export const short = (n: number) =>
+  n >= 1e8 ? `${(n / 1e8).toFixed(1)}亿` : n >= 1e4 ? `${(n / 1e4).toFixed(1)}万` : n.toLocaleString('zh-CN')
+
+export function ago(t: string | null) {
+  if (!t) return '从未'
+  const s = Math.max(0, Math.floor((Date.now() - new Date(t).getTime()) / 1000))
+  if (s < 60) return `${s} 秒前`
+  if (s < 3600) return `${Math.floor(s / 60)} 分钟前`
+  if (s < 86400) return `${Math.floor(s / 3600)} 小时前`
+  return `${Math.floor(s / 86400)} 天前`
+}
+
+export const tierOf = (c: CredentialStatusItem, b?: BalanceResponse | null) =>
+  (b?.subscriptionTitle || c.subscriptionTitle || '').replace(/^KIRO\s*/i, '') || '—'
+
+function BalanceBar({ b, loading }: { b?: BalanceResponse | null; loading: boolean }) {
+  if (loading) return <span className="text-xs text-muted-foreground">查询中…</span>
+  if (!b) return <span className="text-xs text-muted-foreground">—</span>
+  const pct = Math.min(100, Math.max(0, b.usagePercentage))
+  const color = pct >= 85 ? 'bg-red-500' : pct >= 60 ? 'bg-amber-500' : 'bg-emerald-500'
+  return (
+    <div className="w-36" title={`已用 ${b.currentUsage.toFixed(2)} / 限额 ${b.usageLimit.toFixed(2)}（剩余 ${b.remaining.toFixed(2)}）`}>
+      <div className="flex justify-between text-xs tabular-nums">
+        <span className="font-medium">{b.currentUsage.toFixed(0)}<span className="font-normal text-muted-foreground"> / {b.usageLimit.toFixed(0)}</span></span>
+        <span className="text-muted-foreground">{pct.toFixed(0)}%</span>
+      </div>
+      <div className="mt-1 h-1.5 rounded-full bg-muted">
+        <div className={`h-1.5 rounded-full ${color}`} style={{ width: `${pct}%` }} />
+      </div>
+    </div>
+  )
+}
+
+function RowMenu({ c, onBalance, onUsage, onDelete }: {
+  c: CredentialStatusItem; onBalance: () => void; onUsage: () => void; onDelete: () => void
+}) {
+  const setPriority = useSetPriority()
+  const reset = useResetFailure()
+  const refresh = useForceRefreshToken()
+  const done = (p: Promise<{ message: string }>) => p.then((r) => toast.success(r.message)).catch((e) => toast.error((e as Error).message))
+  return (
+    <DropdownMenu>
+      <DropdownMenuTrigger asChild>
+        <Button variant="ghost" size="icon" className="h-8 w-8" aria-label={`#${c.id} 更多操作`} onClick={(e) => e.stopPropagation()}>
+          <MoreHorizontal className="h-4 w-4" />
+        </Button>
+      </DropdownMenuTrigger>
+      <DropdownMenuContent onClick={(e) => e.stopPropagation()}>
