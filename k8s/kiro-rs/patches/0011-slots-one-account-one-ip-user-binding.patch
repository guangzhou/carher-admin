+                    return Ok(response);
+                }
+                let restricted = self.probe_restricted(&ctx, &machine_id, request_body).await;
+                if !restricted || swaps >= SLOT_MAX_SWAPS {
+                    self.token_manager.slot_report_empty(slot, true);
+                    tracing::warn!("槽位 {} 号 #{} 空回复，探测 restricted={}，原样返回", slot, ctx.id, restricted);
+                    return Ok(response);
+                }
+                swaps += 1;
+                if self.token_manager.slot_retire_account(ctx.id, "restricted").is_none() {
+                    self.token_manager.slot_report_empty(slot, true);
+                    tracing::error!("槽位 {} 号 #{} 被限制，冷备已无可用号", slot, ctx.id);
+                    return Ok(response);
+                }
+                self.token_manager.slot_report_empty(slot, false);
+                continue;
+            }
+            let body = response.text().await.unwrap_or_default();
+            drop(permit);
+            if status.as_u16() == 402 && endpoint.is_monthly_request_limit(&body) {
+                if swaps >= SLOT_MAX_SWAPS || self.token_manager.slot_retire_account(ctx.id, "quota").is_none() {
+                    anyhow::bail!("{} API 请求失败（槽位无可替换号）: {} {}", api_type, status, body);
