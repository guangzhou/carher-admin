+    /// 日志里不出现 payload 原文：坏 payload 里的密钥既不能直接出现，也不能经 serde 错误信息带出来
+    #[test]
+    fn test_logged_never_leaks_payload_text() {
+        let secret = "sk-proj-AbCdEf0123456789";
+        let cases: Vec<(&str, Vec<u8>)> = vec![
+            // 类型不符：serde 错误信息会引用这个字符串值
+            ("contextUsageEvent", format!(r#"{{"contextUsagePercentage":"{secret}"}}"#).into_bytes()),
+            // 截断的 JSON
+            ("toolUseEvent", format!(r#"{{"name":"t","toolUseId":"x","input":"{secret}"#).into_bytes()),
+            // 未知事件类型
+            ("brandNewEvent", format!(r#"{{"k":"{secret}"}}"#).into_bytes()),
+        ];
+        for (et, payload) in cases {
+            let f = frame(Some("event"), Some(et), &payload);
+            if let Err(e) = Event::from_frame(f.clone()) {
+                if et == "contextUsageEvent" {
+                    // 阳性对照：原始错误信息确实会带出密钥（证明 redacted_error 不是多余的）
+                    assert!(e.to_string().contains(secret), "{e}");
+                }
+            }
+            let (_, log) = capture(|| Event::from_frame_logged(f, "stream", "m"));
+            assert!(log.contains("WARN"), "{et}: {log}");
+            assert!(!log.contains("sk-proj-"), "{et}: 日志泄露了 payload 原文: {log}");
+            assert!(log.contains(&format!("payload_sha12={}", payload_sha12(&payload))), "{et}: {log}");
+        }
+    }
