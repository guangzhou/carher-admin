+mod refusal_switch_tests {
+    use super::*;
+
+    const BODY: &str = r#"{"conversationState":{"conversationId":"c-1","currentMessage":{"userInputMessage":{"content":"hi","modelId":"claude-opus-5.5"}},"history":[{"userInputMessage":{"content":"sys","modelId":"claude-opus-5.5"}},{"assistantResponseMessage":{"content":"ok"}}]},"profileArn":"x"}"#;
+
+    #[test]
+    fn rewrite_changes_current_and_history_model_only() {
+        let out = rewrite_model_id(BODY, "claude-opus-5.5", "claude-opus-4.8").unwrap();
+        assert!(!out.contains("claude-opus-5.5"));
+        assert_eq!(out.matches("claude-opus-4.8").count(), 2);
+        let v: serde_json::Value = serde_json::from_str(&out).unwrap();
+        assert_eq!(v["conversationState"]["currentMessage"]["userInputMessage"]["content"], "hi");
+        assert_eq!(v["profileArn"], "x");
+    }
+
+    #[test]
+    fn rewrite_returns_none_when_model_absent() {
+        assert!(rewrite_model_id(BODY, "claude-sonnet-5", "claude-opus-4.8").is_none());
+        assert!(rewrite_model_id("not json", "a", "b").is_none());
+    }
+
