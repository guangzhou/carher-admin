+    // ---- 0017 身份策略：三条路径都要带上（走 convert_request，默认开）----
+
+    fn identity_req(system: Option<&str>, thinking: bool) -> MessagesRequest {
+        use super::super::types::{Message as AnthropicMessage, SystemMessage, Thinking};
+        MessagesRequest {
+            model: "claude-opus-5-5".to_string(),
+            max_tokens: 1024,
+            messages: vec![AnthropicMessage {
+                role: "user".to_string(),
+                content: serde_json::json!("你是谁？"),
+            }],
+            stream: false,
+            system: system.map(|s| vec![SystemMessage { text: s.to_string() }]),
+            tools: None,
+            tool_choice: None,
+            thinking: thinking.then(|| Thinking { thinking_type: "enabled".to_string(), budget_tokens: 2048 }),
+            output_config: None,
+            metadata: None,
+        }
+    }
+
+    fn first_pair(history: &[Message]) -> (String, String) {
+        assert!(history.len() >= 2, "history 应至少有一对系统消息，实际 {}", history.len());
+        let u = match &history[0] {
+            Message::User(u) => u.user_input_message.content.clone(),
+            _ => panic!("history[0] 应为 user"),
+        };
+        let a = match &history[1] {
+            Message::Assistant(a) => a.assistant_response_message.content.clone(),
+            _ => panic!("history[1] 应为 assistant"),
+        };
+        (u, a)
+    }
+
+    #[test]
+    fn test_identity_policy_with_system() {
+        let r = convert_request(&identity_req(Some("You are a helpful bot."), true)).unwrap();
+        let (u, a) = first_pair(&r.conversation_state.history);
+        assert!(u.contains("you are not Kiro"), "有 system 时应追加身份策略: {}", u);
+        assert!(u.starts_with("<thinking_mode>enabled</thinking_mode>"), "thinking 前缀仍在最前: {}", u);
+        assert!(u.contains("You are a helpful bot."));
+        assert!(u.contains(SYSTEM_CHUNKED_POLICY));
+        assert_eq!(a, "I will follow these instructions.");
+    }
+
