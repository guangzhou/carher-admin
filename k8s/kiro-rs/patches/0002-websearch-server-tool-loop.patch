diff -ruN '--exclude=target' '--exclude=node_modules' '--exclude=dist' '--exclude=.git' kiro.rs/src/anthropic/search_loop.rs kiro-ws/src/anthropic/search_loop.rs
--- kiro.rs/src/anthropic/search_loop.rs	1970-01-01 08:00:00.000000000 +0800
+++ kiro-ws/src/anthropic/search_loop.rs	2026-10-15 01:49:26.000000000 +0800
@@ -0,0 +1,832 @@
+//! 服务端搜索回合（server-side web_search agentic loop）
+//!
+//! 请求带 Anthropic 服务端搜索工具（`web_search_20250305` / Responses 桥过来的 `web_search`）时，
+//! Kiro 本身不认这类工具（原样转发会 400 "Invalid tool use format"）。
+//! 这里把它当普通函数工具交给模型（`converter::convert_tools` 已改写成带 query 的 schema），
+//! 模型调用 web_search 时由本模块用 Kiro MCP 搜索，结果作为 tool_result 交回模型继续生成，
+//! 直到模型给出回答或调用客户端工具。
+//!
+//! 客户端看到的是 Anthropic 原生的 `server_tool_use` + `web_search_tool_result` 块，
+//! 永远看不到需要自己执行的 web_search tool_use。
+//!
+//! 第一版整轮缓冲：所有回合跑完再一次性输出。流式请求先发 message_start，
+//! 等待期间每 25s 发 ping 保活，最后一次性发完所有内容块。
+
+use std::collections::HashMap;
+use std::convert::Infallible;
+use std::sync::Arc;
+use std::time::Duration;
+
+use axum::{
+    body::Body,
+    http::{StatusCode, header},
+    response::{IntoResponse, Json, Response},
+};
+use bytes::Bytes;
+use futures::{Stream, StreamExt, stream};
+use serde_json::{Value, json};
+use tokio::time::interval;
+use uuid::Uuid;
+
+use crate::kiro::model::events::Event;
+use crate::kiro::model::requests::kiro::KiroRequest;
+use crate::kiro::parser::decoder::EventStreamDecoder;
+use crate::kiro::provider::KiroProvider;
+use crate::token;
+
+use super::converter::{ConversionError, convert_request, get_context_window_size};
+use super::stream::{SseEvent, extract_thinking_from_complete_text};
+use super::types::{ErrorResponse, Message, MessagesRequest};
+use super::websearch;
+
+/// 没声明 max_uses 时每个请求最多搜几次
+const DEFAULT_MAX_USES: i32 = 5;
+/// max_uses 的硬上限（客户端声明再大也按这个封顶）
+const HARD_MAX_USES: i32 = 10;
+/// 最多调几轮模型（含最后作答那轮）
+const MAX_ROUNDS: usize = 8;
+const PING_INTERVAL_SECS: u64 = 25;
+
+/// 模型一轮的产出
+#[derive(Debug, Default)]
+pub(crate) struct Turn {
+    pub text: String,
+    pub tool_calls: Vec<ToolCall>,
+    /// 上游给出的非常规 stop_reason（max_tokens / model_context_window_exceeded）
+    pub stop_reason: Option<String>,
+    pub context_input_tokens: Option<i32>,
+}
+
+#[derive(Debug, Clone)]
+pub(crate) struct ToolCall {
+    pub id: String,
+    pub name: String,
+    pub input: Value,
+}
+
+/// 整个回合循环的输出（最终交给客户端的 message）
+#[derive(Debug)]
+pub(crate) struct LoopOutput {
+    pub content: Vec<Value>,
+    pub stop_reason: String,
+    pub input_tokens: i32,
+    pub output_tokens: i32,
+    pub searches: i32,
+}
+
+/// 入口：handlers 在检测到服务端搜索工具时调用
+pub async fn handle_search_loop(
+    provider: Arc<KiroProvider>,
+    payload: MessagesRequest,
+    extract_thinking_cfg: bool,
+) -> Response {
+    let estimated_input = token::count_all_tokens(
+        payload.model.clone(),
+        payload.system.clone(),
+        payload.messages.clone(),
+        payload.tools.clone(),
+    ) as i32;
+    let thinking_enabled = payload
+        .thinking
+        .as_ref()
+        .map(|t| t.is_enabled())
+        .unwrap_or(false);
+    // 与普通路径一致：流式恒提取 thinking，非流式看配置
+    let extract_thinking = thinking_enabled && (payload.stream || extract_thinking_cfg);
+
+    tracing::info!(
+        model = %payload.model,
+        stream = payload.stream,
+        "检测到服务端 web_search 工具，进入搜索回合"
+    );
+
+    // 第一轮在返回响应之前调，上游错误能以 HTTP 状态码交给 LiteLLM（照常走兜底）
+    let (body, tool_name_map) = match build_body(&payload) {
+        Ok(x) => x,
+        Err(resp) => return resp,
+    };
+    let first = match provider.call_api(&body).await {
+        Ok(resp) => resp,
+        Err(e) => return super::handlers::map_provider_error(e),
+    };
+
+    let model = payload.model.clone();
+    let stream_mode = payload.stream;
+    let message_id = format!("msg_{}", Uuid::new_v4().to_string().replace('-', ""));
+    let fut = run_loop(provider, payload, first, tool_name_map, extract_thinking, estimated_input);
+
+    if !stream_mode {
+        let out = fut.await;
+        return (StatusCode::OK, Json(to_message_json(&message_id, &model, &out))).into_response();
+    }
+
+    let (tx, rx) = tokio::sync::oneshot::channel();
+    tokio::spawn(async move {
+        let _ = tx.send(fut.await);
+    });
+    let start = message_start_event(&message_id, &model, estimated_input);
+    let body_stream = buffered_sse(start, rx);
+    Response::builder()
+        .status(StatusCode::OK)
+        .header(header::CONTENT_TYPE, "text/event-stream")
+        .header(header::CACHE_CONTROL, "no-cache")
+        .header(header::CONNECTION, "keep-alive")
+        .body(Body::from_stream(body_stream))
+        .unwrap()
+}
+
+/// MessagesRequest → Kiro 请求体（错误映射与 handlers 一致）
+fn build_body(payload: &MessagesRequest) -> Result<(String, HashMap<String, String>), Response> {
+    let conversion = convert_request(payload).map_err(|e| {
+        let (error_type, message) = match &e {
+            ConversionError::UnsupportedModel(model) => {
+                ("invalid_request_error", format!("模型不支持: {}", model))
+            }
+            ConversionError::EmptyMessages => ("invalid_request_error", "消息列表为空".to_string()),
+        };
+        tracing::warn!("请求转换失败: {}", e);
+        (StatusCode::BAD_REQUEST, Json(ErrorResponse::new(error_type, message))).into_response()
+    })?;
+    let kiro_request = KiroRequest {
+        conversation_state: conversion.conversation_state,
+        profile_arn: None,
+    };
+    let body = serde_json::to_string(&kiro_request).map_err(|e| {
+        (
+            StatusCode::INTERNAL_SERVER_ERROR,
+            Json(ErrorResponse::new("internal_error", format!("序列化请求失败: {}", e))),
+        )
+            .into_response()
+    })?;
+    Ok((body, conversion.tool_name_map))
+}
+
+/// 解析一轮完整的 Kiro 事件流
+pub(crate) fn parse_turn(body: &[u8], model: &str, tool_name_map: &HashMap<String, String>) -> Turn {
+    let mut decoder = EventStreamDecoder::new();
+    if let Err(e) = decoder.feed(body) {
+        tracing::warn!("缓冲区溢出: {}", e);
+    }
+    let mut turn = Turn::default();
+    // 按首次出现顺序保留工具调用
+    let mut order: Vec<String> = Vec::new();
+    let mut buffers: HashMap<String, (String, String)> = HashMap::new();
+
+    for result in decoder.decode_iter() {
+        let Ok(frame) = result else { continue };
+        let Ok(event) = Event::from_frame(frame) else { continue };
+        match event {
+            Event::AssistantResponse(resp) => turn.text.push_str(&resp.content),
+            Event::ToolUse(tu) => {
+                let entry = buffers.entry(tu.tool_use_id.clone()).or_insert_with(|| {
+                    order.push(tu.tool_use_id.clone());
+                    (tu.name.clone(), String::new())
+                });
+                entry.1.push_str(&tu.input);
+            }
+            Event::ContextUsage(cu) => {
+                let window = get_context_window_size(model);
+                turn.context_input_tokens =
+                    Some((cu.context_usage_percentage * (window as f64) / 100.0) as i32);
+                if cu.context_usage_percentage >= 100.0 {
+                    turn.stop_reason = Some("model_context_window_exceeded".to_string());
+                }
+            }
+            Event::Exception { exception_type, .. } => {
+                if exception_type == "ContentLengthExceededException" {
+                    turn.stop_reason = Some("max_tokens".to_string());
+                }
+            }
+            _ => {}
+        }
+    }
+
+    for id in order {
+        let (name, buf) = buffers.remove(&id).unwrap_or_default();
+        let input = if buf.is_empty() {
+            json!({})
+        } else {
+            serde_json::from_str(&buf).unwrap_or_else(|e| {
+                tracing::warn!("工具输入 JSON 解析失败: {}, tool_use_id: {}", e, id);
+                json!({})
+            })
+        };
+        let name = tool_name_map.get(&name).cloned().unwrap_or(name);
+        turn.tool_calls.push(ToolCall { id, name, input });
+    }
+    turn
+}
+
+fn search_query(call: &ToolCall) -> Option<String> {
+    call.input
+        .get("query")
+        .and_then(|q| q.as_str())
+        .map(|q| q.trim().to_string())
+        .filter(|q| !q.is_empty())
+}
+
+/// 回合循环本体。第一轮的上游响应由调用方先拿到（以便错误能映射成 HTTP 状态码）。
+async fn run_loop(
+    provider: Arc<KiroProvider>,
+    mut payload: MessagesRequest,
+    first: reqwest::Response,
+    mut tool_name_map: HashMap<String, String>,
+    extract_thinking: bool,
+    estimated_input: i32,
+) -> LoopOutput {
+    let max_uses = websearch::server_web_search_max_uses(&payload)
+        .unwrap_or(DEFAULT_MAX_USES)
+        .clamp(1, HARD_MAX_USES);
+    let mut out = LoopOutput {
+        content: Vec::new(),
+        stop_reason: "end_turn".to_string(),
+        input_tokens: estimated_input,
+        output_tokens: 0,
+        searches: 0,
+    };
+    let mut pending = Some(first);
+    let mut finished = false;
+
+    for round in 0..MAX_ROUNDS {
+        let response = match pending.take() {
+            Some(r) => r,
+            None => {
+                let (body, map) = match build_body(&payload) {
+                    Ok(x) => x,
+                    Err(_) => {
+                        push_note(&mut out, "(Failed to continue after web search.)");
+                        break;
+                    }
+                };
+                tool_name_map = map;
+                match provider.call_api(&body).await {
+                    Ok(r) => r,
+                    Err(e) => {
+                        tracing::warn!(round, "搜索回合续调上游失败: {}", e);
+                        push_note(&mut out, "(The model call after web search failed; partial results above.)");
+                        break;
+                    }
+                }
+            }
+        };
+        let bytes = match response.bytes().await {
+            Ok(b) => b,
+            Err(e) => {
+                tracing::warn!(round, "读取搜索回合响应失败: {}", e);
+                push_note(&mut out, "(Reading the model response failed.)");
+                break;
+            }
+        };
+        let turn = parse_turn(&bytes, &payload.model, &tool_name_map);
+        let step = apply_turn(&mut out, turn, extract_thinking, max_uses);
+
+        match step {
+            Step::Done => {
+                finished = true;
+                break;
+            }
+            Step::Searched { searches, assistant_blocks, user_results } => {
+                let results = futures::future::join_all(searches.iter().map(|s| {
+                    let provider = provider.clone();
+                    let query = s.query.clone();
+                    async move {
+                        match query {
+                            Some(q) => Some(websearch::run_search(&provider, &q).await),
+                            None => None,
+                        }
+                    }
+                }))
+                .await;
+                let mut user_results = user_results;
+                for (s, r) in searches.iter().zip(results) {
+                    let text = match (&s.query, r) {
+                        (Some(q), Some((srv_id, res))) => {
+                            let (a, b) = websearch::build_server_blocks(&srv_id, q, &res);
+                            out.content.push(a);
+                            out.content.push(b);
+                            websearch::format_results_for_model(q, &res)
+                        }
+                        _ => s.refusal.clone(),
+                    };
+                    user_results.push(json!({
+                        "type": "tool_result",
+                        "tool_use_id": s.call_id,
+                        "content": text
+                    }));
+                }
+                payload.messages.push(Message {
+                    role: "assistant".to_string(),
+                    content: Value::Array(assistant_blocks),
+                });
+                payload.messages.push(Message {
+                    role: "user".to_string(),
+                    content: Value::Array(user_results),
+                });
+                // 只在第一轮尊重客户端的 tool_choice（例如强制搜索），否则会每轮都被逼着搜
+                payload.tool_choice = None;
+            }
+            Step::SearchedThenClientTools { searches } => {
+                // 同一轮里既搜索又调客户端工具：搜索照常执行并以服务端块交给客户端，
+                // 客户端工具 tool_use 已在 out.content 里，本轮以 tool_use 结束（下一轮历史会带回搜索结果）
+                let results = futures::future::join_all(searches.iter().map(|s| {
+                    let provider = provider.clone();
+                    let query = s.query.clone();
+                    async move {
+                        match query {
+                            Some(q) => Some(websearch::run_search(&provider, &q).await),
+                            None => None,
+                        }
+                    }
+                }))
+                .await;
+                let mut blocks = Vec::new();
+                for (s, r) in searches.iter().zip(results) {
+                    if let (Some(q), Some((srv_id, res))) = (&s.query, r) {
+                        let (a, b) = websearch::build_server_blocks(&srv_id, q, &res);
+                        blocks.push(a);
+                        blocks.push(b);
+                    }
+                }
+                // 服务端块插在客户端 tool_use 之前，符合"先搜后调工具"的阅读顺序
+                let first_tool = out
+                    .content
+                    .iter()
+                    .position(|b| b.get("type").and_then(|t| t.as_str()) == Some("tool_use"))
+                    .unwrap_or(out.content.len());
+                drop(out.content.splice(first_tool..first_tool, blocks));
+                finished = true;
+                break;
+            }
+        }
+    }
+
+    if !finished {
+        tracing::warn!(searches = out.searches, "搜索回合达到轮数上限，提前结束");
+        if !out
+            .content
+            .iter()
+            .any(|b| b.get("type").and_then(|t| t.as_str()) == Some("text"))
+        {
+            push_note(&mut out, "(Stopped after the maximum number of web search rounds.)");
+        }
+    }
+    out
+}
+
+fn push_note(out: &mut LoopOutput, note: &str) {
+    out.content.push(json!({"type": "text", "text": note}));
+}
+
+#[derive(Debug)]
+pub(crate) struct PlannedSearch {
+    pub call_id: String,
+    /// None = 不执行（缺 query 或超出 max_uses），tool_result 用 refusal
+    pub query: Option<String>,
+    pub refusal: String,
+}
+
+#[derive(Debug)]
+pub(crate) enum Step {
+    /// 模型给出了回答或只调了客户端工具：结束
+    Done,
+    /// 模型只调了搜索：执行后续调下一轮
+    Searched {
+        searches: Vec<PlannedSearch>,
+        assistant_blocks: Vec<Value>,
+        user_results: Vec<Value>,
+    },
+    /// 模型同一轮既搜索又调客户端工具：执行搜索后结束
+    SearchedThenClientTools { searches: Vec<PlannedSearch> },
+}
+
+/// 把一轮产出并入输出，并决定下一步（纯函数，便于单测）
+pub(crate) fn apply_turn(out: &mut LoopOutput, turn: Turn, extract_thinking: bool, max_uses: i32) -> Step {
+    if let Some(t) = turn.context_input_tokens {
+        out.input_tokens = t;
+    }
+    if let Some(sr) = turn.stop_reason.clone() {
+        out.stop_reason = sr;
+    }
+
+    let (thinking, text) = if extract_thinking {
+        extract_thinking_from_complete_text(&turn.text)
+    } else {
+        (None, turn.text.clone())
+    };
+
+    let mut assistant_blocks = Vec::new();
+    if let Some(th) = thinking.filter(|t| !t.is_empty()) {
+        out.output_tokens += token::count_tokens(&th) as i32;
+        out.content.push(json!({"type": "thinking", "thinking": th}));
+        assistant_blocks.push(json!({"type": "thinking", "thinking": th}));
+    }
+    if !text.trim().is_empty() {
+        out.output_tokens += token::count_tokens(&text) as i32;
+        out.content.push(json!({"type": "text", "text": text}));
+        assistant_blocks.push(json!({"type": "text", "text": text}));
+    }
+
+    let (search_calls, client_calls): (Vec<_>, Vec<_>) = turn
+        .tool_calls
+        .into_iter()
+        .partition(|c| c.name == websearch::WEB_SEARCH_TOOL_NAME);
+
+    for c in &client_calls {
+        out.output_tokens += (serde_json::to_string(&c.input).unwrap_or_default().len() as i32 + 3) / 4;
+        out.content.push(json!({
+            "type": "tool_use",
+            "id": c.id,
+            "name": c.name,
+            "input": c.input
+        }));
+    }
+    if !client_calls.is_empty() {
+        out.stop_reason = "tool_use".to_string();
+    }
+
+    if search_calls.is_empty() {
+        return Step::Done;
+    }
+    // 上游说输出被截断 / 上下文已满：不再续调
+    if turn.stop_reason.is_some() {
+        return Step::Done;
+    }
+
+    let mut searches = Vec::new();
+    for c in &search_calls {
+        let query = search_query(c);
+        let (query, refusal) = match query {
+            None => (None, "Error: web_search requires a non-empty \"query\" string.".to_string()),
+            Some(_) if out.searches >= max_uses => (
+                None,
+                format!(
+                    "Web search limit reached ({} searches). Answer now using the information already gathered.",
+                    max_uses
+                ),
+            ),
+            Some(q) => {
+                out.searches += 1;
+                (Some(q), String::new())
+            }
+        };
+        searches.push(PlannedSearch { call_id: c.id.clone(), query, refusal });
+        assistant_blocks.push(json!({
+            "type": "tool_use",
+            "id": c.id,
+            "name": websearch::WEB_SEARCH_TOOL_NAME,
+            "input": c.input
+        }));
+    }
+
+    if !client_calls.is_empty() {
+        return Step::SearchedThenClientTools { searches };
+    }
+    Step::Searched { searches, assistant_blocks, user_results: Vec::new() }
+}
+
+fn usage_json(out: &LoopOutput) -> Value {
+    json!({
+        "input_tokens": out.input_tokens,
+        "output_tokens": out.output_tokens.max(1),
+        "server_tool_use": {"web_search_requests": out.searches}
+    })
+}
+
+pub(crate) fn to_message_json(message_id: &str, model: &str, out: &LoopOutput) -> Value {
+    json!({
+        "id": message_id,
+        "type": "message",
+        "role": "assistant",
+        "content": out.content,
+        "model": model,
+        "stop_reason": out.stop_reason,
+        "stop_sequence": null,
+        "usage": usage_json(out)
+    })
+}
+
+fn message_start_event(message_id: &str, model: &str, input_tokens: i32) -> SseEvent {
+    SseEvent::new(
+        "message_start",
+        json!({
+            "type": "message_start",
+            "message": {
+                "id": message_id,
+                "type": "message",
+                "role": "assistant",
+                "content": [],
+                "model": model,
+                "stop_reason": null,
+                "stop_sequence": null,
+                "usage": {"input_tokens": input_tokens, "output_tokens": 1}
+            }
+        }),
+    )
+}
+
+/// 内容块 → SSE 事件（不含 message_start）
+pub(crate) fn content_sse_events(out: &LoopOutput) -> Vec<SseEvent> {
+    let mut events = Vec::new();
+    for (i, block) in out.content.iter().enumerate() {
+        let index = i as i32;
+        let ty = block.get("type").and_then(|t| t.as_str()).unwrap_or("");
+        let (start_block, delta) = match ty {
+            "text" => (
+                json!({"type": "text", "text": ""}),
+                Some(json!({"type": "text_delta", "text": block["text"]})),
+            ),
+            "thinking" => (
+                json!({"type": "thinking", "thinking": ""}),
+                Some(json!({"type": "thinking_delta", "thinking": block["thinking"]})),
+            ),
+            "tool_use" => (
+                json!({"type": "tool_use", "id": block["id"], "name": block["name"], "input": {}}),
+                Some(json!({
+                    "type": "input_json_delta",
+                    "partial_json": serde_json::to_string(&block["input"]).unwrap_or_else(|_| "{}".to_string())
+                })),
+            ),
+            // server_tool_use / web_search_tool_result：整块放在 content_block_start 里一次给全
+            _ => (block.clone(), None),
+        };
+        events.push(SseEvent::new(
+            "content_block_start",
+            json!({"type": "content_block_start", "index": index, "content_block": start_block}),
+        ));
+        if let Some(d) = delta {
+            events.push(SseEvent::new(
+                "content_block_delta",
+                json!({"type": "content_block_delta", "index": index, "delta": d}),
+            ));
+        }
+        events.push(SseEvent::new(
+            "content_block_stop",
+            json!({"type": "content_block_stop", "index": index}),
+        ));
+    }
+    events.push(SseEvent::new(
+        "message_delta",
+        json!({
+            "type": "message_delta",
+            "delta": {"stop_reason": out.stop_reason, "stop_sequence": null},
+            "usage": usage_json(out)
+        }),
+    ));
+    events.push(SseEvent::new("message_stop", json!({"type": "message_stop"})));
+    events
+}
+
+fn ping_bytes() -> Bytes {
+    Bytes::from("event: ping\ndata: {\"type\": \"ping\"}\n\n")
+}
+
+/// message_start → 等结果期间 ping → 一次性发完内容
+fn buffered_sse(
+    start: SseEvent,
+    rx: tokio::sync::oneshot::Receiver<LoopOutput>,
+) -> impl Stream<Item = Result<Bytes, Infallible>> {
+    let head = stream::iter(vec![Ok::<Bytes, Infallible>(Bytes::from(start.to_sse_string()))]);
+    let mut ticker = interval(Duration::from_secs(PING_INTERVAL_SECS));
+    ticker.reset(); // 第一次 tick 不立即触发
+    let rest = stream::unfold((Some(rx), ticker), |(rx, mut ticker)| async move {
+        let mut rx = rx?;
+        tokio::select! {
+            biased;
+            res = &mut rx => {
+                let events = match res {
+                    Ok(out) => content_sse_events(&out),
+                    Err(_) => {
+                        tracing::error!("搜索回合任务异常退出");
+                        content_sse_events(&LoopOutput {
+                            content: vec![json!({"type": "text", "text": "(Internal error during web search.)"})],
+                            stop_reason: "end_turn".to_string(),
+                            input_tokens: 0,
+                            output_tokens: 1,
+                            searches: 0,
+                        })
+                    }
+                };
+                let bytes: Vec<Result<Bytes, Infallible>> = events
+                    .into_iter()
+                    .map(|e| Ok(Bytes::from(e.to_sse_string())))
+                    .collect();
+                Some((stream::iter(bytes), (None, ticker)))
+            }
+            _ = ticker.tick() => {
+                Some((stream::iter(vec![Ok(ping_bytes())]), (Some(rx), ticker)))
+            }
+        }
+    })
+    .flatten();
+    head.chain(rest)
+}
