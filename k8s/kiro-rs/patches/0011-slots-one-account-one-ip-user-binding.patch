+      <div className='flex flex-wrap items-center gap-2'>
+      <Input className='w-full max-w-md' placeholder='key 别名前缀，逗号分隔；留空 = 全员' value={text} onChange={(e) => setText(e.target.value)} />
+      <Button size='sm' onClick={save} disabled={isPending}>保存</Button>
+      <span className='text-xs text-muted-foreground'>{data && data.length ? `当前只灰度 ${data.length} 个前缀` : '当前：全员'}</span>
+      </div>
+    </div>
+  )
+}
