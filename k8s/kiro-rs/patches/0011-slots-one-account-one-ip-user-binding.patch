+//! 按 kiro 账户统计用量：每个号 × 模型 × 北京日 记 请求数 / 成功 / 失败 / 输入 token / 输出 token。
+//!
+//! - 计数点在 provider 层：响应流读完（或出错）时，从 Kiro 事件流里直接读出
+//!   上下文百分比（→ 输入 token）和回复文本 / 工具参数（→ 输出 token 估算），不依赖 LiteLLM。
+//! - 内存累加，周期落盘到 kiro_account_usage.json；只保留最近 RETAIN_DAYS 天。
+//! - 天按北京时间（UTC+8）切，和额度重置、看板口径一致。
+
+use std::collections::BTreeMap;
+
+use serde::{Deserialize, Serialize};
+
+pub const RETAIN_DAYS: i64 = 8;
+
+#[derive(Debug, Default, Clone, Copy, Serialize, Deserialize, PartialEq)]
+#[serde(rename_all = "camelCase")]
+pub struct UsageCell {
+    pub requests: u64,
+    pub success: u64,
+    pub failed: u64,
+    pub input_tokens: u64,
+    pub output_tokens: u64,
+}
+
+impl UsageCell {
+    pub fn add(&mut self, o: &UsageCell) {
+        self.requests += o.requests;
+        self.success += o.success;
+        self.failed += o.failed;
+        self.input_tokens += o.input_tokens;
+        self.output_tokens += o.output_tokens;
+    }
+}
+
+/// 日期(YYYY-MM-DD 北京) → 号 id → 模型 → 计数
+#[derive(Debug, Default, Clone, Serialize, Deserialize)]
+pub struct AccountUsage {
+    #[serde(default)]
+    pub days: BTreeMap<String, BTreeMap<u64, BTreeMap<String, UsageCell>>>,
+    /// 用量统计开始记录的时刻（unix 秒，第一次落盘时写入）
+    #[serde(default)]
+    pub since: Option<i64>,
+    /// 号 id → 统计开始那一刻它的「历史累计成功」（用来把历史累计拆成「统计前 + 统计后」）
+    #[serde(default)]
+    pub baseline: BTreeMap<u64, u64>,
+}
+
+pub fn beijing_day(unix_secs: i64) -> String {
+    let dt = chrono::DateTime::from_timestamp(unix_secs + 8 * 3600, 0).unwrap_or_default();
+    dt.format("%Y-%m-%d").to_string()
+}
+
+impl AccountUsage {
+    /// 第一次见到某个号时记下它当时的历史累计成功；已记过的不改
+    pub fn ensure_baseline(&mut self, now_unix: i64, account: u64, lifetime_success: u64) {
+        self.since.get_or_insert(now_unix);
+        self.baseline.entry(account).or_insert(lifetime_success);
+    }
+
+    pub fn record(&mut self, now_unix: i64, account: u64, model: &str, ok: bool, input: u64, output: u64) {
+        let day = beijing_day(now_unix);
+        let cell = self.days.entry(day).or_default().entry(account).or_default().entry(model.to_string()).or_default();
+        cell.requests += 1;
+        if ok { cell.success += 1 } else { cell.failed += 1 }
+        cell.input_tokens += input;
+        cell.output_tokens += output;
+        let cutoff = beijing_day(now_unix - RETAIN_DAYS * 86400);
+        self.days.retain(|d, _| d.as_str() > cutoff.as_str());
+    }
+
+    /// 某个号：today = 今天；last_days = 最近 N 天（含今天）。返回 模型 → 计数，按请求数降序
+    pub fn for_account(&self, account: u64, now_unix: i64, last_days: i64) -> Vec<(String, UsageCell)> {
+        let from = beijing_day(now_unix - (last_days - 1).max(0) * 86400);
+        let mut agg: BTreeMap<String, UsageCell> = BTreeMap::new();
+        for (d, accts) in &self.days {
+            if d.as_str() < from.as_str() { continue }
+            if let Some(models) = accts.get(&account) {
+                for (m, c) in models { agg.entry(m.clone()).or_default().add(c) }
+            }
+        }
+        let mut v: Vec<_> = agg.into_iter().collect();
+        v.sort_by(|a, b| b.1.requests.cmp(&a.1.requests));
+        v
+    }
+
+    /// 所有号在窗口内的合计（号 → 合计），给账户列表显示用
+    pub fn totals(&self, now_unix: i64, last_days: i64) -> BTreeMap<u64, UsageCell> {
+        let from = beijing_day(now_unix - (last_days - 1).max(0) * 86400);
+        let mut out: BTreeMap<u64, UsageCell> = BTreeMap::new();
+        for (d, accts) in &self.days {
+            if d.as_str() < from.as_str() { continue }
+            for (a, models) in accts {
+                for c in models.values() { out.entry(*a).or_default().add(c) }
+            }
+        }
+        out
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn record_and_query_today_and_week() {
+        let mut u = AccountUsage::default();
+        let t = 1_800_000_000; // 某个北京时间
+        u.record(t, 8, "claude-opus-5.5", true, 1000, 50);
+        u.record(t, 8, "claude-opus-5.5", false, 0, 0);
+        u.record(t - 3 * 86400, 8, "claude-sonnet-5.5", true, 200, 10);
+        u.record(t, 9, "claude-opus-5.5", true, 7, 7);
+        let today = u.for_account(8, t, 1);
+        assert_eq!(today.len(), 1);
+        assert_eq!(today[0].1, UsageCell { requests: 2, success: 1, failed: 1, input_tokens: 1000, output_tokens: 50 });
+        let week = u.for_account(8, t, 7);
+        assert_eq!(week.len(), 2, "7 天含 3 天前的 sonnet");
+        assert_eq!(u.totals(t, 7)[&8].requests, 3);
+        assert_eq!(u.totals(t, 7)[&9].requests, 1, "别的号不混进来");
+    }
+
+    #[test]
+    fn old_days_pruned() {
+        let mut u = AccountUsage::default();
+        let t = 1_800_000_000;
+        u.record(t - 20 * 86400, 1, "m", true, 1, 1);
+        u.record(t, 1, "m", true, 1, 1);
+        assert_eq!(u.days.len(), 1, "超过保留期的天被删");
+    }
+
+    #[test]
+    fn beijing_day_boundary() {
+        // 2026-10-24 16:00 UTC = 北京 10-25 00:00
+        let ts = chrono::DateTime::parse_from_rfc3339("2026-10-24T16:00:00Z").unwrap().timestamp();
+        assert_eq!(beijing_day(ts), "2026-10-25");
+        assert_eq!(beijing_day(ts - 1), "2026-10-24");
+    }
+}
