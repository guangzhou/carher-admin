+/// `find_real_thinking_end_tag` 命中后，从 `end_pos` 起需要剥离的字节数：
+/// `</thinking>` 加上其后的 `\n\n`；没有 `\n\n` 时（行首标签直接接正文）至多剥离一个 `\n`。
+fn thinking_end_tag_strip_len(buffer: &str, end_pos: usize) -> usize {
+    let after = &buffer[end_pos + "</thinking>".len()..];
+    let newlines = if after.starts_with("\n\n") {
+        2
+    } else if after.starts_with('\n') {
+        1
+    } else {
+        0
+    };
+    "</thinking>".len() + newlines
+}
