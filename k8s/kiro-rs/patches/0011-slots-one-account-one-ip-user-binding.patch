+        <DropdownMenuItem onSelect={onUsage}><BarChart3 className="h-4 w-4" />用量统计</DropdownMenuItem>
+        <DropdownMenuSeparator />
+        <DropdownMenuItem disabled={c.priority === 0} onSelect={() => done(setPriority.mutateAsync({ id: c.id, priority: Math.max(0, c.priority - 1) }))}>
+          <ChevronUp className="h-4 w-4" />提高优先级
+        </DropdownMenuItem>
+        <DropdownMenuItem onSelect={() => done(setPriority.mutateAsync({ id: c.id, priority: c.priority + 1 }))}>
+          <ChevronDown className="h-4 w-4" />降低优先级
+        </DropdownMenuItem>
+        <DropdownMenuItem disabled={c.disabled || c.authMethod === 'api_key'} onSelect={() => done(refresh.mutateAsync(c.id))}>
