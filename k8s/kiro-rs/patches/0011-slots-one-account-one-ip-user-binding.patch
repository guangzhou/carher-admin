+        assert_eq!(s.effective_limit(), 4);
+        let mut s2 = SlotState::new(0, 8);
+        let off = LimitParams { auto_tune: false, ..p() };
+        s2.on_429(&off, Instant::now(), None);
+        assert_eq!(s2.limit, 8);
+    }
