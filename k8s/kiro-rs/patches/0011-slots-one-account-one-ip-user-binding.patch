+    /// 按槽位配置对齐运行时：删掉的槽放号回冷备（清代理），新槽补号，所有在槽号重写代理
+    fn reconcile_slots(&self, cfgs: &[crate::model::config::SlotConfig]) -> anyhow::Result<()> {
+        let names: Vec<String> = cfgs.iter().map(|c| c.name.clone()).collect();
+        let start = self.slot_limits.lock().start;
+        let released = self.slots.lock().reconcile(&names, start);
+        if !released.is_empty() {
+            let originals = self.slots.lock().file.original_proxy.clone();
+            let mut entries = self.entries.lock();
+            for e in entries.iter_mut().filter(|e| released.contains(&e.id)) {
+                restore_proxy(&mut e.credentials, &originals);
+            }
+            tracing::info!("删槽：号 {:?} 回冷备", released);
+        }
+        for i in 0..names.len() {
+            let id = self.slots.lock().states[i].account_id;
+            let alive = id.is_some_and(|id| self.entries.lock().iter().any(|e| e.id == id && !e.disabled));
+            match (alive, id) {
+                (true, Some(id)) => self.stamp_slot_proxy(i, id),
+                _ => {
+                    if self.fill_slot(i, "fill").is_none() {
+                        tracing::warn!("槽位 {} 没有可补的冷备号", names[i]);
+                    }
+                }
+            }
+        }
+        if let Err(e) = self.persist_credentials() {
+            tracing::warn!("槽位对齐后回写凭据失败: {}", e);
+        }
+        self.persist_slots();
+        self.slot_notify.notify_waiters();
+        Ok(())
+    }
