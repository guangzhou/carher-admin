+    /// Admin：锁定某槽上限（None = 解锁，回到自动调节）
+    pub fn set_slot_lock(&self, slot: usize, limit: Option<u32>) -> anyhow::Result<()> {
+        let p = *self.slot_limits.lock();
+        if let Some(l) = limit {
+            if l < 1 || l > 64 {
+                anyhow::bail!("锁定值需在 1~64");
+            }
+        }
+        let mut rt = self.slots.lock();
+        let st = rt.states.get_mut(slot).ok_or_else(|| anyhow::anyhow!("槽位 {} 不存在", slot))?;
+        st.locked_limit = limit;
+        let _ = p;
+        drop(rt);
+        self.slot_notify.notify_waiters();
+        Ok(())
+    }
