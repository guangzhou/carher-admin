+/// Kiro API tool_use_id 最大长度（实测 64 过、65 起 400 Invalid tool use format）
+const TOOL_USE_ID_MAX_LEN: usize = 64;
+
+/// 把 tool_use_id 规整成 Kiro 接受的形状：只含 `[A-Za-z0-9_-]` 且 ≤ 64 字符
+/// （实测换行/空格/点/冒号/制表符/中文、或超过 64 字符，整单 400 Invalid tool use format）。
+///
+/// 客户端（如 Cursor 跨模型续聊）会把别家模型的 id 带进历史（`call-<uuid>-N\nfc_…` 共 81 字符），
+/// 原样转发整单被拒 ⇒ LiteLLM 兜底到别的模型。
+/// 合法 id 原样不动；不合法的 ⇒ 非法字符换 `_`、截前缀 + `_` + 原 id 的 8 位 SHA256 hex
+/// （按原 id 算哈希，只差非法字符或尾巴的两个 id 不会撞）。
+/// tool_use 与 tool_result 两侧走同一函数，配对不变；只改历史里的 id，
+/// 本轮新生成的 id 由上游下发，客户端无需反向映射。
+fn normalize_tool_use_id(id: &str) -> String {
+    let valid_char = |c: char| c.is_ascii_alphanumeric() || c == '_' || c == '-';
+    if id.len() <= TOOL_USE_ID_MAX_LEN && id.chars().all(valid_char) {
+        return id.to_string();
+    }
+    let mut hasher = Sha256::new();
+    hasher.update(id.as_bytes());
+    let hash_hex = format!("{:x}", hasher.finalize());
+    let hash_suffix = &hash_hex[..8];
+    // 55 prefix + 1 underscore + 8 hash = 64（替换后全是 ASCII，按字符截即按字节截）
+    let prefix: String = id
+        .chars()
+        .map(|c| if valid_char(c) { c } else { '_' })
+        .take(TOOL_USE_ID_MAX_LEN - 1 - 8)
+        .collect();
+    format!("{}_{}", prefix, hash_suffix)
+}
