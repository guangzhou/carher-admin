+    /// 启动：读 kiro_slots.json，按当前槽位配置对齐
+    fn init_slots(&self) {
+        let file: crate::kiro::slots::SlotsFile = self
+            .slots_path()
+            .and_then(|p| std::fs::read_to_string(p).ok())
+            .and_then(|c| serde_json::from_str(&c).ok())
+            .unwrap_or_default();
+        let start = self.slot_limits.lock().start;
+        let cfgs = self.slot_configs.lock().clone();
+        let names: Vec<String> = cfgs.iter().map(|c| c.name.clone()).collect();
+        let mut file = file;
+        // 旧版本把「停号 / 补号换下」也记成了退役；只保留额度用尽 / 被限制两种
+        file.retired.retain(|_, why| why == "quota" || why == "restricted");
+        *self.slots.lock() = crate::kiro::slots::SlotsRuntime::new(&names, start, file);
+        let gone = std::mem::take(&mut self.slots.lock().offline_released);
+        if !gone.is_empty() {
+            let originals = self.slots.lock().file.original_proxy.clone();
+            let mut entries = self.entries.lock();
+            for e in entries.iter_mut().filter(|e| gone.contains(&e.id)) {
+                restore_proxy(&mut e.credentials, &originals);
+            }
+            tracing::info!("停机期间删除的槽：号 {:?} 回冷备", gone);
+        }
+        // 只有槽位模式才把槽位代理写进号；其它模式槽位配置只是存着，不碰号
+        if self.load_balancing_mode.lock().as_str() == "slots" {
+            if let Err(e) = self.reconcile_slots(&cfgs) {
+                tracing::warn!("槽位初始化失败: {}", e);
+            }
+        }
+    }
