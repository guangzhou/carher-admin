+    async def _upstream_confirms_near_zero_traffic(
+        self,
+        backend: LiteLLMBackend,
+        start_date: str,
+        end_date: str,
+        collected_requests: int,
+    ) -> bool:
+        """上游全局汇总能否证明「这段时间本来就几乎没流量」。
+
+        只认上游 /user/daily/activity/aggregated 的 metadata（与看板顶部实时总数同源）：
+        全局请求数 ≤ 每天 USAGE_SYNC_SPARSE_MAX_DAILY_REQUESTS（默认 100）才放行。
+        上游有量而按人回退漏了的情况（门禁真正要挡的）全局数会远超这个阈值，照旧拦下；
+        放行时最多漏掉阈值以内的零头。任何异常、缺字段都返回 False，维持原来的「判不完整」。
+        """
+        max_daily = max(0, int(os.getenv("USAGE_SYNC_SPARSE_MAX_DAILY_REQUESTS", "100")))
+        if max_daily <= 0:
+            return False
+        request = getattr(self.client, "request_backend", None)
+        if not callable(request):
+            return False
+        try:
+            from .litellm_client import usage_timezone_offset_minutes
+
+            payload = await request(
+                backend, "GET", "/user/daily/activity/aggregated",
+                params={"start_date": start_date, "end_date": end_date, "timezone": usage_timezone_offset_minutes()},
+            )
+            metadata = payload.get("metadata") if isinstance(payload, dict) else None
+            if not isinstance(metadata, dict) or metadata.get("total_api_requests") is None:
+                return False
+            upstream_requests = int(metadata.get("total_api_requests") or 0)
+        except Exception:
+            logger.exception("sparse fallback upstream check failed backend=%s", backend.id)
+            return False
+        days = (date.fromisoformat(end_date) - date.fromisoformat(start_date)).days + 1
+        confirmed = upstream_requests <= max_daily * max(1, days)
+        logger.info(
+            "sparse fallback upstream check backend=%s start=%s end=%s upstream_requests=%s collected_requests=%s confirmed=%s",
+            backend.id, start_date, end_date, upstream_requests, collected_requests, confirmed,
+        )
+        return confirmed
+
