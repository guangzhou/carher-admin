+pub async fn set_slot_lock(
+    State(state): State<AdminState>,
+    axum::extract::Path(slot): axum::extract::Path<usize>,
+    Json(payload): Json<SlotLockRequest>,
+) -> impl IntoResponse {
+    match state.service.set_slot_lock(slot, payload.limit) {
+        Ok(()) => Json(serde_json::json!({"ok": true})).into_response(),
