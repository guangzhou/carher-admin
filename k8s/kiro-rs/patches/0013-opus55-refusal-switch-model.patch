+/// opus-5.5 安全审查兜底：上游拦下后什么都不发（200 + 零内容），客户端只看到空白。
+/// 号没被限时换成配置里的备用模型重答一次，并在回答末尾告诉用户；同一会话之后直接用备用模型（同 Cursor）。
+const REFUSAL_SWITCH_NOTICE: &str = "\n\n---\n> ⚠️ Claude Opus 5.5 对这条消息触发了安全审查，没有作答（不是网络或服务故障）。本条已自动改由 {to} 回答，本会话接下来也会继续用 {to}；想用回 Opus 5.5 请新开一个会话。";
+const REFUSAL_BOTH_NOTICE: &str = "⚠️ 这条消息触发了 Claude 的安全审查：Claude Opus 5.5 和自动改用的 {to} 都没有作答（不是网络或服务故障）。请换个说法，或新开一个会话再试。";
+/// 同一会话粘在备用模型上多久
+const REFUSAL_STICKY_SECS: i64 = 6 * 3600;
+const REFUSAL_STICKY_MAX: usize = 5000;
+
+/// 上游模型 id ⇒ 展示名（只用于提示文案）
+fn model_display(id: &str) -> String {
+    match id {
+        "claude-opus-4.8" => "Claude Opus 4.8".into(),
+        "claude-opus-4.6" => "Claude Opus 4.6".into(),
+        "claude-opus-5" => "Claude Opus 5".into(),
+        other => other.to_string(),
+    }
+}
+
+/// 把请求体里所有 `modelId == from` 改成 `to`（当前消息 + 历史）。没改到任何一处返回 None。
+fn rewrite_model_id(body: &str, from: &str, to: &str) -> Option<String> {
+    fn walk(v: &mut serde_json::Value, from: &str, to: &str, n: &mut usize) {
+        match v {
+            serde_json::Value::Object(m) => {
+                for (k, x) in m.iter_mut() {
+                    if k == "modelId" && x.as_str() == Some(from) {
+                        *x = serde_json::Value::String(to.to_string());
+                        *n += 1;
+                    } else {
+                        walk(x, from, to, n);
+                    }
+                }
+            }
+            serde_json::Value::Array(a) => a.iter_mut().for_each(|x| walk(x, from, to, n)),
+            _ => {}
+        }
+    }
+    let mut v: serde_json::Value = serde_json::from_str(body).ok()?;
+    let mut n = 0;
+    walk(&mut v, from, to, &mut n);
+    (n > 0).then(|| v.to_string())
+}
+
+fn conversation_id(body: &str) -> Option<String> {
+    let v: serde_json::Value = serde_json::from_str(body).ok()?;
+    v.pointer("/conversationState/conversationId")?.as_str().map(|s| s.to_string())
+}
+
+/// 合成一帧 Kiro assistantResponseEvent（下游 anthropic 层按普通文本处理，流式/非流式/思考模式都走原逻辑）
+fn kiro_text_frame(text: &str) -> Vec<u8> {
+    use crate::kiro::parser::crc::crc32;
+    let payload = serde_json::json!({ "content": text }).to_string();
+    let mut headers = Vec::new();
+    for (k, v) in [(":message-type", "event"), (":event-type", "assistantResponseEvent"), (":content-type", "application/json")] {
+        headers.push(k.len() as u8);
+        headers.extend_from_slice(k.as_bytes());
+        headers.push(7u8);
+        headers.extend_from_slice(&(v.len() as u16).to_be_bytes());
+        headers.extend_from_slice(v.as_bytes());
+    }
+    let total = 12 + headers.len() + payload.len() + 4;
+    let mut buf = Vec::with_capacity(total);
+    buf.extend_from_slice(&(total as u32).to_be_bytes());
+    buf.extend_from_slice(&(headers.len() as u32).to_be_bytes());
+    let pc = crc32(&buf[..8]);
+    buf.extend_from_slice(&pc.to_be_bytes());
+    buf.extend_from_slice(&headers);
+    buf.extend_from_slice(payload.as_bytes());
+    let mc = crc32(&buf);
+    buf.extend_from_slice(&mc.to_be_bytes());
+    buf
+}
+
+/// 在响应流末尾追加一段文本（放末尾而不是开头：开头会排到 thinking 块前面）
+fn append_text(resp: reqwest::Response, text: &str) -> reqwest::Response {
+    use futures::StreamExt;
+    let status = resp.status();
+    let headers = resp.headers().clone();
+    let tail = futures::stream::iter([Ok::<_, std::io::Error>(bytes::Bytes::from(kiro_text_frame(text)))]);
+    let s = resp.bytes_stream().map(|c| c.map_err(std::io::Error::other)).chain(tail);
+    let mut b = http::Response::builder().status(status);
+    if let Some(h) = b.headers_mut() {
+        *h = headers;
+    }
+    reqwest::Response::from(b.body(reqwest::Body::wrap_stream(s)).expect("rebuild response"))
+}
+
+/// 只有一段文本的 200 响应
+fn text_only_response(text: &str) -> reqwest::Response {
+    let body = reqwest::Body::from(kiro_text_frame(text));
+    reqwest::Response::from(http::Response::builder().status(200).body(body).expect("text response"))
+}
