+    async def _key_rollup_gap_rows(
+        self,
+        backend: LiteLLMBackend,
+        start_date: str,
+        end_date: str,
+        known_user_ids: set[str],
+        directory: dict[str, Any] | None,
+    ) -> list[dict[str, Any]]:
+        """Usage of keys the per-user fallback cannot see.
+
+        The fallback queries one LiteLLM_UserTable user at a time, so spend on
+        keys whose owner is empty or absent from that table never arrives
+        (2026-10-14: ~$58k / 30 days, mostly carher-hangzhou). Fill exactly
+        those keys from the global per-key rollup. Keys owned by a known user
+        are skipped, so nothing is counted twice. Rows are display-only
+        (``billing_eligible`` false); token mappings still decide billing.
+        """
+        loader = getattr(self.client, "key_rollup_rows", None)
+        if not callable(loader):
+            return []
+        try:
+            rollup, totals = await loader(start_date, end_date, backend)
+        except Exception:
+            logger.exception("usage key rollup failed backend=%s", backend.id)
+            return []
+        gap: list[dict[str, Any]] = []
+        for row in rollup:
+            owner = _text(row.get("keyOwnerUserId"))
+            if owner and owner in known_user_ids:
+                continue
+            alias = _text(row.get("keyAlias"))
+            if owner:
+                user_id = owner
+                resolved = self._apply_identity_directory(backend, owner, {"name": "", "email": ""}, directory)
+                name = _text(resolved.get("name")) or alias or owner
+                email = _email(resolved.get("email"))
+                email_source = _text(resolved.get("emailSource")) if email else ""
+            else:
+                user_id = f"key:{alias or _text(row.get('keyId'))[:12] or 'unknown'}"
+                name = alias or ("已删除的 key" if row.get("keyExists") is False else user_id)
+                email, email_source = "", ""
+            item = {
+                key: value
+                for key, value in row.items()
+                if key not in {"keyOwnerUserId", "keyTeamId", "keyExists"}
+            }
+            item.update({
+                "_userId": user_id,
+                "employeeEmail": email,
+                "employeeName": name,
+                "emailSource": email_source,
+                "attributionSource": "key_rollup",
+                "billingEligible": False,
+            })
+            if _text(row.get("keyTeamId")) and not _text(item.get("teamId")):
+                item["userTeamId"] = _text(row.get("keyTeamId"))
+            gap.append(item)
+        seen_requests = sum(int(r.get("requestCount") or 0) for r in rollup)
+        gap_requests = sum(int(r.get("requestCount") or 0) for r in gap)
+        upstream = int(totals.get("requestCount") or 0)
+        logger.info(
+            "usage key rollup backend=%s start=%s end=%s keys_gap_rows=%s gap_requests=%s rollup_requests=%s upstream_requests=%s complete=%s",
+            backend.id, start_date, end_date, len(gap), gap_requests, seen_requests, upstream, totals.get("complete"),
+        )
+        self._last_rollup_totals = {"backend": backend.id, "start": start_date, "end": end_date, **totals}
+        return gap
+
+    def _log_coverage_gap(self, backend_id: str, start_date: str, end_date: str, rows: list[dict[str, Any]]) -> None:
+        """Warn when published spend drifts from the upstream global rollup.
+
+        Spend, not request count: requests on models the catalog cannot name
+        are dropped by design and carry no cost.
+        """
+        totals = getattr(self, "_last_rollup_totals", None) or {}
+        if totals.get("backend") != backend_id or totals.get("start") != start_date or totals.get("end") != end_date:
+            return
+        upstream = float(totals.get("spend") or 0)
+        if upstream <= 0:
+            return
+        published = sum(float(row.get("spend") or 0) for row in rows)
+        gap_pct = 100.0 * (upstream - published) / upstream
+        level = logging.WARNING if abs(gap_pct) > float(os.getenv("USAGE_SYNC_COVERAGE_GAP_PCT", "1")) else logging.INFO
+        logger.log(
+            level,
+            "usage coverage gap backend=%s start=%s end=%s published_spend=%.2f upstream_spend=%.2f gap_pct=%.2f",
+            backend_id, start_date, end_date, published, upstream, gap_pct,
+        )
+
