+#[cfg(test)]
+mod empty_reply_tests {
+    use super::summarize_event_stream;
+    use super::{peek_for_content, Peeked};
+    use crate::kiro::parser::crc::crc32;
+
+    fn frame(event_type: &str, payload: &str) -> Vec<u8> {
+        let mut headers = Vec::new();
+        for (k, v) in [(":message-type", "event"), (":event-type", event_type), (":content-type", "application/json")] {
+            headers.push(k.len() as u8);
+            headers.extend_from_slice(k.as_bytes());
+            headers.push(7u8);
+            headers.extend_from_slice(&(v.len() as u16).to_be_bytes());
+            headers.extend_from_slice(v.as_bytes());
+        }
+        let total = 12 + headers.len() + payload.len() + 4;
+        let mut buf = Vec::new();
+        buf.extend_from_slice(&(total as u32).to_be_bytes());
+        buf.extend_from_slice(&(headers.len() as u32).to_be_bytes());
+        let pc = crc32(&buf[..8]);
+        buf.extend_from_slice(&pc.to_be_bytes());
+        buf.extend_from_slice(&headers);
+        buf.extend_from_slice(payload.as_bytes());
+        let mc = crc32(&buf);
+        buf.extend_from_slice(&mc.to_be_bytes());
+        buf
+    }
+
+    fn resp(chunks: Vec<Vec<u8>>) -> reqwest::Response {
+        let s = futures::stream::iter(chunks.into_iter().map(|c| Ok::<_, std::io::Error>(bytes::Bytes::from(c))));
+        reqwest::Response::from(http::Response::builder().status(200).body(reqwest::Body::wrap_stream(s)).unwrap())
+    }
+
+    #[tokio::test]
+    async fn empty_when_only_context_usage() {
+        let r = resp(vec![frame("contextUsageEvent", r#"{"contextUsagePercentage":1.0}"#)]);
+        match peek_for_content(r).await {
+            Peeked::Empty(r) => assert!(!r.bytes().await.unwrap().is_empty(), "空回复也原样保留字节"),
+            Peeked::Ready(_) => panic!("应判空"),
+        }
+    }
+
+    #[tokio::test]
+    async fn empty_when_zero_bytes() {
+        assert!(matches!(peek_for_content(resp(vec![])).await, Peeked::Empty(_)));
+    }
+
+    #[tokio::test]
+    async fn ready_and_lossless_when_text() {
+        let a = frame("assistantResponseEvent", r#"{"content":"Hi"}"#);
+        let b = frame("assistantResponseEvent", r#"{"content":" there"}"#);
+        let mut all = a.clone();
+        all.extend_from_slice(&b);
+        match peek_for_content(resp(vec![a, b])).await {
+            Peeked::Ready(r) => assert_eq!(r.bytes().await.unwrap().to_vec(), all, "已读+剩余逐字节不丢"),
+            Peeked::Empty(_) => panic!("有文本不应判空"),
+        }
+    }
+
+    #[tokio::test]
+    async fn ready_when_tool_use_only() {
+        let t = frame("toolUseEvent", r#"{"name":"Read","toolUseId":"t1","input":"{}"}"#);
+        assert!(matches!(peek_for_content(resp(vec![t])).await, Peeked::Ready(_)));
+    }
+
+    #[test]
+    fn summarize_classifies_text_empty_and_tool() {
+        let mut ok = frame("assistantResponseEvent", r#"{"content":"OK"}"#);
+        ok.extend(frame("contextUsageEvent", r#"{"contextUsagePercentage":1.0}"#));
+        assert_eq!(summarize_event_stream(&ok), ("OK".to_string(), 0, vec![]));
+        let empty = frame("contextUsageEvent", r#"{"contextUsagePercentage":1.0}"#);
+        let (t, n, e) = summarize_event_stream(&empty);
+        assert!(t.is_empty() && n == 0 && e.is_empty(), "静默空回复");
+        let tool = frame("toolUseEvent", r#"{"name":"Bash","toolUseId":"t1","input":"{}","stop":true}"#);
+        assert_eq!(summarize_event_stream(&tool).1, 1, "工具轮不算空");
+        let mut chunks = frame("toolUseEvent", r#"{"name":"Bash","toolUseId":"t1","input":"{\"comm"}"#);
+        chunks.extend(frame("toolUseEvent", r#"{"name":"Bash","toolUseId":"t1","input":"and\":\"ls\"}","stop":true}"#));
+        let sm = super::summarize_stream(&chunks);
