{
  "title": "LiteLLM 模型稳定性 (198)",
  "uid": "litellm-stability-198",
  "timezone": "Asia/Shanghai",
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "一、用户视角：真实失败率（重试+兜底全挂了才算失败）（已剔除探针流量）",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "全局用户真实失败率（当前时间范围）",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "100 * sum((\n  sum by (requested_model)(increase(litellm_proxy_failed_requests_metric_total[$__range]))\n  unless on(requested_model) label_replace(max by (model_id)(litellm_probe_target_info), \"requested_model\", \"$1\", \"model_id\", \"(.*)\")\n)) / clamp_min(sum((\n  sum by (requested_model)(increase(litellm_proxy_total_requests_metric_total[$__range]))\n  unless on(requested_model) label_replace(max by (model_id)(litellm_probe_target_info), \"requested_model\", \"$1\", \"model_id\", \"(.*)\")\n)), 1)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "总请求数",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        }
      },
      "options": {
        "colorMode": "none",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "sum((\n  sum by (requested_model)(increase(litellm_proxy_total_requests_metric_total[$__range]))\n  unless on(requested_model) label_replace(max by (model_id)(litellm_probe_target_info), \"requested_model\", \"$1\", \"model_id\", \"(.*)\")\n))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "用户真实失败数",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 11,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        }
      },
      "options": {
        "colorMode": "none",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "sum((\n  sum by (requested_model)(increase(litellm_proxy_failed_requests_metric_total[$__range]))\n  unless on(requested_model) label_replace(max by (model_id)(litellm_probe_target_info), \"requested_model\", \"$1\", \"model_id\", \"(.*)\")\n))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "重试/兜底救回来的次数（上游失败但用户没感觉）",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "description": "上游腿失败总数 − 用户真实失败数。这个数字越大，说明重试和 fallback 帮你挡掉了越多故障。",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "clamp_min(sum((\n  sum by (requested_model)(increase(litellm_deployment_failure_responses_total[$__range]))\n  unless on(requested_model) label_replace(max by (model_id)(litellm_probe_target_info), \"requested_model\", \"$1\", \"model_id\", \"(.*)\")\n)) - sum((\n  sum by (requested_model)(increase(litellm_proxy_failed_requests_metric_total[$__range]))\n  unless on(requested_model) label_replace(max by (model_id)(litellm_probe_target_info), \"requested_model\", \"$1\", \"model_id\", \"(.*)\")\n)), 0)"
        }
      ]
    },
    {
      "type": "table",
      "title": "各模型 用户真实失败率排行（点表头可排序）",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "description": "失败率 = 用户真实失败数 / 总请求数。requested_model 为空的那行是客户端没带模型名就被拒的请求。",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "失败率%"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 1
                    },
                    {
                      "color": "orange",
                      "value": 5
                    },
                    {
                      "color": "red",
                      "value": 20
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "sortBy": [
          {
            "displayName": "失败率%",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "format": "table",
          "expr": "(\n  sum by (requested_model)(increase(litellm_proxy_total_requests_metric_total[$__range]))\n  unless on(requested_model) label_replace(max by (model_id)(litellm_probe_target_info), \"requested_model\", \"$1\", \"model_id\", \"(.*)\")\n)"
        },
        {
          "refId": "B",
          "instant": true,
          "format": "table",
          "expr": "(\n  sum by (requested_model)(increase(litellm_proxy_failed_requests_metric_total[$__range]))\n  unless on(requested_model) label_replace(max by (model_id)(litellm_probe_target_info), \"requested_model\", \"$1\", \"model_id\", \"(.*)\")\n) or ((\n  sum by (requested_model)(increase(litellm_proxy_total_requests_metric_total[$__range]))\n  unless on(requested_model) label_replace(max by (model_id)(litellm_probe_target_info), \"requested_model\", \"$1\", \"model_id\", \"(.*)\")\n) * 0)"
        },
        {
          "refId": "C",
          "instant": true,
          "format": "table",
          "expr": "100 * ((\n  sum by (requested_model)(increase(litellm_proxy_failed_requests_metric_total[$__range]))\n  unless on(requested_model) label_replace(max by (model_id)(litellm_probe_target_info), \"requested_model\", \"$1\", \"model_id\", \"(.*)\")\n) or ((\n  sum by (requested_model)(increase(litellm_proxy_total_requests_metric_total[$__range]))\n  unless on(requested_model) label_replace(max by (model_id)(litellm_probe_target_info), \"requested_model\", \"$1\", \"model_id\", \"(.*)\")\n) * 0)) / clamp_min((\n  sum by (requested_model)(increase(litellm_proxy_total_requests_metric_total[$__range]))\n  unless on(requested_model) label_replace(max by (model_id)(litellm_probe_target_info), \"requested_model\", \"$1\", \"model_id\", \"(.*)\")\n), 1)"
        },
        {
          "refId": "D",
          "instant": true,
          "format": "table",
          "expr": "histogram_quantile(0.95, (\n  sum by (le, requested_model)(rate(litellm_request_total_latency_metric_bucket[$__range]))\n  unless on(requested_model) label_replace(max by (model_id)(litellm_probe_target_info), \"requested_model\", \"$1\", \"model_id\", \"(.*)\")\n))"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "requested_model",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true
            },
            "renameByName": {
              "requested_model": "模型",
              "Value #A": "请求数",
              "Value #B": "用户失败数",
              "Value #C": "失败率%",
              "Value #D": "端到端 p95(秒)"
            }
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "各模型 用户真实失败率趋势（%，10 分钟滑窗）",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "description": "只画有流量的模型。某条线抬头 = 那个模型真的在坑用户。",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "max",
            "mean"
          ],
          "placement": "right"
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{requested_model}}",
          "expr": "100 * ((\n  sum by (requested_model)(rate(litellm_proxy_failed_requests_metric_total[10m]))\n  unless on(requested_model) label_replace(max by (model_id)(litellm_probe_target_info), \"requested_model\", \"$1\", \"model_id\", \"(.*)\")\n)) / clamp_min((\n  sum by (requested_model)(rate(litellm_proxy_total_requests_metric_total[10m]))\n  unless on(requested_model) label_replace(max by (model_id)(litellm_probe_target_info), \"requested_model\", \"$1\", \"model_id\", \"(.*)\")\n), 0.0001) > 0"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "各模型 请求速率（req/分钟）",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "mean"
          ],
          "placement": "right"
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{requested_model}}",
          "expr": "topk(15, (\n  sum by (requested_model)(rate(litellm_proxy_total_requests_metric_total[10m]))\n  unless on(requested_model) label_replace(max by (model_id)(litellm_probe_target_info), \"requested_model\", \"$1\", \"model_id\", \"(.*)\")\n) * 60)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "用户失败按错误码拆（403=没权限 / 429=限流 / 5xx=上游挂）",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 30,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "sum"
          ],
          "placement": "right"
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{exception_status}} {{exception_class}}",
          "expr": "sum by (exception_status, exception_class)((\n  sum by (exception_status, exception_class, requested_model)(rate(litellm_proxy_failed_requests_metric_total[10m]))\n  unless on(requested_model) label_replace(max by (model_id)(litellm_probe_target_info), \"requested_model\", \"$1\", \"model_id\", \"(.*)\")\n)) * 60"
        }
      ]
    },
    {
      "type": "row",
      "title": "二、速度：用户等了多久（已剔除探针流量）",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 37
      }
    },
    {
      "type": "timeseries",
      "title": "端到端耗时 p95（秒，整个请求从进到出）",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 38
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "mean",
            "max"
          ],
          "placement": "right"
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{requested_model}}",
          "expr": "histogram_quantile(0.95, (\n  sum by (le, requested_model)(rate(litellm_request_total_latency_metric_bucket[10m]))\n  unless on(requested_model) label_replace(max by (model_id)(litellm_probe_target_info), \"requested_model\", \"$1\", \"model_id\", \"(.*)\")\n))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "端到端耗时 p50（秒，一半用户比这快）",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 38
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "mean",
            "max"
          ],
          "placement": "right"
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{requested_model}}",
          "expr": "histogram_quantile(0.5, (\n  sum by (le, requested_model)(rate(litellm_request_total_latency_metric_bucket[10m]))\n  unless on(requested_model) label_replace(max by (model_id)(litellm_probe_target_info), \"requested_model\", \"$1\", \"model_id\", \"(.*)\")\n))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "首字出来的时间 p95（秒，流式体感就是这条）",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "mean",
            "max"
          ],
          "placement": "right"
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{requested_model}}",
          "expr": "histogram_quantile(0.95, (\n  sum by (le, requested_model)(rate(litellm_llm_api_time_to_first_token_metric_bucket[10m]))\n  unless on(requested_model) label_replace(max by (model_id)(litellm_probe_target_info), \"requested_model\", \"$1\", \"model_id\", \"(.*)\")\n))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "上游 API 自身耗时 p95（秒，减掉我们这侧开销）",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "mean",
            "max"
          ],
          "placement": "right"
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{requested_model}}",
          "expr": "histogram_quantile(0.95, (\n  sum by (le, requested_model)(rate(litellm_llm_api_latency_metric_bucket[10m]))\n  unless on(requested_model) label_replace(max by (model_id)(litellm_probe_target_info), \"requested_model\", \"$1\", \"model_id\", \"(.*)\")\n))"
        }
      ]
    },
    {
      "type": "row",
      "title": "三、上游视角：哪条腿在坏（用户可能没感觉，但它在消耗重试预算）",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 58
      }
    },
    {
      "type": "table",
      "title": "⚠️ 当前不健康的上游部署（0=正常 1=部分故障 2=完全故障）",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 59
      },
      "description": "空表 = 所有上游腿都健康。这里出现的行，就是路由器认为有问题、正在少发或不发流量的那条腿。",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "状态"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 2
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "sortBy": [
          {
            "displayName": "状态",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "format": "table",
          "expr": "max by (litellm_model_name, model_id, api_provider, api_base) (litellm_deployment_state) > 0"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "renameByName": {
              "litellm_model_name": "模型组",
              "model_id": "部署ID",
              "api_provider": "供应商",
              "api_base": "上游地址",
              "Value": "状态"
            }
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "上游腿失败速率（次/分钟，含被重试救回来的）",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 68
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "mean",
            "max"
          ],
          "placement": "right"
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{litellm_model_name}} · {{api_provider}} · {{exception_status}}",
          "expr": "topk(15, sum by (litellm_model_name, api_provider, exception_status) (rate(litellm_deployment_failure_responses_total[10m])) * 60)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "上游腿失败占比（%，按部署 ID）",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 68
      },
      "description": "同一个模型组下不同腿的健康度对比。某个 model_id 常年高位 = 那个账号/供应商该摘了。",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "max",
            "mean"
          ],
          "placement": "right"
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{litellm_model_name}} · {{model_id}}",
          "expr": "topk(15, 100 * sum by (litellm_model_name, model_id) (rate(litellm_deployment_failure_responses_total[10m])) / clamp_min(sum by (litellm_model_name, model_id) (rate(litellm_deployment_total_requests_total[10m])), 0.0001))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "兜底（fallback）动作：救回 vs 也失败",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 78
      },
      "description": "绿线 = 主模型挂了但兜底接住了；红线 = 兜底也没接住，这就直接变成用户失败。",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
