+#[derive(serde::Deserialize)]
+pub struct SlotTestRequest {
+    /// 对外模型名，如 claude-opus-5-5
+    pub model: String,
+    /// 测试场景：hello（默认）/ reason / tool
+    #[serde(default)]
+    pub scenario: Option<String>,
+}
+
+/// 测试场景：固定提示词（不接受自由文本，避免拿 Admin 当代理用）。返回 (提示词, 是否带工具)
+fn slot_test_scenario(s: Option<&str>) -> Option<(&'static str, bool)> {
+    match s.unwrap_or("hello") {
+        "hello" => Some(("Reply with exactly: OK", false)),
+        "reason" => Some(("用一句话说明：为什么 1+1=2？", false)),
+        "tool" => Some(("Run `ls -la /tmp` using the Bash tool.", true)),
+        _ => None,
+    }
+}
+
+fn bad(msg: &str) -> axum::response::Response {
+    (axum::http::StatusCode::BAD_REQUEST, Json(serde_json::json!({"error": msg}))).into_response()
+}
+
+/// POST /api/admin/slots/{slot}/test —— 用该槽当前号、走槽位出口，真打一发；不排队不计统计不换号
+pub async fn test_slot(
+    State(state): State<AdminState>,
+    axum::extract::Path(slot): axum::extract::Path<usize>,
+    Json(req): Json<SlotTestRequest>,
+) -> impl IntoResponse {
+    let Some(p) = state.provider.clone() else {
+        return (axum::http::StatusCode::SERVICE_UNAVAILABLE, Json(serde_json::json!({"error": "provider 未就绪"}))).into_response();
+    };
+    if req.model.len() > 64 || !req.model.chars().all(|c| c.is_ascii_alphanumeric() || "-._".contains(c)) {
+        return bad("模型名不合法");
+    }
+    let Some((prompt, with_tool)) = slot_test_scenario(req.scenario.as_deref()) else {
+        return bad("scenario 只能是 hello / reason / tool");
+    };
+    Json(p.test_slot_model(slot, &req.model, prompt, with_tool).await).into_response()
+}
+
+/// POST /api/admin/slots/test-all —— 所有槽并发各打一发
+pub async fn test_all_slots(
+    State(state): State<AdminState>,
+    Json(req): Json<SlotTestRequest>,
+) -> impl IntoResponse {
+    let Some(p) = state.provider.clone() else {
+        return (axum::http::StatusCode::SERVICE_UNAVAILABLE, Json(serde_json::json!({"error": "provider 未就绪"}))).into_response();
+    };
+    if req.model.len() > 64 || !req.model.chars().all(|c| c.is_ascii_alphanumeric() || "-._".contains(c)) {
+        return bad("模型名不合法");
+    }
+    let Some((prompt, with_tool)) = slot_test_scenario(req.scenario.as_deref()) else {
+        return bad("scenario 只能是 hello / reason / tool");
+    };
+    let n = state.service.get_slots()["slots"].as_array().map(|a| a.len()).unwrap_or(0);
+    let futs = (0..n).map(|i| {
+        let p = p.clone();
+        let m = req.model.clone();
+        async move { p.test_slot_model(i, &m, prompt, with_tool).await }
+    });
+    Json(futures::future::join_all(futs).await).into_response()
+}
