+/// 上下文超长时回给客户端的文案，与 Anthropic 官方 400 逐字同形：
+/// `prompt is too long: <N> tokens > <M> maximum`。
+///
+/// Claude Code 只认这句：子串 `prompt is too long` 触发自动压缩后重发，
+/// 两个数字用来算要砍掉多少。别的说法（含旧的 "Context window is full"）一律当普通报错，
+/// 只显示不压缩；LiteLLM 也只有这句才映射成 ContextWindowExceededError，
+/// 否则当普通 BadRequest 走兜底（会被兜到别的模型上）。
+///
+/// 上游不告诉我们实际 token 数，`input_tokens` 是本地估算，可能比窗口小；
+/// 官方文案恒为 N > M，所以至少报 M+1。
+fn prompt_too_long_message(model: &str, input_tokens: i32) -> String {
+    let window = super::converter::get_context_window_size(model);
+    let tokens = input_tokens.max(window.saturating_add(1));
+    format!("prompt is too long: {} tokens > {} maximum", tokens, window)
+}
