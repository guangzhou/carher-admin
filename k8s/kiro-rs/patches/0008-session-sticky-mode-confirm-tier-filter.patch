diff -ruN a/admin-ui/src/components/mode-switch-dialog.tsx b/admin-ui/src/components/mode-switch-dialog.tsx
--- a/admin-ui/src/components/mode-switch-dialog.tsx	1970-01-01 08:00:00
+++ b/admin-ui/src/components/mode-switch-dialog.tsx	2026-10-22 12:13:51
@@ -0,0 +1,102 @@
+import { useEffect, useState } from 'react'
+import { toast } from 'sonner'
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+} from '@/components/ui/dialog'
+import { Button } from '@/components/ui/button'
+import { useLoadBalancingMode, useSetLoadBalancingMode } from '@/hooks/use-credentials'
+import { extractErrorMessage } from '@/lib/utils'
+
+export type LbMode = 'priority' | 'window' | 'balanced'
+
+export const MODE_INFO: Record<LbMode, { label: string; desc: string; warn?: string }> = {
+  priority: { label: '优先级模式', desc: '只用优先级最高的 1 个号，用完额度再换下一个。' },
+  window: {
+    label: '小窗口轮换',
+    desc: '只让优先级最前的几个号同时在线（数量在「窗口设置」里调），同一会话尽量固定同一个号；被限流就立刻换号，其余号冷备。',
+  },
+  balanced: {
+    label: '均衡负载',
+    desc: '全池所有启用的号一起分摊请求。',
+    warn: '全部号同时在线，一旦触发封号影响整池。',
+  },
+}
+
+interface ModeSwitchDialogProps {
+  open: boolean
+  onOpenChange: (open: boolean) => void
+}
+
+// 切换调度模式：先选、再确认。避免循环按钮连点把模式点过头。
+export function ModeSwitchDialog({ open, onOpenChange }: ModeSwitchDialogProps) {
+  const { data } = useLoadBalancingMode()
+  const { mutate, isPending } = useSetLoadBalancingMode()
+  const current = (data?.mode || 'priority') as LbMode
+  const [target, setTarget] = useState<LbMode>(current)
+
+  useEffect(() => {
+    if (open) setTarget(current)
+  }, [open, current])
+
+  const handleConfirm = () => {
+    if (target === current) return
+    mutate(target, {
+      onSuccess: () => {
+        toast.success(`已切换：${MODE_INFO[current].label} → ${MODE_INFO[target].label}`)
+        onOpenChange(false)
+      },
+      onError: (e) => toast.error(`切换失败: ${extractErrorMessage(e)}`),
+    })
+  }
+
+  return (
+    <Dialog open={open} onOpenChange={onOpenChange}>
+      <DialogContent className="sm:max-w-lg">
+        <DialogHeader>
+          <DialogTitle>切换调度模式</DialogTitle>
+          <DialogDescription>当前：{MODE_INFO[current].label}。立即对线上所有请求生效。</DialogDescription>
+        </DialogHeader>
+        <div className="space-y-2 py-2" role="radiogroup" aria-label="调度模式">
+          {(Object.keys(MODE_INFO) as LbMode[]).map((m) => (
+            <label
+              key={m}
+              className={`flex gap-3 rounded-md border p-3 cursor-pointer ${target === m ? 'border-primary bg-accent' : ''}`}
+            >
+              <input
+                type="radio"
+                name="lb-mode"
+                className="mt-1 accent-primary"
+                checked={target === m}
+                onChange={() => setTarget(m)}
+              />
+              <span className="space-y-1">
+                <span className="block text-sm font-medium">
+                  {MODE_INFO[m].label}
+                  {m === current && <span className="ml-2 text-xs text-muted-foreground">（当前）</span>}
+                </span>
+                <span className="block text-xs text-muted-foreground">{MODE_INFO[m].desc}</span>
+                {MODE_INFO[m].warn && <span className="block text-xs text-red-500">{MODE_INFO[m].warn}</span>}
+              </span>
+            </label>
+          ))}
+        </div>
+        {target !== current && (
+          <p className="text-sm" aria-live="polite">
+            将从 <b>{MODE_INFO[current].label}</b> 切换为 <b>{MODE_INFO[target].label}</b>
+          </p>
+        )}
+        <DialogFooter>
+          <Button variant="outline" onClick={() => onOpenChange(false)}>取消</Button>
+          <Button onClick={handleConfirm} disabled={target === current || isPending}>
+            {isPending ? '切换中...' : '确认切换'}
+          </Button>
+        </DialogFooter>
+      </DialogContent>
+    </Dialog>
+  )
+}
