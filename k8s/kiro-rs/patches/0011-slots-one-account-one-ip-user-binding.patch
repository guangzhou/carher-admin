+#[derive(Debug, Default, Clone, serde::Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct TestToolCall {
+    pub name: String,
+    pub input: String,
+}
+
+/// 事件流解析结果（测试展示用）
+#[derive(Debug, Default)]
+struct StreamSummary {
+    text: String,
+    tool_calls: Vec<TestToolCall>,
+    errors: Vec<String>,
+    events: Vec<(String, usize)>,
+    context_usage: Option<f64>,
+}
+
+/// 解析完整事件流（测试展示用）：文本、工具调用（同 id 分块拼接）、错误、事件序列、上下文用量
+fn summarize_stream(bytes: &[u8]) -> StreamSummary {
+    use crate::kiro::model::events::Event;
+    use crate::kiro::parser::decoder::EventStreamDecoder;
+    let mut d = EventStreamDecoder::new();
+    let _ = d.feed(bytes);
+    let mut out = StreamSummary::default();
+    let mut tool_ids: Vec<String> = Vec::new();
+    let bump = |events: &mut Vec<(String, usize)>, k: &str| match events.iter_mut().find(|(n, _)| n == k) {
+        Some(e) => e.1 += 1,
+        None => events.push((k.to_string(), 1)),
+    };
+    for frame in d.decode_iter().flatten() {
+        match Event::from_frame(frame) {
+            Ok(Event::AssistantResponse(r)) => {
+                bump(&mut out.events, "assistantResponseEvent");
+                out.text.push_str(&r.content);
+            }
+            Ok(Event::ToolUse(t)) => {
+                bump(&mut out.events, "toolUseEvent");
+                match tool_ids.iter().position(|x| *x == t.tool_use_id) {
+                    Some(i) => out.tool_calls[i].input.push_str(&t.input),
+                    None => {
+                        tool_ids.push(t.tool_use_id.clone());
+                        out.tool_calls.push(TestToolCall { name: t.name.clone(), input: t.input.clone() });
+                    }
+                }
+            }
+            Ok(Event::ContextUsage(c)) => {
+                bump(&mut out.events, "contextUsageEvent");
+                out.context_usage = Some(c.context_usage_percentage);
+            }
+            Ok(Event::Metering(_)) => bump(&mut out.events, "meteringEvent"),
+            Ok(Event::Error { error_code, error_message }) => {
+                bump(&mut out.events, "error");
+                out.errors.push(format!("{}: {}", error_code, error_message));
+            }
+            Ok(Event::Exception { exception_type, message }) => {
+                bump(&mut out.events, "exception");
+                out.errors.push(format!("{}: {}", exception_type, message));
+            }
+            Ok(Event::Unknown {}) => bump(&mut out.events, "unknown"),
+            Err(_) => bump(&mut out.events, "unparsed"),
+        }
+    }
+    out
+}
+
+/// 兼容旧调用：(文本, 工具调用数, 错误)
+#[cfg(test)]
+fn summarize_event_stream(bytes: &[u8]) -> (String, usize, Vec<String>) {
+    let s = summarize_stream(bytes);
+    (s.text, s.tool_calls.len(), s.errors)
+}
+
+
+enum Peeked {
+    /// 已见到文本/工具（或出错、无法判定）：原样继续流
+    Ready(reqwest::Response),
+    /// 读完整个响应都没有文本也没有工具：静默空回复（已缓冲，可原样返回）
+    Empty(reqwest::Response),
+}
+
+/// 读响应直到出现第一个有内容的事件；见到就把已读部分 + 剩余流拼回原样返回（不破坏流式）。
+async fn peek_for_content(response: reqwest::Response) -> Peeked {
+    use crate::kiro::model::events::Event;
+    use crate::kiro::parser::decoder::EventStreamDecoder;
+    use futures::StreamExt;
+
+    let status = response.status();
+    let headers = response.headers().clone();
+    let mut stream = response.bytes_stream();
+    let mut buffered: Vec<bytes::Bytes> = Vec::new();
+    let mut decoder = EventStreamDecoder::new();
+    let mut has_content = false;
+    let mut errored = false;
+
+    while let Some(chunk) = stream.next().await {
+        let chunk = match chunk {
+            Ok(c) => c,
+            Err(_) => {
+                errored = true;
+                break;
+            }
+        };
+        let _ = decoder.feed(&chunk);
+        buffered.push(chunk);
+        for frame in decoder.decode_iter().flatten() {
+            if let Ok(ev) = Event::from_frame(frame) {
+                match ev {
+                    Event::AssistantResponse(r) if !r.content.is_empty() => has_content = true,
+                    Event::ToolUse(_) | Event::Error { .. } | Event::Exception { .. } => has_content = true,
+                    _ => {}
+                }
+            }
+        }
+        if has_content {
+            break;
+        }
+    }
+
+    let rebuild = |rest: Option<_>| {
+        let head = futures::stream::iter(buffered.clone().into_iter().map(Ok::<_, std::io::Error>));
+        let body = match rest {
+            Some(r) => reqwest::Body::wrap_stream(head.chain(r)),
+            None => reqwest::Body::wrap_stream(head),
+        };
+        let mut b = http::Response::builder().status(status);
+        if let Some(h) = b.headers_mut() {
+            *h = headers.clone();
+        }
+        reqwest::Response::from(b.body(body).expect("rebuild response"))
+    };
+
+    if has_content || errored {
+        let rest = stream.map(|r| r.map_err(std::io::Error::other));
+        Peeked::Ready(rebuild(Some(rest.boxed())))
+    } else {
+        Peeked::Empty(rebuild(None))
+    }
+}
