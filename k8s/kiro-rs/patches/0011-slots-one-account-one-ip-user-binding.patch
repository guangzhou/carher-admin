+import { Dialog, DialogContent, DialogDescription, DialogHeader, DialogTitle } from '@/components/ui/dialog'
+import type { SlotTestResult } from '@/api/credentials'
+
+// 槽位测试详情：左边是发出去的输入，右边是上游回来的输出
+const VERDICT_TEXT: Record<SlotTestResult['verdict'], string> = {
+  ok: '可用', empty: '空回复', '429': '被限流 429', quota: '额度用尽', auth: '鉴权失败', timeout: '超时', error: '出错',
+}
+
+function Row({ k, children }: { k: string; children: React.ReactNode }) {
+  return (
+    <div className='grid grid-cols-[6rem_1fr] gap-2 py-1 text-sm'>
+      <span className='text-muted-foreground'>{k}</span>
+      <span className='min-w-0 break-words'>{children}</span>
+    </div>
+  )
+}
+
+function Block({ children }: { children: React.ReactNode }) {
+  return (
+    <pre className='max-h-64 overflow-auto whitespace-pre-wrap break-words rounded-md border bg-muted/40 p-2 font-mono text-xs'>
+      {children}
+    </pre>
+  )
+}
+
+export function SlotTestDialog({ r, slotName, onClose }: { r: SlotTestResult | null; slotName: string; onClose: () => void }) {
+  if (!r) return null
+  const ok = r.verdict === 'ok'
+  return (
+    <Dialog open onOpenChange={(o) => !o && onClose()}>
+      <DialogContent className='max-h-[90vh] overflow-y-auto sm:max-w-4xl'>
+        <DialogHeader>
+          <DialogTitle>
+            测试详情 · {slotName} · <span className={ok ? 'text-green-600' : 'text-red-600'}>{VERDICT_TEXT[r.verdict] || r.verdict}</span>
+          </DialogTitle>
+          <DialogDescription>
+            号 #{r.accountId ?? '—'} · 出口 {r.egress && r.egress !== 'direct' ? r.egress : '本机'} · HTTP {r.status || '—'} · {(r.ms / 1000).toFixed(1)} 秒
+          </DialogDescription>
+        </DialogHeader>
+        <div className='grid gap-4 md:grid-cols-2'>
+          <section className='space-y-2'>
+            <h3 className='text-sm font-semibold'>输入</h3>
+            <Row k='模型'>{r.model}{r.upstreamModel && <span className='text-muted-foreground'> → 上游 {r.upstreamModel}</span>}</Row>
+            <Row k='max_tokens'>{r.maxTokens}</Row>
+            <Row k='工具'>{r.tools.length ? r.tools.join(', ') : '无'}</Row>
+            <div className='text-sm text-muted-foreground'>提示词</div>
+            <Block>{r.prompt}</Block>
+          </section>
+          <section className='space-y-2'>
+            <h3 className='text-sm font-semibold'>输出</h3>
+            <div className='text-sm text-muted-foreground'>回复文本{r.reply ? `（${r.reply.length} 字）` : ''}</div>
+            <Block>{r.reply || '（无文本）'}</Block>
+            {r.toolCalls.length > 0 && (
+              <>
+                <div className='text-sm text-muted-foreground'>工具调用（{r.toolCalls.length}）</div>
+                <Block>{r.toolCalls.map((t) => `${t.name}(${t.input})`).join('\n')}</Block>
+              </>
+            )}
+            {r.detail && (
+              <>
+                <div className='text-sm text-muted-foreground'>{ok ? '备注' : '错误 / 原因'}</div>
+                <Block>{r.detail}</Block>
+              </>
+            )}
+            <Row k='上游事件'>{r.events.length ? r.events.map(([k, n]) => `${k}×${n}`).join(' · ') : '—'}</Row>
+            <Row k='上下文用量'>{r.contextUsage == null ? '—' : `${r.contextUsage.toFixed(2)}%`}</Row>
+            <Row k='响应大小'>{r.bytes ? `${r.bytes.toLocaleString()} 字节` : '—'}</Row>
+          </section>
+        </div>
+      </DialogContent>
+    </Dialog>
+  )
+}
