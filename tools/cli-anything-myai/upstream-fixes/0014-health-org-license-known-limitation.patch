+def organization_license_only_unavailable(status: dict[str, Any]) -> bool:
+    """True only when the sole failed probe is /organization/list rejected for a missing Enterprise license."""
+
+    if status.get("teams") is not True or status.get("keys") is not True:
+        return False
+    errors = status.get("errors")
+    if not isinstance(errors, dict) or set(errors) != {"organizations"}:
+        return False
+    error = errors.get("organizations") or {}
+    return (
+        isinstance(error, dict)
+        and error.get("statusCode") == 403
+        and "Enterprise" in str(error.get("detail") or "")
+    )
+
