+    /// Admin：整体替换槽位配置（增 / 删 / 改出口 / 改名），立即生效并写回 config.json。
+    /// 按名字对齐：没变的槽号和绑定都不动；改了出口的槽，号的代理同步改。
+    pub fn set_slot_configs(&self, cfgs: Vec<crate::model::config::SlotConfig>) -> anyhow::Result<()> {
+        use anyhow::Context;
+        let mut seen = std::collections::HashSet::new();
+        for c in &cfgs {
+            if c.name.trim().is_empty() {
+                anyhow::bail!("槽位名不能为空");
+            }
+            if !seen.insert(c.name.clone()) {
+                anyhow::bail!("槽位名重复: {}", c.name);
+            }
+            if let Some(u) = c.proxy_url.as_deref().filter(|u| !u.is_empty() && !u.eq_ignore_ascii_case("direct")) {
+                let ok = (u.starts_with("http://") || u.starts_with("https://") || u.starts_with("socks5://"))
+                    && reqwest::Proxy::all(u).is_ok()
+                    && !u.contains('@');
+                if !ok {
+                    anyhow::bail!("槽位 {} 的出口代理地址不合法（要 http://IP:端口，账号密码填旁边两栏，不要写进地址）: {}", c.name, u);
+                }
+            }
+        }
+        if cfgs.iter().filter(|c| c.enabled).count() > 20 {
+            anyhow::bail!("同时生效的槽位最多 20 个");
+        }
+        if cfgs.len() > 50 {
+            anyhow::bail!("槽位配置最多 50 条（含停用）");
+        }
+        let mut cfgs = cfgs;
+        {
+            let mut sec = self.slot_secrets.lock();
+            for c in cfgs.iter_mut() {
+                match c.proxy_password.as_deref() {
+                    Some(MASKED_PASSWORD) => {
+                        c.proxy_password = Some(
+                            sec.get(&c.name)
+                                .cloned()
+                                .ok_or_else(|| anyhow::anyhow!("槽位 {} 没有已知密码，请重新填写", c.name))?,
+                        );
+                    }
+                    Some(p) => {
+                        sec.insert(c.name.clone(), p.to_string());
+                    }
+                    None => {}
+                }
+            }
+        }
+        if let Some(path) = self.config.config_path() {
+            let mut c = Config::load(path).with_context(|| format!("重新加载配置失败: {}", path.display()))?;
+            c.slots = cfgs.clone();
+            c.save().with_context(|| format!("持久化槽位配置失败: {}", path.display()))?;
+        }
+        let active: Vec<_> = cfgs.iter().filter(|c| c.enabled).cloned().collect();
+        *self.slot_configs_all.lock() = cfgs.clone();
+        *self.slot_configs.lock() = active.clone();
+        if self.load_balancing_mode.lock().as_str() == "slots" {
+            self.reconcile_slots(&active)?;
+        } else {
+            // 非槽位模式只改配置；运行时槽表按名字对齐（不上号、不写代理），切到槽位模式时再上号
+            let start = self.slot_limits.lock().start;
+            let names: Vec<String> = active.iter().map(|c| c.name.clone()).collect();
+            self.slots.lock().reconcile(&names, start);
+            self.persist_slots();
+        }
+        tracing::info!(
+            "槽位配置已更新：生效 {:?}，停用 {:?}",
+            cfgs.iter().filter(|c| c.enabled).map(|c| &c.name).collect::<Vec<_>>(),
+            cfgs.iter().filter(|c| !c.enabled).map(|c| &c.name).collect::<Vec<_>>()
+        );
+        Ok(())
+    }
+
+    fn persist_slots(&self) {
+        let Some(path) = self.slots_path() else { return };
+        // 写锁内取快照并写完：两个并发写不会让旧快照后落盘，也不会共用同一个 tmp
+        let _w = self.write_lock.lock();
+        let json = {
+            let rt = self.slots.lock();
+            serde_json::to_string_pretty(&rt.file)
+        };
+        let Ok(json) = json else { return };
+        let tmp = path.with_extension("json.tmp");
+        let write = || std::fs::write(&tmp, &json).and_then(|_| std::fs::rename(&tmp, &path));
+        let r = if tokio::runtime::Handle::try_current().is_ok() {
+            tokio::task::block_in_place(write)
+        } else {
+            write()
+        };
+        if r.is_err() {
+            tracing::warn!("保存槽位绑定失败: {:?}", path);
+        }
+    }
+
+    /// 槽 i 换一个从没上过槽的号；返回新号 id。reason 写进旧号退役原因
+    fn fill_slot(&self, i: usize, reason: &str) -> Option<u64> {
+        let candidates: Vec<(u64, u32, bool, bool)> = self
+            .entries
+            .lock()
+            .iter()
+            .map(|e| (e.id, e.credentials.priority, e.disabled, e.credentials.supports_opus()))
+            .collect();
+        let start = self.slot_limits.lock().start;
+        let live_ids: Vec<u64> = candidates.iter().map(|c| c.0).collect();
+        let mut rt = self.slots.lock();
+        // 槽上挂着的号已被删除：先清掉引用（不记退役，它不是被限/用尽）
+        if rt.states[i].account_id.is_some_and(|id| !live_ids.contains(&id)) {
+            rt.states[i].account_id = None;
+        }
+        // 被换下的旧号（仍在池里）：换下后清掉它身上的槽位代理，免得重新启用后和新号共用这个 IP
+        let replaced = rt.states[i].account_id;
+        let occupied = rt.occupied();
+        // 只排除「因额度用尽 / 被限制而退役」的号；被正常换下（停槽、手动调整）的号仍可再上槽
+        let retired: Vec<u64> = rt.file.retired.keys().copied().collect();
+        let new_id = crate::kiro::slots::pick_replacement(&candidates, &retired, &occupied, true)?;
+        if rt.states[i].account_id.is_some() {
+            rt.swap_account(i, new_id, reason, start);
+        } else {
+            let name = rt.states[i].name.clone();
+            rt.states[i] = crate::kiro::slots::SlotState::new(i, start);
+            rt.states[i].name = name;
+            rt.states[i].account_id = Some(new_id);
+            if !rt.file.ever_slotted.contains(&new_id) {
+                rt.file.ever_slotted.push(new_id);
+            }
+            rt.sync_file_accounts();
+        }
+        drop(rt);
+        if let Some(old) = replaced.filter(|o| *o != new_id) {
+            let originals = self.slots.lock().file.original_proxy.clone();
+            let mut entries = self.entries.lock();
+            if let Some(e) = entries.iter_mut().find(|e| e.id == old) {
+                restore_proxy(&mut e.credentials, &originals);
+            }
+        }
+        self.stamp_slot_proxy(i, new_id);
+        tracing::info!("槽位 {} 上号 #{}（{}）", i, new_id, reason);
+        Some(new_id)
+    }
+
+    /// 槽位模式选号：用户键 → 槽 → 号。返回 (槽, 号id, 凭据)
+    fn select_slot_credential(&self, user_key: &str) -> Option<(usize, u64, KiroCredentials)> {
+        let ratio = self.config.slot_heavy_ratio;
+        let (slot, is_new, id) = {
+            let mut rt = self.slots.lock();
+            // 带用户身份的永久绑定；其它（会话键 / MCP）只按哈希挑槽，不写绑定表
+            let (slot, is_new) = if user_key.starts_with("u:") {
+                rt.slot_for_user(user_key, ratio, Instant::now())?
+            } else {
+                (rt.pick_ephemeral(user_key)?, false)
+            };
+            (slot, is_new, rt.states[slot].account_id?)
+        };
+        if is_new {
+            self.persist_slots();
+        }
+        let hit = {
+            let entries = self.entries.lock();
+            entries.iter().find(|e| e.id == id && !e.disabled).map(|e| e.credentials.clone())
+        };
+        if let Some(c) = hit {
+            return Some((slot, id, c));
+        }
+        // 槽上的号已不可用（被手动禁用 / 连续失败 / 刷新失效等）⇒ 就地补号，不让这个槽一直报错
+        tracing::warn!("槽位 {} 的号 #{} 已不可用，就地补号", slot, id);
+        let new_id = self.fill_slot(slot, "dead")?;
+        let _ = self.persist_credentials();
+        self.persist_slots();
+        let entries = self.entries.lock();
+        let e = entries.iter().find(|e| e.id == new_id && !e.disabled)?;
+        Some((slot, new_id, e.credentials.clone()))
+    }
+
+    /// 槽位占一个在途名额；满了排队，超时返回 Err（调用方回 529）
+    pub async fn acquire_slot_permit(self: &Arc<Self>, slot: usize) -> anyhow::Result<SlotPermit> {
+        // 下标只用来取名字；之后全程按名字找（运行中增删槽不会错扣别的槽、也不会越界）
+        let name = self
+            .slots
+            .lock()
+            .states
+            .get(slot)
+            .map(|s| s.name.clone())
+            .ok_or_else(|| anyhow::anyhow!("{}: 槽位 {} 已不存在", crate::kiro::slots::SLOT_GONE_MARK, slot))?;
+        let wait = StdDuration::from_secs(self.config.slot_queue_timeout_secs);
+        let deadline = Instant::now() + wait;
+        let mut queued = false;
+        loop {
+            let notified = self.slot_notify.notified();
+            match self.try_take_slot(&name, queued) {
+                TakeSlot::Taken(account_id) => {
+                    return Ok(SlotPermit { mgr: Arc::clone(self), slot_name: name, account_id, done: false });
+                }
+                TakeSlot::Gone => {
+                    anyhow::bail!("{}: 槽位 {} 已被删除/停用", crate::kiro::slots::SLOT_GONE_MARK, name);
+                }
+                TakeSlot::Full => {}
+            }
+            if !queued {
+                queued = true;
+                let mut rt = self.slots.lock();
+                if let Some(st) = rt.states.iter_mut().find(|s| s.name == name) {
+                    st.queued += 1;
+                }
+            }
+            let now = Instant::now();
+            if now >= deadline {
+                let mut rt = self.slots.lock();
+                if let Some(i) = rt.states.iter().position(|s| s.name == name) {
+                    rt.states[i].queued = rt.states[i].queued.saturating_sub(1);
+                    rt.stats[i].queue_timeouts += 1;
+                }
+                anyhow::bail!("{}: 槽位 {} 排队超过 {}s", crate::kiro::slots::OVERLOADED_MARK, name, wait.as_secs());
+            }
+            let left = (deadline - now).min(StdDuration::from_millis(500));
+            let _ = tokio::time::timeout(left, notified).await;
+        }
+    }
+
+    fn try_take_slot(&self, name: &str, was_queued: bool) -> TakeSlot {
+        let mut rt = self.slots.lock();
+        let now = Instant::now();
+        let Some(i) = rt.states.iter().position(|s| s.name == name) else {
+            return TakeSlot::Gone;
+        };
+        if !rt.states[i].has_room(now) {
+            return TakeSlot::Full;
+        }
+        let st = &mut rt.states[i];
+        st.in_flight += 1;
+        if st.in_flight >= st.effective_limit() {
+            st.saturated_since_grow = true;
+        }
+        if was_queued {
+            st.queued = st.queued.saturating_sub(1);
+        }
+        let account_id = st.account_id;
+        rt.stats[i].sent += 1;
+        rt.usage[i].add(now, 1);
+        TakeSlot::Taken(account_id)
+    }
+
+    /// 归还名额：只有槽还在、且槽上仍是拿名额时那个号，才扣在途（换号时新号在途从 0 起，旧名额不扣它）
+    fn release_slot(&self, name: &str, account_id: Option<u64>) {
+        {
+            let mut rt = self.slots.lock();
+            if let Some(st) = rt.states.iter_mut().find(|s| s.name == name) {
+                if st.account_id == account_id {
+                    st.in_flight = st.in_flight.saturating_sub(1);
+                }
+            }
+        }
+        self.slot_notify.notify_waiters();
+    }
+
+    /// 槽位撞 429：AIMD 下降并计数；first = 该请求第一次发出
+    pub fn slot_report_429(&self, slot: usize, first: bool, retry_after: Option<StdDuration>) {
+        let p = *self.slot_limits.lock();
+        let mut rt = self.slots.lock();
+        if slot >= rt.states.len() {
+            return;
+        }
+        rt.states[slot].on_429(&p, Instant::now(), retry_after);
+        if first {
+            rt.stats[slot].first_429 += 1;
+        } else {
+            rt.stats[slot].retry_429 += 1;
+        }
+    }
+
+    /// 槽位记一次空回复；returned = 最终原样给了用户（没换号救回）
+    pub fn slot_report_empty(&self, slot: usize, returned: bool) {
+        if let Some(s) = self.slots.lock().stats.get_mut(slot) {
+            s.empty += 1;
+            if returned {
+                s.empty_returned += 1;
+            }
+        }
+    }
+
+    pub fn slot_report_exhausted(&self, slot: usize) {
+        if let Some(s) = self.slots.lock().stats.get_mut(slot) {
+            s.exhausted += 1;
+        }
+    }
+
+    /// 周期调用（每 30s）：AIMD 上调
+    pub fn slot_tick(&self) {
+        let p = *self.slot_limits.lock();
+        let now = Instant::now();
+        let mut grew = false;
+        for st in self.slots.lock().states.iter_mut() {
+            grew |= st.maybe_grow(&p, now);
+        }
+        if grew {
+            self.slot_notify.notify_waiters();
+        }
+    }
+
+    /// 号在槽位里退役（额度用完 quota / opus 被限 restricted）：禁用旧号、槽位换新号、落盘。
+    /// 返回 Some ⇒ 槽上已有可用号（新换上的，或并发里别人已换好），调用方重发即可；None ⇒ 冷备无号
+    pub fn slot_retire_account(&self, account_id: u64, reason: &str) -> Option<u64> {
+        let slot = match self.slots.lock().slot_of_account(account_id) {
+            Some(i) => i,
+            // 并发：同一号的另一个请求已经把它换下了（号已不在任何槽上）⇒ 不重复退役，
+            // 返回 Some 让调用方直接重发（重发会取到槽上的新号）
+            None => {
+                let swapped = self.entries.lock().iter().any(|e| e.id == account_id && e.disabled);
+                return swapped.then_some(account_id);
+            }
+        };
+        {
+            let originals = self.slots.lock().file.original_proxy.clone();
+            let mut entries = self.entries.lock();
+            if let Some(e) = entries.iter_mut().find(|e| e.id == account_id) {
+                e.disabled = true;
+                restore_proxy(&mut e.credentials, &originals);
+                e.disabled_reason = Some(if reason == "quota" {
+                    DisabledReason::QuotaExceeded
+                } else {
+                    DisabledReason::ModelRestricted
+                });
+            }
+        }
+        if reason == "restricted" {
+            if let Some(s) = self.slots.lock().stats.get_mut(slot) {
+                s.restricted += 1;
+            }
+        }
+        let new_id = self.fill_slot(slot, reason);
+        if let Err(e) = self.persist_credentials() {
+            tracing::warn!("退役号 #{} 后回写凭据失败: {}", account_id, e);
+        }
+        self.persist_slots();
+        self.slot_notify.notify_waiters();
+        tracing::warn!("槽位 {}: 号 #{} 退役（{}），新号 {:?}", slot, account_id, reason, new_id);
+        new_id
+    }
+
+    /// 槽位模式取上下文：用户 → 槽 → 号（号的代理已在上槽时写成槽位代理），确保 token 有效
+    pub async fn acquire_slot_context(&self, user_key: &str) -> anyhow::Result<(usize, CallContext)> {
+        let (slot, id, creds) = self
+            .select_slot_credential(user_key)
+            .ok_or_else(|| anyhow::anyhow!("{}: 槽位模式没有可用槽位（冷备号已用尽？）", crate::kiro::slots::OVERLOADED_MARK))?;
+        match self.try_ensure_token(id, &creds).await {
+            Ok(ctx) => Ok((slot, ctx)),
+            Err(e) => {
+                // 与老路径一致地计失败；号被判死（禁用）后，下一次 select 会就地补号
+                if e.downcast_ref::<RefreshTokenInvalidError>().is_some() {
+                    self.report_refresh_token_invalid(id);
+                } else {
+                    self.report_refresh_failure(id);
+                }
+                Err(e)
+            }
+        }
+    }
+
+    /// 把槽位代理写进号的凭据（刷新 token / 对话 / 查额度 / MCP 全部走它）
+    fn stamp_slot_proxy(&self, slot: usize, account_id: u64) {
+        let Some(sc) = self.slot_configs.lock().get(slot).cloned() else { return };
+        // 第一次上槽时记下号原来的代理（之后再换槽不覆盖，离槽能还原到最初的）
+        let original = self
+            .entries
+            .lock()
+            .iter()
+            .find(|e| e.id == account_id)
+            .map(|e| (e.credentials.proxy_url.clone(), e.credentials.proxy_username.clone(), e.credentials.proxy_password.clone()));
+        if let Some(o) = original {
+            let already_slotted_proxy = o.0.as_deref().is_some_and(|u| {
+                self.slot_configs_all.lock().iter().any(|c| c.proxy_url.as_deref().unwrap_or("direct") == u)
+            });
+            let mut rt = self.slots.lock();
+            if !rt.file.original_proxy.contains_key(&account_id) && !already_slotted_proxy {
+                rt.file.original_proxy.insert(account_id, o);
+            }
+        }
+        let mut entries = self.entries.lock();
+        if let Some(e) = entries.iter_mut().find(|e| e.id == account_id) {
+            e.credentials.proxy_url = Some(sc.proxy_url.clone().unwrap_or_else(|| "direct".to_string()));
+            e.credentials.proxy_username = sc.proxy_username.clone();
+            e.credentials.proxy_password = sc.proxy_password.clone();
+        }
+    }
+
+    /// 空槽（没号、或号已不存在/已禁用）从冷备补号；无空槽不做事
+    pub fn fill_empty_slots(&self, reason: &str) {
+        if !self.is_slots_mode() {
+            return;
+        }
+        let n = self.slot_configs.lock().len();
+        let mut changed = false;
+        for i in 0..n {
+            let id = self.slots.lock().states.get(i).and_then(|s| s.account_id);
+            let alive = id.is_some_and(|id| self.entries.lock().iter().any(|e| e.id == id && !e.disabled));
+            if !alive && self.fill_slot(i, reason).is_some() {
+                changed = true;
+            }
+        }
+        if changed {
+            let _ = self.persist_credentials();
+            self.persist_slots();
+            self.slot_notify.notify_waiters();
+        }
+    }
+
+    /// Admin 测试：取某槽当前号的上下文（不排队、不绑用户、不计槽统计）
+    pub async fn slot_context_for_test(&self, slot: usize) -> anyhow::Result<CallContext> {
+        let id = self
+            .slots
+            .lock()
+            .states
+            .get(slot)
+            .ok_or_else(|| anyhow::anyhow!("槽位 {} 不存在", slot))?
+            .account_id
+            .ok_or_else(|| anyhow::anyhow!("槽位 {} 是空槽", slot))?;
+        let creds = self
+            .entries
+            .lock()
+            .iter()
+            .find(|e| e.id == id)
+            .map(|e| e.credentials.clone())
+            .ok_or_else(|| anyhow::anyhow!("号 #{} 不存在", id))?;
+        self.try_ensure_token(id, &creds).await
+    }
+
+    /// 已绑定用户当前所在槽（不新建绑定）
+    pub fn peek_slot(&self, user_key: &str) -> Option<(usize, u64)> {
+        let rt = self.slots.lock();
+        let name = rt.file.bindings.get(user_key)?;
+        let i = rt.states.iter().position(|s| &s.name == name)?;
+        Some((i, rt.states[i].account_id?))
+    }
+
+    fn pool_balance_path(&self) -> Option<PathBuf> {
+        self.cache_dir().map(|d| d.join("kiro_pool_balance.json"))
+    }
+
+    fn load_pool_balance_history(&self) {
+        let h: crate::kiro::slots::BalanceHistory = self
+            .pool_balance_path()
+            .and_then(|p| std::fs::read_to_string(p).ok())
+            .and_then(|c| serde_json::from_str(&c).ok())
+            .unwrap_or_default();
+        self.pool_balance.lock().1 = h;
+    }
+
+    /// 轮询号池（启用的号）余额，记一笔总剩余。跳过禁用号；单号失败沿用上次值
+    pub async fn poll_pool_balance(&self) {
+        // 只在槽位模式查（其它模式不给上游加额外的额度查询流量）
+        if !self.is_slots_mode() {
+            return;
+        }
+        let ids: Vec<u64> = self.entries.lock().iter().filter(|e| !e.disabled).map(|e| e.id).collect();
+        let mut got = HashMap::new();
+        for id in ids {
+            match self.get_usage_limits_for(id).await {
+                Ok(u) => {
+                    let lim = u.usage_limit();
+                    got.insert(id, ((lim - u.current_usage()).max(0.0), lim));
+                }
+                Err(e) => tracing::debug!("号 #{} 余额获取失败: {}", id, e),
+            }
+            tokio::time::sleep(StdDuration::from_millis(300)).await;
+        }
+        let alive: Vec<u64> = self.entries.lock().iter().filter(|e| !e.disabled).map(|e| e.id).collect();
+        let json = {
+            let mut pb = self.pool_balance.lock();
+            for (k, v) in got {
+                pb.0.insert(k, v);
+            }
+            pb.0.retain(|k, _| alive.contains(k));
+            let per: HashMap<u64, f64> = pb.0.iter().map(|(k, (r, _))| (*k, *r)).collect();
+            pb.1.record_accounts(chrono::Utc::now().timestamp(), &per);
