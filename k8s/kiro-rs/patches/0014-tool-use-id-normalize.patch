+    #[test]
+    fn test_normalize_tool_use_id_short_passthrough() {
+        assert_eq!(normalize_tool_use_id("toolu_01"), "toolu_01");
+        let id64 = "a".repeat(64);
+        assert_eq!(normalize_tool_use_id(&id64), id64);
+        assert_eq!(normalize_tool_use_id("a-b_C9"), "a-b_C9");
+    }
+
+    #[test]
+    fn test_normalize_tool_use_id_invalid_chars() {
+        let valid = |s: &str| s.chars().all(|c| c.is_ascii_alphanumeric() || c == '_' || c == '-');
+        for bad in ["call\n1", "call 1", "call.1", "call:1", "call\t1", "调用1"] {
+            let n = normalize_tool_use_id(bad);
+            assert!(valid(&n) && n.len() <= TOOL_USE_ID_MAX_LEN, "{bad:?} -> {n:?}");
+        }
+        // 只差一个非法字符的两个 id 不能撞（按原 id 算哈希）
+        assert_ne!(normalize_tool_use_id("call.1"), normalize_tool_use_id("call:1"));
+    }
+
+    #[test]
+    fn test_normalize_tool_use_id_long_shortened() {
