+import { useEffect, useState } from 'react'
+import { toast } from 'sonner'
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+} from '@/components/ui/dialog'
+import { Button } from '@/components/ui/button'
+import { Input } from '@/components/ui/input'
+import { useSetWindowSettings, useWindowSettings } from '@/hooks/use-credentials'
+import { extractErrorMessage } from '@/lib/utils'
+
+interface WindowSettingsDialogProps {
+  open: boolean
+  onOpenChange: (open: boolean) => void
+}
+
+// 与后端 WINDOW_K_HARD_CAP 一致
+const K_CAP = 20
+
+export function WindowSettingsDialog({ open, onOpenChange }: WindowSettingsDialogProps) {
+  const { data } = useWindowSettings()
+  const { mutate, isPending } = useSetWindowSettings()
+  const [minK, setMinK] = useState('2')
+  const [maxK, setMaxK] = useState('3')
+  const [cooldown, setCooldown] = useState('60')
+
+  useEffect(() => {
+    if (open && data) {
+      setMinK(String(data.minK))
+      setMaxK(String(data.maxK))
+      setCooldown(String(data.cooldownSecs))
+    }
+  }, [open, data])
+
+  const min = Number(minK)
+  const max = Number(maxK)
+  const cd = Number(cooldown)
+  const error =
+    !Number.isInteger(min) || min < 1 ? '平时在线数至少为 1'
+      : !Number.isInteger(max) || max < min ? '上限不能小于平时在线数'
+        : max > K_CAP ? `上限不能超过 ${K_CAP}`
+          : !Number.isInteger(cd) || cd < 1 || cd > 3600 ? '冷却秒数需在 1~3600 之间'
+            : null
+
+  const handleSave = () => {
+    if (error) return
+    mutate(
+      { minK: min, maxK: max, cooldownSecs: cd },
+      {
+        onSuccess: (r) => {
+          toast.success(`已保存：平时 ${r.minK} 个号在线，最多 ${r.maxK} 个，冷却 ${r.cooldownSecs} 秒`)
+          onOpenChange(false)
+        },
+        onError: (e) => toast.error(`保存失败: ${extractErrorMessage(e)}`),
+      }
+    )
+  }
+
+  return (
+    <Dialog open={open} onOpenChange={onOpenChange}>
+      <DialogContent className="sm:max-w-md">
+        <DialogHeader>
+          <DialogTitle>窗口设置（小窗口轮换模式）</DialogTitle>
+          <DialogDescription>
+            只让优先级最前的几个号同时在线，其余号冷备。号被限流时冷却并立刻换号，冷却期间从后面补位，最多补到上限。保存后立即生效。
+          </DialogDescription>
+        </DialogHeader>
+        <div className="space-y-4 py-2">
+          <label className="block space-y-1">
+            <span className="text-sm font-medium">平时同时在线的号数</span>
+            <Input type="number" min={1} max={K_CAP} value={minK} onChange={(e) => setMinK(e.target.value)} />
+          </label>
+          <label className="block space-y-1">
+            <span className="text-sm font-medium">最多同时在线（限流补位时的上限）</span>
+            <Input type="number" min={1} max={K_CAP} value={maxK} onChange={(e) => setMaxK(e.target.value)} />
+          </label>
+          <label className="block space-y-1">
+            <span className="text-sm font-medium">被限流后冷却秒数</span>
+            <Input type="number" min={1} max={3600} value={cooldown} onChange={(e) => setCooldown(e.target.value)} />
+          </label>
+          {error && <p className="text-sm text-red-500" role="alert">{error}</p>}
+        </div>
+        <DialogFooter>
+          <Button variant="outline" onClick={() => onOpenChange(false)}>取消</Button>
+          <Button onClick={handleSave} disabled={!!error || isPending}>
+            {isPending ? '保存中...' : '保存'}
+          </Button>
+        </DialogFooter>
+      </DialogContent>
+    </Dialog>
+  )
+}
